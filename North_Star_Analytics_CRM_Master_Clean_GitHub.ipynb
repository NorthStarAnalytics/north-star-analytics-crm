    "# STEP 041 — Backup Recovery Preview\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "def preview_crm_recovery(backup_path):\n",
    "    \"\"\"\n",
    "    Verify a backup and compare its worksheet\n",
    "    record counts with the current live CRM.\n",
    "\n",
    "    Read-only: does not modify Google Sheets.\n",
    "    \"\"\"\n",
    "\n",
    "    verification = inspect_crm_backup(backup_path)\n",
    "\n",
    "    if not verification[\"Valid\"]:\n",
    "        raise ValueError(\n",
    "            \"Backup verification failed. Recovery blocked.\"\n",
    "        )\n",
    "\n",
    "    manifest = verification[\"Manifest\"]\n",
    "\n",
    "    live_sheets = {\n",
    "        ws.title: ws\n",
    "        for ws in spreadsheet.worksheets()\n",
    "    }\n",
    "\n",
    "    comparison = []\n",
    "\n",
    "    for item in manifest[\"Worksheets\"]:\n",
    "\n",
    "        name = item[\"Worksheet Name\"]\n",
    "        backup_records = item[\"Data Records\"]\n",
    "\n",
    "        if name in live_sheets:\n",
    "            live_values = live_sheets[name].get_all_values()\n",
    "            live_records = max(0, len(live_values) - 1)\n",
    "            status = \"Exists\"\n",
    "        else:\n",
    "            live_records = None\n",
    "            status = \"Missing from live CRM\"\n",
    "\n",
    "        comparison.append({\n",
    "            \"Worksheet\": name,\n",
    "            \"Backup Records\": backup_records,\n",
    "            \"Live Records\": live_records,\n",
    "            \"Live Worksheet\": status\n",
    "        })\n",
    "\n",
    "    print(\"\\nCRM RECOVERY PREVIEW\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "    display(pd.DataFrame(comparison))\n",
    "\n",
    "    print(\"\\n✓ Recovery preview complete.\")\n",
    "    print(\"✓ No live CRM data was changed.\")\n",
    "\n",
    "    return comparison\n",
    "\n",
    "\n",
    "def restore_crm_to_test_workbook(\n",
    "    backup_path,\n",
    "    confirmation=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Restore a verified backup into a NEW Google\n",
    "    Sheets workbook.\n",
    "\n",
    "    Never overwrites the existing CRM workbook.\n",
    "    \"\"\"\n",
    "\n",
    "    required_confirmation = \"CREATE TEST RESTORE\"\n",
    "\n",
    "    if confirmation != required_confirmation:\n",
    "        raise ValueError(\n",
    "            \"Recovery not authorized. To create a separate \"\n",
    "            \"test workbook, use confirmation=\"\n",
    "            \"'CREATE TEST RESTORE'.\"\n",
    "        )\n",
    "\n",
    "    verification = inspect_crm_backup(backup_path)\n",
    "\n",
    "    if not verification[\"Valid\"]:\n",
    "        raise ValueError(\n",
    "            \"Backup verification failed. Restore blocked.\"\n",
    "        )\n",
    "\n",
    "    manifest = verification[\"Manifest\"]\n",
    "\n",
    "    timestamp = datetime.now(\n",
    "        ZoneInfo(\"America/Chicago\")\n",
    "    ).strftime(\"%Y-%m-%d_%H-%M-%S\")\n",
    "\n",
    "    restore_name = (\n",
    "        f\"NSA CRM TEST RESTORE {timestamp} \"\n",
    "        f\"{uuid4().hex[:6].upper()}\"\n",
    "    )\n",
    "\n",
    "    # Create a separate workbook.\n",
    "    restored_book = gc.create(restore_name)\n",
    "\n",
    "    restored_sheets = []\n",
    "\n",
    "    with zipfile.ZipFile(backup_path, \"r\") as archive:\n",
    "\n",
    "        for item in manifest[\"Worksheets\"]:\n",
    "\n",
    "            name = item[\"Worksheet Name\"]\n",
    "            csv_file = item[\"CSV File\"]\n",
    "\n",
    "            csv_text = archive.read(\n",
    "                csv_file\n",
    "            ).decode(\"utf-8-sig\")\n",
    "\n",
    "            rows = list(\n",
    "                csv.reader(io.StringIO(csv_text))\n",
    "            )\n",
    "\n",
    "            row_count = max(1, len(rows))\n",
    "            column_count = max(\n",
    "                1,\n",
    "                max((len(r) for r in rows), default=1)\n",
    "            )\n",
    "\n",
    "            # Preserve Google Sheets' minimum dimensions.\n",
    "            target_rows = max(100, row_count)\n",
    "            target_cols = max(26, column_count)\n",
    "\n",
    "            # Use the initial sheet for the first tab,\n",
    "            # then create the remaining worksheets.\n",
    "            if not restored_sheets:\n",
    "                ws = restored_book.sheet1\n",
    "                ws.update_title(name)\n",
    "                ws.resize(\n",
    "                    rows=target_rows,\n",
    "                    cols=target_cols\n",
    "                )\n",
    "            else:\n",
    "                ws = restored_book.add_worksheet(\n",
    "                    title=name,\n",
    "                    rows=target_rows,\n",
    "                    cols=target_cols\n",
    "                )\n",
    "\n",
    "            if rows:\n",
    "                # RAW prevents Google Sheets from\n",
    "                # interpreting restored IDs as formulas.\n",
    "                ws.update(\n",
    "                    range_name=\"A1\",\n",
    "                    values=rows,\n",
    "                    value_input_option=\"RAW\"\n",
    "                )\n",
    "\n",
    "            restored_sheets.append(name)\n",
    "\n",
    "            print(f\"✓ Restored: {name}\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"TEST RECOVERY WORKBOOK CREATED\")\n",
    "    print(\"=\" * 60)\n",
    "    print(\"Workbook:\", restore_name)\n",
    "    print(\"Worksheets:\", len(restored_sheets))\n",
    "    print(\"URL:\", restored_book.url)\n",
    "    print(\"\\n✓ Original CRM workbook remains unchanged.\")\n",
    "    print(\"✓ Original CRM connection remains active.\")\n",
    "    print(\"✓ Review the test workbook before using it.\")\n",
    "\n",
    "    return {\n",
    "        \"Workbook Name\": restore_name,\n",
    "        \"Workbook ID\": restored_book.id,\n",
    "        \"Workbook URL\": restored_book.url,\n",
    "        \"Worksheets\": restored_sheets\n",
    "    }\n",
    "\n",
    "\n",
    "print(\"✓ Safe CRM recovery system installed!\")\n",
    "print(\"✓ Recovery preview enabled!\")\n",
    "print(\"✓ Separate test-workbook restoration enabled!\")\n",
    "print(\"✓ Live CRM overwrite protection enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
