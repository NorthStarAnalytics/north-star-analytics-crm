   "cell_type": "code",
   "source": [
    "# STEP 005 — Move Workbook into CRM Folder\n",
    "# Connect to Google Drive API using existing credentials\n",
    "drive_service = build(\"drive\", \"v3\", credentials=credentials)\n",
    "\n",
    "# Get the spreadsheet's Google Drive file ID\n",
    "spreadsheet_id = spreadsheet.id\n",
    "\n",
    "# Find the CRM database folder\n",
    "folder_name = \"01_CRM_Database\"\n",
    "\n",
    "folder_query = (\n",
    "    f\"name = '{folder_name}' \"\n",
    "    \"and mimeType = 'application/vnd.google-apps.folder' \"\n",
    "    \"and trashed = false\"\n",
    ")\n",
    "\n",
    "folder_results = drive_service.files().list(\n",
    "    q=folder_query,\n",
    "    fields=\"files(id, name, parents)\"\n",
    ").execute()\n",
    "\n",
    "folders = folder_results.get(\"files\", [])\n",
    "\n",
    "if not folders:\n",
    "    print(\"Database folder not found. Check Step 2.\")\n",
    "else:\n",
    "    folder_id = folders[0][\"id\"]\n",
    "\n",
    "    # Find current parent folder of spreadsheet\n",
    "    file_info = drive_service.files().get(\n",
    "        fileId=spreadsheet_id,\n",
    "        fields=\"parents\"\n",
    "    ).execute()\n",
    "\n",
    "    previous_parents = \",\".join(\n",
    "        file_info.get(\"parents\", [])\n",
    "    )\n",
    "\n",
    "    # Move spreadsheet to CRM database folder\n",
    "    drive_service.files().update(\n",
    "        fileId=spreadsheet_id,\n",
    "        addParents=folder_id,\n",
    "        removeParents=previous_parents,\n",
    "        fields=\"id, parents\"\n",
    "    ).execute()\n",
    "\n",
    "    print(\"✓ Master CRM moved successfully!\")\n",
    "    print(\"Location: North Star Analytics CRM / 01_CRM_Database\")\n",
    "    print(\"Spreadsheet URL:\", spreadsheet.url)\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
