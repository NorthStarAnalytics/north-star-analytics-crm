    "# STEP 019 — Financial Management\n",
    "financials_sheet = spreadsheet.worksheet(\"Financials\")\n",
    "\n",
    "financial_categories = [\n",
    "    \"Consulting Services\",\n",
    "    \"Continuing Services\",\n",
    "    \"Training\",\n",
    "    \"Dashboard Development\",\n",
    "    \"Custom Software\",\n",
    "    \"Travel\",\n",
    "    \"Software Subscriptions\",\n",
    "    \"Marketing\",\n",
    "    \"Office Expenses\",\n",
    "    \"Professional Services\",\n",
    "    \"Equipment\",\n",
    "    \"Other\"\n",
    "]\n",
    "\n",
    "def record_financial_transaction(\n",
    "    transaction_type,\n",
    "    category,\n",
    "    description,\n",
    "    amount,\n",
    "    company_id=\"\",\n",
    "    project_id=\"\",\n",
    "    invoice_number=\"\",\n",
    "    invoice_due_date=\"\",\n",
    "    payment_date=\"\",\n",
    "    payment_status=\"\",\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"Record an invoice, payment, or business expense.\"\"\"\n",
    "\n",
    "    valid_types = [\"Invoice\", \"Payment\", \"Expense\"]\n",
    "\n",
    "    if transaction_type not in valid_types:\n",
    "        raise ValueError(\"Invalid transaction type.\")\n",
    "\n",
    "    if category not in financial_categories:\n",
    "        raise ValueError(\"Invalid financial category.\")\n",
    "\n",
    "    amount = crm_money(amount)\n",
    "\n",
    "    if amount <= 0:\n",
    "        raise ValueError(\"Transaction amount must be greater than zero.\")\n",
    "\n",
    "    if company_id:\n",
    "        companies = companies_sheet.get_all_records()\n",
    "\n",
    "        if not any(\n",
    "            str(c[\"Company ID\"]) == str(company_id)\n",
    "            for c in companies\n",
    "        ):\n",
    "            raise ValueError(\"Company ID does not exist.\")\n",
    "\n",
    "    if project_id:\n",
    "        projects = projects_sheet.get_all_records()\n",
    "\n",
    "        matching_project = next(\n",
    "            (\n",
    "                p for p in projects\n",
    "                if str(p[\"Project ID\"]) == str(project_id)\n",
    "            ),\n",
    "            None\n",
    "        )\n",
    "\n",
    "        if matching_project is None:\n",
    "            raise ValueError(\"Project ID does not exist.\")\n",
    "\n",
    "        if company_id and str(\n",
    "            matching_project[\"Company ID\"]\n",
    "        ) != str(company_id):\n",
    "            raise ValueError(\n",
    "                \"Project does not belong to the selected company.\"\n",
    "            )\n",
    "\n",
    "    if invoice_due_date:\n",
    "        date.fromisoformat(str(invoice_due_date))\n",
    "\n",
    "    if payment_date:\n",
    "        date.fromisoformat(str(payment_date))\n",
    "\n",
    "    if transaction_type in [\"Invoice\", \"Payment\"]:\n",
    "        if not company_id:\n",
    "            raise ValueError(\n",
    "                \"Invoices and payments require a Company ID.\"\n",
    "            )\n",
    "        if not invoice_number:\n",
    "            raise ValueError(\n",
    "                \"Invoices and payments require an invoice number.\"\n",
    "            )\n",
    "\n",
    "    if transaction_type == \"Invoice\":\n",
    "        existing = financials_sheet.get_all_records()\n",
    "\n",
    "        if any(\n",
    "            r[\"Transaction Type\"] == \"Invoice\"\n",
    "            and str(r[\"Invoice Number\"]) == str(invoice_number)\n",
    "            for r in existing\n",
    "        ):\n",
    "            raise ValueError(\"Invoice number already exists.\")\n",
    "\n",
    "        payment_status = \"Unpaid\"\n",
    "\n",
    "    elif transaction_type == \"Payment\":\n",
    "        payment_status = \"Received\"\n",
    "        if not payment_date:\n",
    "            payment_date = crm_today().isoformat()\n",
    "\n",
    "    else:\n",
    "        payment_status = \"Paid\"\n",
    "        if not payment_date:\n",
    "            payment_date = crm_today().isoformat()\n",
    "\n",
    "    transaction_id = \"NSA-F-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    transaction_record = [\n",
    "        transaction_id,\n",
    "        company_id,\n",
    "        project_id,\n",
    "        crm_today().isoformat(),\n",
    "        transaction_type,\n",
    "        category,\n",
    "        description,\n",
    "        float(amount),\n",
    "        invoice_number,\n",
    "        invoice_due_date,\n",
    "        payment_date,\n",
    "        payment_status,\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    financials_sheet.append_row(\n",
    "        transaction_record,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Financial transaction recorded!\")\n",
    "    print(\"Transaction ID:\", transaction_id)\n",
    "    print(\"Type:\", transaction_type)\n",
    "    print(f\"Amount: ${amount:,.2f}\")\n",
    "\n",
    "    return transaction_id\n",
    "\n",
    "\n",
    "def show_financial_summary():\n",
    "    \"\"\"Calculate cash received, expenses, and net cash flow.\"\"\"\n",
    "\n",
    "    records = financials_sheet.get_all_records()\n",
    "\n",
    "    payments = sum(\n",
    "        float(r[\"Amount\"] or 0)\n",
    "        for r in records\n",
    "        if r[\"Transaction Type\"] == \"Payment\"\n",
    "    )\n",
    "\n",
    "    expenses = sum(\n",
    "        float(r[\"Amount\"] or 0)\n",
    "        for r in records\n",
    "        if r[\"Transaction Type\"] == \"Expense\"\n",
    "    )\n",
    "\n",
    "    invoiced = sum(\n",
    "        float(r[\"Amount\"] or 0)\n",
    "        for r in records\n",
    "        if r[\"Transaction Type\"] == \"Invoice\"\n",
    "    )\n",
    "\n",
    "    net_cash_flow = payments - expenses\n",
    "\n",
    "    print(\"NORTH STAR ANALYTICS\")\n",
    "    print(\"Financial Summary\")\n",
    "    print(\"------------------------------\")\n",
    "    print(f\"Total Invoiced: ${invoiced:,.2f}\")\n",
    "    print(f\"Payments Received: ${payments:,.2f}\")\n",
    "    print(f\"Business Expenses: ${expenses:,.2f}\")\n",
    "    print(f\"Net Cash Flow: ${net_cash_flow:,.2f}\")\n",
    "\n",
    "    return {\n",
    "        \"invoiced\": invoiced,\n",
    "        \"payments\": payments,\n",
    "        \"expenses\": expenses,\n",
    "        \"net_cash_flow\": net_cash_flow\n",
    "    }\n",
    "\n",
    "\n",
    "def show_outstanding_invoices():\n",
    "    \"\"\"Calculate invoice balances using recorded payments.\"\"\"\n",
    "\n",
    "    records = financials_sheet.get_all_records()\n",
    "\n",
    "    invoices = [\n",
    "        r for r in records\n",
    "        if r[\"Transaction Type\"] == \"Invoice\"\n",
    "    ]\n",
    "\n",
    "    payments = [\n",
    "        r for r in records\n",
    "        if r[\"Transaction Type\"] == \"Payment\"\n",
    "    ]\n",
    "\n",
    "    outstanding = []\n",
    "\n",
    "    for invoice in invoices:\n",
    "        invoice_number = str(invoice[\"Invoice Number\"])\n",
    "        company_id = str(invoice[\"Company ID\"])\n",
    "\n",
    "        paid = sum(\n",
    "            float(p[\"Amount\"] or 0)\n",
    "            for p in payments\n",
    "            if str(p[\"Invoice Number\"]) == invoice_number\n",
    "            and str(p[\"Company ID\"]) == company_id\n",
    "        )\n",
    "\n",
    "        balance = round(\n",
    "            float(invoice[\"Amount\"] or 0) - paid, 2\n",
    "        )\n",
    "\n",
    "        if balance <= 0:\n",
    "            continue\n",
    "\n",
    "        due_text = str(invoice[\"Invoice Due Date\"]).strip()\n",
    "        overdue = False\n",
    "\n",
    "        if due_text:\n",
    "            overdue = date.fromisoformat(due_text) < crm_today()\n",
    "\n",
    "        outstanding.append({\n",
    "            \"Invoice Number\": invoice_number,\n",
    "            \"Company ID\": company_id,\n",
    "            \"Invoice Amount\": float(invoice[\"Amount\"]),\n",
    "            \"Paid\": round(paid, 2),\n",
    "            \"Outstanding\": balance,\n",
    "            \"Due Date\": due_text,\n",
    "            \"Status\": \"Overdue\" if overdue else \"Outstanding\"\n",
    "        })\n",
    "\n",
    "    if not outstanding:\n",
    "        print(\"✓ No outstanding invoices.\")\n",
    "        return\n",
    "\n",
    "    display(pd.DataFrame(outstanding))\n",
    "\n",
    "\n",
    "print(\"✓ Financial management installed!\")\n",
    "print(\"✓ Invoice tracking enabled!\")\n",
    "print(\"✓ Payment recording enabled!\")\n",
    "print(\"✓ Expense tracking enabled!\")\n",
    "print(\"✓ Outstanding balance reporting enabled!\")\n",
    "print(\"✓ Cash flow reporting enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": [
    "# STEP 020 — Executive Dashboard\n",
    "dashboard_sheet = spreadsheet.worksheet(\"Dashboard\")\n",
    "\n",
    "def crm_number(value):\n",
    "    \"\"\"Safely convert Google Sheets values into numbers.\"\"\"\n",
    "    try:\n",
    "        return float(str(value).replace(\"$\", \"\").replace(\",\", \"\"))\n",
    "    except (ValueError, TypeError):\n",
    "        return 0.0\n",
    "\n",
    "\n",
    "def refresh_crm_dashboard():\n",
    "    \"\"\"\n",
    "    Read the CRM worksheets and refresh the executive dashboard.\n",
    "    This function does not modify underlying client records.\n",
    "    \"\"\"\n",
    "\n",
    "    companies = companies_sheet.get_all_records()\n",
    "    contacts = contacts_sheet.get_all_records()\n",
    "    activities = activities_sheet.get_all_records()\n",
    "    opportunities = opportunities_sheet.get_all_records()\n",
    "    followups = followups_sheet.get_all_records()\n",
    "    proposals = proposals_sheet.get_all_records()\n",
    "    projects = projects_sheet.get_all_records()\n",
    "    services = continuing_sheet.get_all_records()\n",
    "    financials = financials_sheet.get_all_records()\n",
    "\n",
    "    today = crm_today()\n",
    "    next_week = today + timedelta(days=7)\n",
    "\n",
    "    # Prospecting\n",
    "    total_companies = len(companies)\n",
    "    total_contacts = len(contacts)\n",
    "    total_activities = len(activities)\n",
    "\n",
    "    # Sales pipeline\n",
    "    open_opportunities = [\n",
    "        o for o in opportunities\n",
    "        if str(o[\"Outcome\"]).strip() not in [\"Won\", \"Lost\"]\n",
    "    ]\n",
    "\n",
    "    open_pipeline_value = sum(\n",
    "        crm_number(o[\"Estimated Value\"])\n",
    "        for o in open_opportunities\n",
    "    )\n",
    "\n",
    "    weighted_pipeline_value = sum(\n",
    "        crm_number(o[\"Weighted Value\"])\n",
    "        for o in open_opportunities\n",
    "    )\n",
    "\n",
    "    proposals_sent = sum(\n",
    "        str(p[\"Status\"]).strip() in [\n",
    "            \"Sent\", \"Under Review\"\n",
    "        ]\n",
    "        for p in proposals\n",
    "    )\n",
    "\n",
    "    # Follow-ups\n",
    "    overdue_tasks = 0\n",
    "    tasks_due_today = 0\n",
    "    upcoming_tasks = 0\n",
    "\n",
    "    for task in followups:\n",
    "        if str(task[\"Status\"]).strip() in [\n",
    "            \"Completed\", \"Cancelled\"\n",
    "        ]:\n",
    "            continue\n",
    "\n",
    "        due_text = str(task[\"Due Date\"]).strip()\n",
    "\n",
    "        if not due_text:\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "            due = date.fromisoformat(due_text)\n",
    "        except ValueError:\n",
    "            continue\n",
    "\n",
    "        if due < today:\n",
    "            overdue_tasks += 1\n",
    "        elif due == today:\n",
    "            tasks_due_today += 1\n",
    "        elif due <= next_week:\n",
    "            upcoming_tasks += 1\n",
    "\n",
    "    # Project management\n",
    "    active_projects = sum(\n",
    "        str(p[\"Project Status\"]).strip() in [\n",
    "            \"Active\", \"In Progress\"\n",
    "        ]\n",
    "        for p in projects\n",
    "    )\n",
    "\n",
    "    completed_projects = sum(\n",
    "        str(p[\"Project Status\"]).strip() == \"Completed\"\n",
    "        for p in projects\n",
    "    )\n",
    "\n",
    "    # Continuing services\n",
    "    active_services = [\n",
    "        s for s in services\n",
    "        if str(s[\"Status\"]).strip() == \"Active\"\n",
    "    ]\n",
    "\n",
    "    monthly_recurring_revenue = 0.0\n",
    "\n",
    "    for service in active_services:\n",
    "        fee = crm_number(service[\"Monthly Fee\"])\n",
    "        frequency = str(service[\"Billing Frequency\"]).strip()\n",
    "\n",
    "        if frequency == \"Monthly\":\n",
    "            monthly_recurring_revenue += fee\n",
    "        elif frequency == \"Quarterly\":\n",
    "            monthly_recurring_revenue += fee / 3\n",
    "        elif frequency == \"Annually\":\n",
    "            monthly_recurring_revenue += fee / 12\n",
    "\n",
    "    annualized_recurring_revenue = monthly_recurring_revenue * 12\n",
    "\n",
    "    # Financial performance\n",
    "    total_invoiced = sum(\n",
    "        crm_number(f[\"Amount\"])\n",
    "        for f in financials\n",
    "        if f[\"Transaction Type\"] == \"Invoice\"\n",
    "    )\n",
    "\n",
    "    payments_received = sum(\n",
    "        crm_number(f[\"Amount\"])\n",
    "        for f in financials\n",
    "        if f[\"Transaction Type\"] == \"Payment\"\n",
    "    )\n",
    "\n",
    "    business_expenses = sum(\n",
    "        crm_number(f[\"Amount\"])\n",
    "        for f in financials\n",
    "        if f[\"Transaction Type\"] == \"Expense\"\n",
    "    )\n",
    "\n",
    "    net_cash_flow = payments_received - business_expenses\n",
    "\n",
    "    # Aggregate outstanding balances, including partial payments\n",
    "    invoice_records = [\n",
    "        f for f in financials\n",
    "        if f[\"Transaction Type\"] == \"Invoice\"\n",
    "    ]\n",
    "\n",
    "    payment_records = [\n",
    "        f for f in financials\n",
    "        if f[\"Transaction Type\"] == \"Payment\"\n",
    "    ]\n",
    "\n",
    "    outstanding_balance = 0.0\n",
    "\n",
    "    for invoice in invoice_records:\n",
    "        paid = sum(\n",
    "            crm_number(payment[\"Amount\"])\n",
    "            for payment in payment_records\n",
    "            if str(payment[\"Invoice Number\"]) ==\n",
    "               str(invoice[\"Invoice Number\"])\n",
    "            and str(payment[\"Company ID\"]) ==\n",
    "                str(invoice[\"Company ID\"])\n",
    "        )\n",
    "\n",
    "        outstanding_balance += max(\n",
    "            0,\n",
    "            crm_number(invoice[\"Amount\"]) - paid\n",
    "        )\n",
    "\n",
    "    # Build dashboard rows\n",
    "    metrics = [\n",
    "        (\"PROSPECTING\", \"\", \"\"),\n",
    "        (\"Total Companies\", total_companies, \"\"),\n",
    "        (\"Total Contacts\", total_contacts, \"\"),\n",
    "        (\"Total Activities\", total_activities, \"\"),\n",
    "\n",
    "        (\"SALES PIPELINE\", \"\", \"\"),\n",
    "        (\"Open Opportunities\", len(open_opportunities), \"\"),\n",
    "        (\"Open Pipeline Value\", round(open_pipeline_value, 2), \"\"),\n",
    "        (\"Weighted Pipeline Value\", round(weighted_pipeline_value, 2), \"\"),\n",
    "        (\"Proposals Awaiting Decision\", proposals_sent, \"\"),\n",
    "\n",
    "        (\"FOLLOW-UPS\", \"\", \"\"),\n",
    "        (\"Overdue Follow-Ups\", overdue_tasks, \"\"),\n",
    "        (\"Follow-Ups Due Today\", tasks_due_today, \"\"),\n",
    "        (\"Follow-Ups Next 7 Days\", upcoming_tasks, \"\"),\n",
    "\n",
    "        (\"PROJECTS\", \"\", \"\"),\n",
    "        (\"Active Projects\", active_projects, \"\"),\n",
    "        (\"Completed Projects\", completed_projects, \"\"),\n",
    "\n",
    "        (\"CONTINUING SERVICES\", \"\", \"\"),\n",
    "        (\"Active Agreements\", len(active_services), \"\"),\n",
    "        (\"Monthly Recurring Revenue\", round(monthly_recurring_revenue, 2), \"\"),\n",
    "        (\"Annualized Recurring Revenue\", round(annualized_recurring_revenue, 2), \"\"),\n",
    "\n",
    "        (\"FINANCIAL PERFORMANCE\", \"\", \"\"),\n",
    "        (\"Total Invoiced\", round(total_invoiced, 2), \"\"),\n",
    "        (\"Payments Received\", round(payments_received, 2), \"\"),\n",
    "        (\"Business Expenses\", round(business_expenses, 2), \"\"),\n",
    "        (\"Net Cash Flow\", round(net_cash_flow, 2), \"\"),\n",
    "        (\"Outstanding Invoice Balance\", round(outstanding_balance, 2), \"\")\n",
    "    ]\n",
    "\n",
    "    timestamp = datetime.now(\n",
    "        ZoneInfo(\"America/Chicago\")\n",
    "    ).strftime(\"%Y-%m-%d %I:%M %p CT\")\n",
    "\n",
    "    rows = [[\"Metric\", \"Value\", \"Last Updated\"]]\n",
    "\n",
    "    for metric, value, _ in metrics:\n",
    "        rows.append([metric, value, timestamp])\n",
    "\n",
    "    # Clear previous dashboard values and write fresh results\n",
    "    dashboard_sheet.clear()\n",
    "\n",
    "    dashboard_sheet.update(\n",
    "        range_name=\"A1\",\n",
    "        values=rows,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    dashboard_sheet.freeze(rows=1)\n",
    "\n",
    "    print(\"✓ Executive CRM dashboard refreshed!\")\n",
    "    print(\"Last Updated:\", timestamp)\n",
    "    print()\n",
    "    print(\"Companies:\", total_companies)\n",
    "    print(\"Open Opportunities:\", len(open_opportunities))\n",
    "    print(f\"Pipeline Value: ${open_pipeline_value:,.2f}\")\n",
    "    print(\"Overdue Follow-Ups:\", overdue_tasks)\n",
    "    print(\"Active Projects:\", active_projects)\n",
    "    print(f\"Monthly Recurring Revenue: ${monthly_recurring_revenue:,.2f}\")\n",
    "    print(f\"Payments Received: ${payments_received:,.2f}\")\n",
    "    print(f\"Outstanding Invoices: ${outstanding_balance:,.2f}\")\n",
    "\n",
    "    return {\n",
    "        \"companies\": total_companies,\n",
    "        \"open_opportunities\": len(open_opportunities),\n",
    "        \"pipeline_value\": open_pipeline_value,\n",
    "        \"overdue_followups\": overdue_tasks,\n",
    "        \"active_projects\": active_projects,\n",
    "        \"monthly_recurring_revenue\": monthly_recurring_revenue,\n",
    "        \"payments_received\": payments_received,\n",
    "        \"outstanding_invoices\": outstanding_balance\n",
    "    }\n",
    "\n",
    "\n",
    "# Run the first dashboard refresh\n",
    "crm_dashboard_results = refresh_crm_dashboard()\n"
