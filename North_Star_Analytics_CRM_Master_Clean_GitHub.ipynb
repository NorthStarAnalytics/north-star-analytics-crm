   "outputs": []
  },
  {
   "cell_type": "code",
   "source": [
    "# STEP 010 — Contact Management\n",
    "contacts_sheet = spreadsheet.worksheet(\"Contacts\")\n",
    "\n",
    "def create_contact(\n",
    "    company_id,\n",
    "    first_name,\n",
    "    last_name,\n",
    "    job_title=\"\",\n",
    "    department=\"\",\n",
    "    email=\"\",\n",
    "    phone=\"\",\n",
    "    decision_maker=\"Unknown\",\n",
    "    preferred_contact_method=\"Email\",\n",
    "    tags=None,\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Creates a contact and links it to an existing company.\n",
    "    Prevents duplicate contacts within the same company.\n",
    "    \"\"\"\n",
    "\n",
    "    # Verify company exists\n",
    "    company_records = companies_sheet.get_all_records()\n",
    "\n",
    "    company_exists = any(\n",
    "        str(company[\"Company ID\"]) == str(company_id)\n",
    "        for company in company_records\n",
    "    )\n",
    "\n",
    "    if not company_exists:\n",
    "        raise ValueError(\n",
    "            f\"Company ID {company_id} does not exist.\"\n",
    "        )\n",
    "\n",
    "    if not first_name.strip() or not last_name.strip():\n",
    "        raise ValueError(\"First and last name are required.\")\n",
    "\n",
    "    # Check for existing contact\n",
    "    existing_contacts = contacts_sheet.get_all_records()\n",
    "\n",
    "    for contact in existing_contacts:\n",
    "        same_company = (\n",
    "            str(contact[\"Company ID\"]) == str(company_id)\n",
    "        )\n",
    "\n",
    "        same_name = (\n",
    "            str(contact[\"First Name\"]).strip().lower()\n",
    "            == first_name.strip().lower()\n",
    "            and\n",
    "            str(contact[\"Last Name\"]).strip().lower()\n",
    "            == last_name.strip().lower()\n",
    "        )\n",
    "\n",
    "        if same_company and same_name:\n",
    "            print(\"⚠ Contact already exists.\")\n",
    "            print(\"Contact ID:\", contact[\"Contact ID\"])\n",
    "            return contact[\"Contact ID\"]\n",
    "\n",
    "    # Generate unique contact ID\n",
    "    contact_id = \"NSA-CT-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    # Prepare contact record\n",
    "    contact_record = [\n",
    "        contact_id,\n",
    "        company_id,\n",
    "        first_name.strip(),\n",
    "        last_name.strip(),\n",
    "        job_title,\n",
    "        department,\n",
    "        email,\n",
    "        phone,\n",
    "        decision_maker,\n",
    "        preferred_contact_method,\n",
    "        \", \".join(tags or []),\n",
    "        \"\",\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    # Save to Google Sheets\n",
    "    contacts_sheet.append_row(\n",
    "        contact_record,\n",
    "        value_input_option=\"USER_ENTERED\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Contact successfully created!\")\n",
    "    print(\"Name:\", first_name, last_name)\n",
    "    print(\"Company ID:\", company_id)\n",
    "    print(\"Contact ID:\", contact_id)\n",
    "\n",
    "    return contact_id\n",
    "\n",
    "\n",
    "print(\"✓ Contact management system installed!\")\n",
    "print(\"✓ Company linking enabled!\")\n",
    "print(\"✓ Duplicate contact detection enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
