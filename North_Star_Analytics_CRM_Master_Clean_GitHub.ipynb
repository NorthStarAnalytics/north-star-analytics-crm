  {
   "cell_type": "code",
   "source": [
    "# STEP 016 — Proposal Management\n",
    "proposals_sheet = spreadsheet.worksheet(\"Proposals\")\n",
    "\n",
    "# Scope protections from North Star Analytics strategy\n",
    "proposal_addons = [\n",
    "    \"Additional Locations\",\n",
    "    \"More Than Four Workflows\",\n",
    "    \"Major Dashboard Development\",\n",
    "    \"Extensive Historical Data Cleanup\",\n",
    "    \"Custom Software Development\",\n",
    "    \"On-Site Travel\",\n",
    "    \"Additional Training Sessions\",\n",
    "    \"Urgent Work Outside Established Schedule\"\n",
    "]\n",
    "\n",
    "continuing_service_options = [\n",
    "    \"Quarterly Process Review\",\n",
    "    \"Monthly KPI Reporting\",\n",
    "    \"Dashboard Maintenance\",\n",
    "    \"Data-Quality Monitoring\",\n",
    "    \"New Workflow Review\",\n",
    "    \"Process Documentation\",\n",
    "    \"Employee Training\",\n",
    "    \"Implementation Support\",\n",
    "    \"Annual Performance Assessment\",\n",
    "    \"Full Partnership\"\n",
    "]\n",
    "\n",
    "def crm_money(value):\n",
    "    \"\"\"Validate and standardize currency amounts.\"\"\"\n",
    "    try:\n",
    "        amount = Decimal(str(value))\n",
    "    except (InvalidOperation, ValueError):\n",
    "        raise ValueError(\"Enter a valid monetary amount.\")\n",
    "\n",
    "    if not amount.is_finite() or amount < 0:\n",
    "        raise ValueError(\"Amount must be finite and nonnegative.\")\n",
    "\n",
    "    return amount.quantize(Decimal(\"0.01\"))\n",
    "\n",
    "\n",
    "def create_proposal(\n",
    "    opportunity_id,\n",
    "    service_package,\n",
    "    base_price,\n",
    "    addon_price=0,\n",
    "    scope=\"\",\n",
    "    exclusions=\"\",\n",
    "    proposal_link=\"\",\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Create a proposal linked to an existing opportunity.\n",
    "    Calculate the total proposed contract value.\n",
    "    \"\"\"\n",
    "\n",
    "    opportunities = opportunities_sheet.get_all_records()\n",
    "\n",
    "    opportunity = next(\n",
    "        (\n",
    "            record for record in opportunities\n",
    "            if str(record[\"Opportunity ID\"]) == str(opportunity_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if opportunity is None:\n",
    "        raise ValueError(\"Opportunity ID does not exist.\")\n",
    "\n",
    "    if opportunity[\"Outcome\"] in [\"Lost\", \"Won\"]:\n",
    "        raise ValueError(\n",
    "            \"Cannot create a new proposal for a closed opportunity.\"\n",
    "        )\n",
    "\n",
    "    base = crm_money(base_price)\n",
    "    addons = crm_money(addon_price)\n",
    "    total = base + addons\n",
    "\n",
    "    proposal_id = \"NSA-P-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    proposal_record = [\n",
    "        proposal_id,\n",
    "        opportunity_id,\n",
    "        opportunity[\"Company ID\"],\n",
    "        crm_today().isoformat(),\n",
    "        service_package,\n",
    "        float(base),\n",
    "        float(addons),\n",
    "        float(total),\n",
    "        scope,\n",
    "        exclusions,\n",
    "        \"Draft\",\n",
    "        \"\",\n",
    "        proposal_link,\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    proposals_sheet.append_row(\n",
    "        proposal_record,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Proposal created successfully!\")\n",
    "    print(\"Proposal ID:\", proposal_id)\n",
    "    print(\"Service:\", service_package)\n",
    "    print(f\"Base Price: ${base:,.2f}\")\n",
    "    print(f\"Add-Ons: ${addons:,.2f}\")\n",
    "    print(f\"Total Proposal: ${total:,.2f}\")\n",
    "    print(\"Status: Draft\")\n",
    "\n",
    "    return proposal_id\n",
    "\n",
    "\n",
    "def update_proposal_status(proposal_id, new_status):\n",
    "    \"\"\"Update proposal status and record decision dates.\"\"\"\n",
    "\n",
    "    valid_statuses = [\n",
    "        \"Draft\", \"Sent\", \"Under Review\",\n",
    "        \"Accepted\", \"Declined\", \"Expired\"\n",
    "    ]\n",
    "\n",
    "    if new_status not in valid_statuses:\n",
    "        raise ValueError(\"Invalid proposal status.\")\n",
    "\n",
    "    records = proposals_sheet.get_all_records()\n",
    "\n",
    "    for row_number, record in enumerate(records, start=2):\n",
    "        if str(record[\"Proposal ID\"]) == str(proposal_id):\n",
    "\n",
    "            decision_date = (\n",
    "                crm_today().isoformat()\n",
    "                if new_status in [\"Accepted\", \"Declined\", \"Expired\"]\n",
    "                else \"\"\n",
    "            )\n",
    "\n",
    "            proposals_sheet.update(\n",
    "                range_name=f\"K{row_number}:L{row_number}\",\n",
    "                values=[[new_status, decision_date]]\n",
    "            )\n",
    "\n",
    "            print(\"✓ Proposal status updated:\", new_status)\n",
    "            return\n",
    "\n",
    "    raise ValueError(\"Proposal ID not found.\")\n",
    "\n",
    "\n",
    "def show_proposals():\n",
    "    \"\"\"Display proposals and their current statuses.\"\"\"\n",
    "\n",
    "    records = proposals_sheet.get_all_records()\n",
    "\n",
    "    if not records:\n",
    "        print(\"No proposals have been created yet.\")\n",
    "        return\n",
    "\n",
    "    df = pd.DataFrame(records)\n",
    "\n",
    "    display(df[[\n",
    "        \"Proposal ID\",\n",
    "        \"Company ID\",\n",
    "        \"Service Package\",\n",
    "        \"Total Price\",\n",
    "        \"Status\",\n",
    "        \"Decision Date\"\n",
    "    ]])\n",
    "\n",
    "\n",
    "print(\"✓ Proposal management installed!\")\n",
    "print(\"✓ Automatic pricing calculations enabled!\")\n",
    "print(\"✓ Proposal status tracking enabled!\")\n",
    "print(\"✓ Add-on scope categories configured!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": [
    "# STEP 017 — Project and Task Management\n",
    "projects_sheet = spreadsheet.worksheet(\"Projects\")\n",
    "project_tasks_sheet = spreadsheet.worksheet(\"Project Tasks\")\n",
    "\n",
    "def create_project(\n",
    "    company_id,\n",
    "    project_name,\n",
    "    service_type,\n",
    "    start_date,\n",
    "    target_completion_date,\n",
    "    contract_value,\n",
    "    opportunity_id=\"\",\n",
    "    hours_estimated=0,\n",
    "    deliverables=\"\",\n",
    "    project_folder_link=\"\",\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"Create a project linked to an existing company.\"\"\"\n",
    "\n",
    "    companies = companies_sheet.get_all_records()\n",
    "\n",
    "    if not any(\n",
    "        str(c[\"Company ID\"]) == str(company_id)\n",
    "        for c in companies\n",
    "    ):\n",
    "        raise ValueError(\"Company ID does not exist.\")\n",
    "\n",
    "    if opportunity_id:\n",
    "        opportunities = opportunities_sheet.get_all_records()\n",
    "\n",
    "        valid_opportunity = any(\n",
    "            str(o[\"Opportunity ID\"]) == str(opportunity_id)\n",
    "            and str(o[\"Company ID\"]) == str(company_id)\n",
    "            for o in opportunities\n",
    "        )\n",
    "\n",
    "        if not valid_opportunity:\n",
    "            raise ValueError(\n",
    "                \"Opportunity does not belong to this company.\"\n",
    "            )\n",
    "\n",
    "    start = date.fromisoformat(str(start_date))\n",
    "    target = date.fromisoformat(str(target_completion_date))\n",
    "\n",
    "    if target < start:\n",
    "        raise ValueError(\n",
    "            \"Target completion date cannot precede start date.\"\n",
    "        )\n",
    "\n",
    "    value = crm_money(contract_value)\n",
    "\n",
    "    if hours_estimated < 0:\n",
    "        raise ValueError(\"Estimated hours cannot be negative.\")\n",
    "\n",
    "    project_id = \"NSA-PR-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    project_record = [\n",
    "        project_id,\n",
    "        company_id,\n",
    "        opportunity_id,\n",
    "        project_name,\n",
    "        service_type,\n",
    "        start.isoformat(),\n",
    "        target.isoformat(),\n",
    "        \"\",\n",
    "        \"Not Started\",\n",
    "        float(value),\n",
    "        float(hours_estimated),\n",
    "        0,\n",
    "        deliverables,\n",
    "        project_folder_link,\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    projects_sheet.append_row(\n",
    "        project_record,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Project created!\")\n",
    "    print(\"Project:\", project_name)\n",
    "    print(\"Project ID:\", project_id)\n",
    "    print(f\"Contract Value: ${value:,.2f}\")\n",
    "\n",
    "    return project_id\n",
    "\n",
    "\n",
    "def create_project_task(\n",
    "    project_id,\n",
    "    task_name,\n",
    "    due_date,\n",
    "    description=\"\",\n",
    "    priority=\"Medium\",\n",
    "    start_date=\"\",\n",
    "    estimated_hours=0,\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"Create a task linked to an existing project.\"\"\"\n",
    "\n",
    "    projects = projects_sheet.get_all_records()\n",
    "\n",
    "    if not any(\n",
    "        str(p[\"Project ID\"]) == str(project_id)\n",
    "        for p in projects\n",
    "    ):\n",
    "        raise ValueError(\"Project ID does not exist.\")\n",
    "\n",
    "    due = date.fromisoformat(str(due_date))\n",
    "\n",
    "    if start_date:\n",
    "        start = date.fromisoformat(str(start_date))\n",
    "\n",
    "        if due < start:\n",
    "            raise ValueError(\n",
    "                \"Due date cannot precede task start date.\"\n",
    "            )\n",
    "\n",
    "    if estimated_hours < 0:\n",
    "        raise ValueError(\"Estimated hours cannot be negative.\")\n",
    "\n",
    "    task_id = \"NSA-PT-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    task_record = [\n",
    "        task_id,\n",
    "        project_id,\n",
    "        task_name,\n",
    "        description,\n",
    "        priority,\n",
    "        start_date,\n",
    "        due.isoformat(),\n",
    "        \"Not Started\",\n",
    "        \"\",\n",
    "        float(estimated_hours),\n",
    "        0,\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    project_tasks_sheet.append_row(\n",
    "        task_record,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Project task created!\")\n",
    "    print(\"Task:\", task_name)\n",
    "    print(\"Due:\", due)\n",
    "\n",
    "    return task_id\n",
    "\n",
    "\n",
    "def complete_project_task(task_id, actual_hours=0):\n",
    "    \"\"\"Complete a task and record actual hours.\"\"\"\n",
    "\n",
    "    if actual_hours < 0:\n",
    "        raise ValueError(\"Actual hours cannot be negative.\")\n",
    "\n",
    "    records = project_tasks_sheet.get_all_records()\n",
    "\n",
    "    for row_number, record in enumerate(records, start=2):\n",
    "        if str(record[\"Project Task ID\"]) == str(task_id):\n",
    "\n",
    "            project_tasks_sheet.update(\n",
    "                range_name=f\"H{row_number}:K{row_number}\",\n",
    "                values=[[\n",
    "                    \"Completed\",\n",
    "                    crm_today().isoformat(),\n",
    "                    record[\"Estimated Hours\"],\n",
    "                    float(actual_hours)\n",
    "                ]]\n",
    "            )\n",
    "\n",
    "            print(\"✓ Task completed:\", task_id)\n",
    "            return\n",
    "\n",
    "    raise ValueError(\"Project task not found.\")\n",
    "\n",
    "\n",
    "def show_project_progress(project_id):\n",
    "    \"\"\"Display task progress and hours for a project.\"\"\"\n",
    "\n",
    "    projects = projects_sheet.get_all_records()\n",
    "\n",
    "    project = next(\n",
    "        (\n",
    "            p for p in projects\n",
    "            if str(p[\"Project ID\"]) == str(project_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if project is None:\n",
    "        raise ValueError(\"Project ID not found.\")\n",
    "\n",
    "    tasks = [\n",
    "        t for t in project_tasks_sheet.get_all_records()\n",
    "        if str(t[\"Project ID\"]) == str(project_id)\n",
    "    ]\n",
    "\n",
    "    total_tasks = len(tasks)\n",
    "    completed_tasks = sum(\n",
    "        t[\"Status\"] == \"Completed\" for t in tasks\n",
    "    )\n",
    "\n",
    "    progress = (\n",
    "        completed_tasks / total_tasks * 100\n",
    "        if total_tasks else 0\n",
    "    )\n",
    "\n",
    "    actual_hours = sum(\n",
    "        float(t[\"Actual Hours\"] or 0) for t in tasks\n",
    "    )\n",
    "\n",
    "    estimated_hours = sum(\n",
    "        float(t[\"Estimated Hours\"] or 0) for t in tasks\n",
    "    )\n",
    "\n",
    "    print(\"Project:\", project[\"Project Name\"])\n",
    "    print(f\"Progress: {progress:.1f}%\")\n",
    "    print(f\"Completed Tasks: {completed_tasks}/{total_tasks}\")\n",
    "    print(f\"Estimated Task Hours: {estimated_hours:.1f}\")\n",
    "    print(f\"Actual Task Hours: {actual_hours:.1f}\")\n",
    "\n",
    "    if tasks:\n",
    "        display(pd.DataFrame(tasks)[[\n",
    "            \"Task Name\", \"Priority\", \"Due Date\",\n",
    "            \"Status\", \"Estimated Hours\", \"Actual Hours\"\n",
    "        ]])\n",
    "\n",
    "\n",
    "print(\"✓ Project management installed!\")\n",
    "print(\"✓ Project creation enabled!\")\n",
    "print(\"✓ Project task tracking enabled!\")\n",
    "print(\"✓ Time tracking enabled!\")\n",
    "print(\"✓ Project progress reporting enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
