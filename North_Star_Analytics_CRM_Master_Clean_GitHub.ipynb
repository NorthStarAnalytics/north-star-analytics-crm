   "cell_type": "code",
   "source": [
    "# STEP 045 — Outreach Dashboard Verification\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "def verify_outreach_dashboard():\n",
    "\n",
    "    print(\"=\" * 60)\n",
    "    print(\"NORTH STAR ANALYTICS — OUTREACH VERIFICATION\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    expected_goals = {\n",
    "        \"Phone\": (10, 50),\n",
    "        \"Email\": (10, 50),\n",
    "        \"LinkedIn\": (5, 25),\n",
    "        \"In-Person\": (2, 10),\n",
    "        \"Video\": (1, 5),\n",
    "        \"Referral\": (2, 10)\n",
    "    }\n",
    "\n",
    "    goals = outreach_goals_sheet.get_all_records()\n",
    "    activities = activities_sheet.get_all_records()\n",
    "\n",
    "    today = crm_today().isoformat()\n",
    "\n",
    "    results = []\n",
    "\n",
    "    for activity_type, (daily, weekly) in expected_goals.items():\n",
    "\n",
    "        matching = [\n",
    "            g for g in goals\n",
    "            if str(g[\"Activity Type\"]).strip().lower()\n",
    "            == activity_type.lower()\n",
    "        ]\n",
    "\n",
    "        if len(matching) != 1:\n",
    "            results.append({\n",
    "                \"Activity Type\": activity_type,\n",
    "                \"Daily Goal\": daily,\n",
    "                \"Weekly Goal\": weekly,\n",
    "                \"Status\": \"MISSING OR DUPLICATE\"\n",
    "            })\n",
    "            continue\n",
    "\n",
    "        goal = matching[0]\n",
    "\n",
    "        try:\n",
    "            actual_daily = int(float(goal[\"Daily Goal\"]))\n",
    "            actual_weekly = int(float(goal[\"Weekly Goal\"]))\n",
    "        except (ValueError, TypeError):\n",
    "            actual_daily = None\n",
    "            actual_weekly = None\n",
    "\n",
    "        active = str(goal[\"Active\"]).strip().lower() in [\n",
    "            \"yes\", \"true\", \"active\"\n",
    "        ]\n",
    "\n",
    "        passed = (\n",
    "            actual_daily == daily\n",
    "            and actual_weekly == weekly\n",
    "            and active\n",
    "        )\n",
    "\n",
    "        results.append({\n",
    "            \"Activity Type\": activity_type,\n",
    "            \"Daily Goal\": actual_daily,\n",
    "            \"Weekly Goal\": actual_weekly,\n",
    "            \"Status\": \"PASS\" if passed else \"REVIEW\"\n",
    "        })\n",
    "\n",
    "    display(pd.DataFrame(results))\n",
    "\n",
    "    print(\"\\nTODAY'S RECORDED OUTREACH\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "    today_activities = [\n",
    "        a for a in activities\n",
    "        if str(a[\"Activity Date\"])[:10] == today\n",
    "        and str(a[\"Direction\"]).strip().lower()\n",
    "        == \"outbound\"\n",
    "    ]\n",
    "\n",
    "    excluded_outcomes = {\n",
    "        \"draft\", \"planned\", \"not sent\", \"cancelled\"\n",
    "    }\n",
    "\n",
    "    completed_activities = [\n",
    "        a for a in today_activities\n",
    "        if str(a[\"Outcome\"]).strip().lower()\n",
    "        not in excluded_outcomes\n",
    "    ]\n",
    "\n",
    "    print(\"Date:\", today)\n",
    "    print(\"Outbound activity records:\", len(today_activities))\n",
    "    print(\"Counted toward goals:\", len(completed_activities))\n",
    "\n",
    "    print(\"\\nDRAFT EXCLUSION TEST\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "    simulated_draft = {\n",
    "        \"Activity Type\": \"Email\",\n",
    "        \"Direction\": \"Outbound\",\n",
    "        \"Outcome\": \"Draft\"\n",
    "    }\n",
    "\n",
    "    draft_counted = (\n",
    "        simulated_draft[\"Outcome\"].lower()\n",
    "        not in excluded_outcomes\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Simulated unsent draft counted:\",\n",
    "        draft_counted\n",
    "    )\n",
    "\n",
    "    all_goals_pass = all(\n",
    "        r[\"Status\"] == \"PASS\"\n",
    "        for r in results\n",
    "    )\n",
    "\n",
    "    if all_goals_pass and not draft_counted:\n",
    "        print(\"\\n✓ OUTREACH CONFIGURATION VERIFIED\")\n",
    "    else:\n",
    "        print(\"\\n⚠ OUTREACH CONFIGURATION NEEDS REVIEW\")\n",
    "\n",
    "    print(\"\\nNo CRM records were changed.\")\n",
    "\n",
    "    return {\n",
    "        \"Goals Verified\": all_goals_pass,\n",
    "        \"Draft Exclusion Verified\": not draft_counted,\n",
    "        \"Today's Counted Activities\": len(\n",
    "            completed_activities\n",
    "        )\n",
    "    }\n",
    "\n",
    "\n",
    "outreach_verification = verify_outreach_dashboard()\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
