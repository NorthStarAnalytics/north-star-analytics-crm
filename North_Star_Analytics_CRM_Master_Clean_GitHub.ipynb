    "# STEP 046 — CRM Relationship Audit\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "def audit_crm_relationships():\n",
    "\n",
    "    print(\"=\" * 65)\n",
    "    print(\"NORTH STAR ANALYTICS — RELATIONSHIP AUDIT\")\n",
    "    print(\"=\" * 65)\n",
    "\n",
    "    relationships = {\n",
    "        \"Contacts\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "        },\n",
    "        \"Activities\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Contact ID\": \"Contacts\"\n",
    "        },\n",
    "        \"Opportunities\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Contact ID\": \"Contacts\"\n",
    "        },\n",
    "        \"Follow-Ups\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Contact ID\": \"Contacts\",\n",
    "            \"Opportunity ID\": \"Opportunities\"\n",
    "        },\n",
    "        \"Discovery\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Contact ID\": \"Contacts\"\n",
    "        },\n",
    "        \"Discovery Interviews\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Contact ID\": \"Contacts\"\n",
    "        },\n",
    "        \"Proposals\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Opportunity ID\": \"Opportunities\"\n",
    "        },\n",
    "        \"Projects\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Opportunity ID\": \"Opportunities\"\n",
    "        },\n",
    "        \"Project Tasks\": {\n",
    "            \"Project ID\": \"Projects\"\n",
    "        },\n",
    "        \"Continuing Services\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Project ID\": \"Projects\"\n",
    "        },\n",
    "        \"Financials\": {\n",
    "            \"Company ID\": \"Companies\",\n",
    "            \"Project ID\": \"Projects\"\n",
    "        },\n",
    "        \"Proposal Scope Drafts\": {\n",
    "            \"Company ID\": \"Companies\"\n",
    "        }\n",
    "    }\n",
    "\n",
    "    primary_keys = {\n",
    "        \"Companies\": \"Company ID\",\n",
    "        \"Contacts\": \"Contact ID\",\n",
    "        \"Activities\": \"Activity ID\",\n",
    "        \"Opportunities\": \"Opportunity ID\",\n",
    "        \"Follow-Ups\": \"Task ID\",\n",
    "        \"Discovery\": \"Discovery ID\",\n",
    "        \"Discovery Interviews\": \"Interview ID\",\n",
    "        \"Proposals\": \"Proposal ID\",\n",
    "        \"Projects\": \"Project ID\",\n",
    "        \"Project Tasks\": \"Project Task ID\",\n",
    "        \"Continuing Services\": \"Service ID\",\n",
    "        \"Financials\": \"Transaction ID\",\n",
    "        \"Proposal Scope Drafts\": \"Scope Draft ID\"\n",
    "    }\n",
    "\n",
    "    # Load worksheet records\n",
    "    records = {\n",
    "        ws.title: ws.get_all_records()\n",
    "        for ws in spreadsheet.worksheets()\n",
    "    }\n",
    "\n",
    "    valid_ids = {}\n",
    "\n",
    "    for sheet_name, key in primary_keys.items():\n",
    "\n",
    "        rows = records.get(sheet_name, [])\n",
    "\n",
    "        valid_ids[sheet_name] = {\n",
    "            str(row.get(key, \"\")).strip()\n",
    "            for row in rows\n",
    "            if str(row.get(key, \"\")).strip()\n",
    "        }\n",
    "\n",
    "    findings = []\n",
    "\n",
    "    for sheet_name, fields in relationships.items():\n",
    "\n",
    "        rows = records.get(sheet_name, [])\n",
    "\n",
    "        for field, parent_sheet in fields.items():\n",
    "\n",
    "            missing_references = 0\n",
    "\n",
    "            for row in rows:\n",
    "\n",
    "                value = str(\n",
    "                    row.get(field, \"\")\n",
    "                ).strip()\n",
    "\n",
    "                # Optional relationships may be blank.\n",
    "                if not value:\n",
    "                    continue\n",
    "\n",
    "                if value not in valid_ids[parent_sheet]:\n",
    "                    missing_references += 1\n",
    "\n",
    "            findings.append({\n",
    "                \"Worksheet\": sheet_name,\n",
    "                \"Relationship\": (\n",
    "                    f\"{field} → {parent_sheet}\"\n",
    "                ),\n",
    "                \"Records Checked\": len(rows),\n",
    "                \"Invalid References\": missing_references,\n",
    "                \"Status\": (\n",
    "                    \"PASS\"\n",
    "                    if missing_references == 0\n",
    "                    else \"REVIEW\"\n",
    "                )\n",
    "            })\n",
    "\n",
    "    display(pd.DataFrame(findings))\n",
    "\n",
    "    print(\"\\nPRIMARY KEY DUPLICATE CHECK\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    duplicate_findings = []\n",
    "\n",
    "    for sheet_name, key in primary_keys.items():\n",
    "\n",
    "        values = [\n",
    "            str(row.get(key, \"\")).strip()\n",
    "            for row in records.get(sheet_name, [])\n",
    "            if str(row.get(key, \"\")).strip()\n",
    "        ]\n",
    "\n",
    "        duplicates = len(values) - len(set(values))\n",
    "\n",
    "        duplicate_findings.append({\n",
    "            \"Worksheet\": sheet_name,\n",
    "            \"Duplicate IDs\": duplicates,\n",
    "            \"Status\": (\n",
    "                \"PASS\" if duplicates == 0 else \"REVIEW\"\n",
    "            )\n",
    "        })\n",
    "\n",
    "    display(pd.DataFrame(duplicate_findings))\n",
    "\n",
    "    relationship_pass = all(\n",
    "        item[\"Status\"] == \"PASS\"\n",
    "        for item in findings\n",
    "    )\n",
    "\n",
    "    duplicate_pass = all(\n",
    "        item[\"Status\"] == \"PASS\"\n",
    "        for item in duplicate_findings\n",
    "    )\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 65)\n",
    "\n",
    "    if relationship_pass and duplicate_pass:\n",
    "        print(\"✓ EXISTING CRM RELATIONSHIPS VERIFIED\")\n",
    "    else:\n",
    "        print(\"⚠ CRM RELATIONSHIP ISSUES DETECTED\")\n",
    "\n",
    "    print(\"✓ No records were modified.\")\n",
    "\n",
    "    return {\n",
    "        \"Relationships Valid\": relationship_pass,\n",
    "        \"Primary Keys Unique\": duplicate_pass,\n",
    "        \"Relationship Findings\": findings,\n",
    "        \"Duplicate Findings\": duplicate_findings\n",
    "    }\n",
    "\n",
    "\n",
    "relationship_audit = audit_crm_relationships()\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
