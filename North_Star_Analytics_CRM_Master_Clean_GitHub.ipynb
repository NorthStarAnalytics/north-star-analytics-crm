    "# STEP 042 — Test-Restore Verification\n",
    "def verify_test_restore(backup_path, restored_workbook_id):\n",
    "\n",
    "    verification = inspect_crm_backup(backup_path)\n",
    "\n",
    "    if not verification[\"Valid\"]:\n",
    "        raise ValueError(\"Backup verification failed.\")\n",
    "\n",
    "    restored_book = gc.open_by_key(restored_workbook_id)\n",
    "\n",
    "    with zipfile.ZipFile(backup_path, \"r\") as archive:\n",
    "        manifest = json.loads(\n",
    "            archive.read(\"backup_manifest.json\")\n",
    "        )\n",
    "\n",
    "        expected_names = {\n",
    "            item[\"Worksheet Name\"]\n",
    "            for item in manifest[\"Worksheets\"]\n",
    "        }\n",
    "\n",
    "        actual_names = {\n",
    "            ws.title for ws in restored_book.worksheets()\n",
    "        }\n",
    "\n",
    "        results = []\n",
    "\n",
    "        for item in manifest[\"Worksheets\"]:\n",
    "\n",
    "            name = item[\"Worksheet Name\"]\n",
    "\n",
    "            csv_text = archive.read(\n",
    "                item[\"CSV File\"]\n",
    "            ).decode(\"utf-8-sig\")\n",
    "\n",
    "            expected_rows = list(\n",
    "                csv.reader(io.StringIO(csv_text))\n",
    "            )\n",
    "\n",
    "            if name not in actual_names:\n",
    "                results.append({\n",
    "                    \"Worksheet\": name,\n",
    "                    \"Status\": \"MISSING\"\n",
    "                })\n",
    "                continue\n",
    "\n",
    "            actual_rows = (\n",
    "                restored_book.worksheet(name).get_all_values()\n",
    "            )\n",
    "\n",
    "            # Ignore trailing blank cells and rows.\n",
    "            def normalize(rows):\n",
    "                normalized = [\n",
    "                    [str(cell) for cell in row]\n",
    "                    for row in rows\n",
    "                ]\n",
    "\n",
    "                for row in normalized:\n",
    "                    while row and row[-1] == \"\":\n",
    "                        row.pop()\n",
    "\n",
    "                while normalized and not normalized[-1]:\n",
    "                    normalized.pop()\n",
    "\n",
    "                return normalized\n",
    "\n",
    "            matches = (\n",
    "                normalize(expected_rows)\n",
    "                == normalize(actual_rows)\n",
    "            )\n",
    "\n",
    "            results.append({\n",
    "                \"Worksheet\": name,\n",
    "                \"Status\": \"MATCH\" if matches else \"MISMATCH\"\n",
    "            })\n",
    "\n",
    "    display(pd.DataFrame(results))\n",
    "\n",
    "    all_match = (\n",
    "        all(r[\"Status\"] == \"MATCH\" for r in results)\n",
    "        and actual_names == expected_names\n",
    "    )\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 55)\n",
    "\n",
    "    if all_match:\n",
    "        print(\"✓ TEST RESTORE VERIFICATION PASSED\")\n",
    "        print(\"✓ All worksheet names match.\")\n",
    "        print(\"✓ All restored cell values match.\")\n",
    "        print(\"✓ Original CRM remains unchanged.\")\n",
    "    else:\n",
    "        print(\"⚠ TEST RESTORE VERIFICATION FAILED\")\n",
    "        print(\"Review mismatches before relying on recovery.\")\n",
    "\n",
    "    return all_match\n",
    "\n",
    "\n",
    "restore_verified = verify_test_restore(\n",
    "    backup_path=backup_files[0],\n",
    "    restored_workbook_id=test_restore[\"Workbook ID\"]\n",
    ")\n"
   ],
