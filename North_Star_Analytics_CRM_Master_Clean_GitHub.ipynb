    "    df = pd.DataFrame(matches)\n",
    "\n",
    "    df = df.sort_values(\n",
    "        \"Activity Date\",\n",
    "        ascending=False\n",
    "    )\n",
    "\n",
    "    display(df[[\n",
    "        \"Activity ID\",\n",
    "        \"Activity Date\",\n",
    "        \"Activity Type\",\n",
    "        \"Direction\",\n",
    "        \"Outcome\",\n",
    "        \"Notes\",\n",
    "        \"Follow-Up Date\"\n",
    "    ]])\n",
    "\n",
    "    return matches\n",
    "\n",
    "\n",
    "print(\"✓ Communication history system installed!\")\n",
    "print(\"✓ Activity logging enabled!\")\n",
    "print(\"✓ Optional follow-up scheduling enabled!\")\n",
    "print(\"✓ Contact communication history enabled!\")\n"
