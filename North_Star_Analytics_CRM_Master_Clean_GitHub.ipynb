    "# STEP 003 — Create CRM Directory Structure\n",
    "# North Star Analytics CRM folder structure\n",
    "\n",
    "crm_folders = {\n",
    "    \"01_CRM_Database\": \"Master CRM spreadsheets and data\",\n",
    "    \"02_Python_Notebooks\": \"Python scripts and CRM development\",\n",
    "    \"03_Client_Files\": \"Individual client records and documents\",\n",
    "    \"04_Proposals\": \"Client proposals and agreements\",\n",
    "    \"05_Discovery_Forms\": \"Business assessments and questionnaires\",\n",
    "    \"06_Reports\": \"Sales, financial, and performance reports\",\n",
    "    \"07_Templates\": \"Reusable forms and document templates\",\n",
    "    \"08_Backups\": \"CRM database backups\"\n",
    "}\n",
    "\n",
    "# Create folders without overwriting existing files\n",
    "for folder_name, description in crm_folders.items():\n",
    "    folder_path = CRM_ROOT / folder_name\n",
    "    folder_path.mkdir(parents=True, exist_ok=True)\n",
    "    print(f\"✓ {folder_name} — {description}\")\n",
    "\n",
    "print(\"\\nNorth Star Analytics CRM folder structure created!\")\n"
