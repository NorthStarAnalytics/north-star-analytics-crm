    "# STEP 009 — Company Management\n",
    "# Access the Companies worksheet\n",
    "companies_sheet = spreadsheet.worksheet(\"Companies\")\n",
    "\n",
    "def create_company(\n",
    "    company_name,\n",
    "    industry=\"Automotive\",\n",
    "    business_type=\"Automotive Dealership\",\n",
    "    website=\"\",\n",
    "    phone=\"\",\n",
    "    email=\"\",\n",
    "    address=\"\",\n",
    "    city=\"\",\n",
    "    state=\"\",\n",
    "    number_of_locations=1,\n",
    "    company_size=\"\",\n",
    "    lead_source=\"\",\n",
    "    priority=\"Medium\",\n",
    "    tags=None,\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Create a company record in the North Star Analytics CRM.\n",
    "    Automatically generates a unique company ID.\n",
    "    \"\"\"\n",
    "\n",
    "    if not company_name.strip():\n",
    "        raise ValueError(\"Company name is required.\")\n",
    "\n",
    "    company_id = \"NSA-C-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    date_identified = datetime.now().strftime(\"%Y-%m-%d\")\n",
    "\n",
    "    if tags is None:\n",
    "        tags = []\n",
    "\n",
    "    company_record = [\n",
    "        company_id,\n",
    "        company_name,\n",
    "        industry,\n",
    "        business_type,\n",
    "        website,\n",
    "        phone,\n",
    "        email,\n",
    "        address,\n",
    "        city,\n",
    "        state,\n",
    "        number_of_locations,\n",
    "        company_size,\n",
    "        lead_source,\n",
    "        priority,\n",
    "        \", \".join(tags),\n",
    "        date_identified,\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    companies_sheet.append_row(\n",
    "        company_record,\n",
    "        value_input_option=\"USER_ENTERED\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Company successfully added!\")\n",
    "    print(\"Company:\", company_name)\n",
    "    print(\"Company ID:\", company_id)\n",
    "\n",
    "    return company_id\n",
    "\n",
    "\n",
    "print(\"✓ Company creation function installed!\")\n",
    "print(\"✓ Automatic ID generation enabled!\")\n",
    "print(\"✓ Ready to create company records!\")\n"
   ],
