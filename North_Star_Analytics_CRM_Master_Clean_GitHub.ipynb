   "cell_type": "code",
   "source": [
    "# STEP 039 — CRM Backups\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "BACKUP_FOLDER = CRM_ROOT / \"08_Backups\"\n",
    "BACKUP_FOLDER.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "def backup_north_star_crm():\n",
    "    \"\"\"\n",
    "    Back up all Google Sheets CRM worksheets.\n",
    "\n",
    "    Saves:\n",
    "    - One CSV per worksheet\n",
    "    - A JSON backup manifest\n",
    "    - A compressed ZIP archive\n",
    "\n",
    "    Does not modify the live CRM.\n",
    "    \"\"\"\n",
    "\n",
    "    timestamp = datetime.now(\n",
    "        ZoneInfo(\"America/Chicago\")\n",
    "    ).strftime(\"%Y-%m-%d_%H-%M-%S\")\n",
    "\n",
    "    backup_id = uuid4().hex[:8].upper()\n",
    "\n",
    "    filename = (\n",
    "        f\"NSA_CRM_Backup_{timestamp}_{backup_id}.zip\"\n",
    "    )\n",
    "\n",
    "    backup_path = BACKUP_FOLDER / filename\n",
    "\n",
    "    worksheets = spreadsheet.worksheets()\n",
    "\n",
    "    manifest = {\n",
    "        \"Backup ID\": backup_id,\n",
    "        \"Created At\": timestamp,\n",
    "        \"Timezone\": \"America/Chicago\",\n",
    "        \"Spreadsheet ID\": CRM_SPREADSHEET_ID,\n",
    "        \"Worksheet Count\": len(worksheets),\n",
    "        \"Worksheets\": []\n",
    "    }\n",
    "\n",
    "    # Create the archive in memory first so a failed\n",
    "    # backup does not leave a partial ZIP in Drive.\n",
    "    archive_buffer = io.BytesIO()\n",
    "\n",
    "    with zipfile.ZipFile(\n",
    "        archive_buffer,\n",
    "        mode=\"w\",\n",
    "        compression=zipfile.ZIP_DEFLATED\n",
    "    ) as archive:\n",
    "\n",
    "        for index, worksheet in enumerate(\n",
    "            worksheets, start=1\n",
    "        ):\n",
    "\n",
    "            # Read every populated row and column.\n",
    "            data = worksheet.get_all_values()\n",
    "\n",
    "            csv_buffer = io.StringIO(newline=\"\")\n",
    "            writer = csv.writer(csv_buffer)\n",
    "            writer.writerows(data)\n",
    "\n",
    "            csv_bytes = csv_buffer.getvalue().encode(\n",
    "                \"utf-8-sig\"\n",
    "            )\n",
    "\n",
    "            # Use worksheet ID for a stable,\n",
    "            # collision-resistant archive filename.\n",
    "            csv_filename = (\n",
    "                f\"worksheets/\"\n",
    "                f\"{index:02d}_{worksheet.id}.csv\"\n",
    "            )\n",
    "\n",
    "            archive.writestr(\n",
    "                csv_filename,\n",
    "                csv_bytes\n",
    "            )\n",
    "\n",
    "            record_count = max(0, len(data) - 1)\n",
    "\n",
    "            manifest[\"Worksheets\"].append({\n",
    "                \"Worksheet Name\": worksheet.title,\n",
    "                \"Worksheet ID\": worksheet.id,\n",
    "                \"CSV File\": csv_filename,\n",
    "                \"Rows Including Header\": len(data),\n",
    "                \"Data Records\": record_count,\n",
    "                \"Columns\": max(\n",
    "                    (len(row) for row in data),\n",
    "                    default=0\n",
    "                ),\n",
    "                \"SHA256\": hashlib.sha256(\n",
    "                    csv_bytes\n",
    "                ).hexdigest()\n",
    "            })\n",
    "\n",
    "            print(\n",
    "                f\"✓ Backed up: {worksheet.title} \"\n",
    "                f\"({record_count} records)\"\n",
    "            )\n",
    "\n",
    "        archive.writestr(\n",
    "            \"backup_manifest.json\",\n",
    "            json.dumps(\n",
    "                manifest,\n",
    "                indent=2\n",
    "            )\n",
    "        )\n",
    "\n",
    "    # Verify ZIP integrity before saving.\n",
    "    archive_buffer.seek(0)\n",
    "\n",
    "    with zipfile.ZipFile(archive_buffer, \"r\") as check:\n",
    "        bad_file = check.testzip()\n",
    "\n",
    "        if bad_file is not None:\n",
    "            raise RuntimeError(\n",
    "                f\"Backup verification failed: {bad_file}\"\n",
    "            )\n",
    "\n",
    "    # Save verified archive to Google Drive.\n",
    "    backup_path.write_bytes(\n",
    "        archive_buffer.getvalue()\n",
    "    )\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 55)\n",
    "    print(\"NORTH STAR ANALYTICS — CRM BACKUP COMPLETE\")\n",
    "    print(\"=\" * 55)\n",
    "    print(\"Backup ID:\", backup_id)\n",
    "    print(\"Worksheets:\", len(worksheets))\n",
    "    print(\n",
    "        \"Total Data Records:\",\n",
    "        sum(\n",
    "            item[\"Data Records\"]\n",
    "            for item in manifest[\"Worksheets\"]\n",
    "        )\n",
    "    )\n",
    "    print(\"Saved To:\", backup_path)\n",
    "    print(\n",
    "        \"Archive Size:\",\n",
    "        f\"{backup_path.stat().st_size / 1024:.1f} KB\"\n",
    "    )\n",
    "    print(\"\\n✓ Backup ZIP integrity verified.\")\n",
    "    print(\"✓ Live CRM data unchanged.\")\n",
    "\n",
    "    return backup_path\n",
    "\n",
    "\n",
    "print(\"✓ CRM backup system installed!\")\n",
    "print(\"✓ Timestamped ZIP archives enabled!\")\n",
    "print(\"✓ Worksheet manifest enabled!\")\n",
    "print(\"✓ Backup verification enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
