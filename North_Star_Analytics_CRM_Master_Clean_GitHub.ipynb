   "source": [
    "# STEP 011 — Outreach Activity Tracking\n",
    "activities_sheet = spreadsheet.worksheet(\"Activities\")\n",
    "\n",
    "def log_activity(\n",
    "    company_id,\n",
    "    activity_type,\n",
    "    outcome,\n",
    "    contact_id=\"\",\n",
    "    direction=\"Outbound\",\n",
    "    notes=\"\",\n",
    "    next_action=\"\",\n",
    "    follow_up_date=\"\",\n",
    "    activity_date=None\n",
    "):\n",
    "    \"\"\"\n",
    "    Logs outreach activity and updates the contact's\n",
    "    last contact date when a contact ID is provided.\n",
    "    \"\"\"\n",
    "\n",
    "    # Verify company exists\n",
    "    companies = companies_sheet.get_all_records()\n",
    "\n",
    "    if not any(\n",
    "        str(c[\"Company ID\"]) == str(company_id)\n",
    "        for c in companies\n",
    "    ):\n",
    "        raise ValueError(\"Company ID does not exist.\")\n",
    "\n",
    "    # Verify contact belongs to the selected company\n",
    "    if contact_id:\n",
    "        contacts = contacts_sheet.get_all_records()\n",
    "\n",
    "        valid_contact = any(\n",
    "            str(c[\"Contact ID\"]) == str(contact_id)\n",
    "            and str(c[\"Company ID\"]) == str(company_id)\n",
    "            for c in contacts\n",
    "        )\n",
    "\n",
    "        if not valid_contact:\n",
    "            raise ValueError(\n",
    "                \"Contact ID does not belong to this company.\"\n",
    "            )\n",
    "\n",
    "    # Set activity date\n",
    "    if activity_date is None:\n",
    "        activity_date = date.today().isoformat()\n",
    "\n",
    "    activity_id = \"NSA-A-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    activity_record = [\n",
    "        activity_id,\n",
    "        company_id,\n",
    "        contact_id,\n",
    "        activity_date,\n",
    "        activity_type,\n",
    "        direction,\n",
    "        outcome,\n",
    "        notes,\n",
    "        next_action,\n",
    "        follow_up_date\n",
    "    ]\n",
    "\n",
    "    # Save activity\n",
    "    activities_sheet.append_row(\n",
    "        activity_record,\n",
    "        value_input_option=\"USER_ENTERED\"\n",
    "    )\n",
    "\n",
    "    # Update contact's Last Contact Date\n",
    "    if contact_id:\n",
    "        contact_records = contacts_sheet.get_all_records()\n",
    "\n",
    "        for row_number, contact in enumerate(\n",
    "            contact_records, start=2\n",
    "        ):\n",
    "            if str(contact[\"Contact ID\"]) == str(contact_id):\n",
    "                contacts_sheet.update_cell(\n",
    "                    row_number,\n",
    "                    12,\n",
    "                    activity_date\n",
    "                )\n",
    "                break\n",
    "\n",
    "    print(\"✓ Outreach activity recorded!\")\n",
    "    print(\"Activity ID:\", activity_id)\n",
    "    print(\"Activity Type:\", activity_type)\n",
    "    print(\"Outcome:\", outcome)\n",
    "\n",
    "    if follow_up_date:\n",
    "        print(\"Follow-up date:\", follow_up_date)\n",
    "\n",
    "    return activity_id\n",
    "\n",
    "\n",
    "print(\"✓ Outreach tracking system installed!\")\n",
    "print(\"✓ Contact activity history enabled!\")\n",
    "print(\"✓ Last contact date updates enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
