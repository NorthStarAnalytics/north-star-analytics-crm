   "cell_type": "code",
   "source": [
    "# STEP 047 — Opportunity Configuration Audit\n",
    "# North Star Analytics CRM\n",
    "# READ-ONLY\n",
    "\n",
    "\n",
    "def audit_opportunity_configuration():\n",
    "\n",
    "    print(\"=\" * 65)\n",
    "    print(\"NORTH STAR ANALYTICS — OPPORTUNITY AUDIT\")\n",
    "    print(\"=\" * 65)\n",
    "\n",
    "    expected_stages = [\n",
    "        \"Target identified\",\n",
    "        \"First contact attempted\",\n",
    "        \"Stakeholder identified\",\n",
    "        \"Conversation scheduled\",\n",
    "        \"Discovery completed\",\n",
    "        \"Qualified opportunity\",\n",
    "        \"Proposal sent\",\n",
    "        \"Decision pending\",\n",
    "        \"Won\",\n",
    "        \"Lost\",\n",
    "        \"Nurture\",\n",
    "        \"Project active\",\n",
    "        \"Continuing-service opportunity\"\n",
    "    ]\n",
    "\n",
    "    # Verify worksheet headers\n",
    "    ws = spreadsheet.worksheet(\"Opportunities\")\n",
    "    headers = ws.row_values(1)\n",
    "\n",
    "    required_headers = [\n",
    "        \"Opportunity ID\",\n",
    "        \"Company ID\",\n",
    "        \"Contact ID\",\n",
    "        \"Opportunity Name\",\n",
    "        \"Service Interest\",\n",
    "        \"Pipeline Stage\",\n",
    "        \"Outcome\",\n",
    "        \"Estimated Value\",\n",
    "        \"Probability\",\n",
    "        \"Weighted Value\",\n",
    "        \"Opportunity Score\"\n",
    "    ]\n",
    "\n",
    "    missing_headers = [\n",
    "        h for h in required_headers\n",
    "        if h not in headers\n",
    "    ]\n",
    "\n",
    "    print(\"\\nWORKSHEET STRUCTURE\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    if missing_headers:\n",
    "        print(\"Missing headers:\", missing_headers)\n",
    "    else:\n",
    "        print(\"✓ All required opportunity headers exist.\")\n",
    "\n",
    "    # Inspect pipeline stage configuration\n",
    "    print(\"\\nPIPELINE STAGES\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    stage_rows = [\n",
    "        {\"Stage\": stage, \"Expected Order\": i}\n",
    "        for i, stage in enumerate(expected_stages, 1)\n",
    "    ]\n",
    "\n",
    "    display(pd.DataFrame(stage_rows))\n",
    "\n",
    "    # Inspect Python functions\n",
    "    print(\"\\nOPPORTUNITY FUNCTIONS\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    function_names = [\n",
    "        \"create_opportunity\",\n",
    "        \"update_opportunity_stage\",\n",
    "        \"score_opportunity\",\n",
    "        \"show_priority_opportunities\"\n",
    "    ]\n",
    "\n",
    "    function_results = {}\n",
    "\n",
    "    for name in function_names:\n",
    "\n",
    "        function = globals().get(name)\n",
    "\n",
    "        available = callable(function)\n",
    "        function_results[name] = available\n",
    "\n",
    "        print(\n",
    "            f\"{'✓' if available else '⚠'} {name}: \"\n",
    "            f\"{'Available' if available else 'Missing'}\"\n",
    "        )\n",
    "\n",
    "        if available:\n",
    "            try:\n",
    "                print(\"   Parameters:\", inspect.signature(function))\n",
    "            except (TypeError, ValueError):\n",
    "                print(\"   Parameters: unavailable\")\n",
    "\n",
    "    # Inspect existing opportunities\n",
    "    print(\"\\nEXISTING OPPORTUNITIES\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    records = ws.get_all_records()\n",
    "\n",
    "    print(\"Current opportunity records:\", len(records))\n",
    "\n",
    "    if records:\n",
    "        display(pd.DataFrame(records)[[\n",
    "            \"Opportunity ID\",\n",
    "            \"Company ID\",\n",
