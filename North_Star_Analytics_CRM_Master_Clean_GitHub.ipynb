    "# STEP 004 — Authenticate and Create CRM Workbook\n",
    "# Install Google Sheets integration\n",
    "# Authenticate with Google Sheets\n",
    "auth.authenticate_user()\n",
    "credentials, _ = default()\n",
    "gc = gspread.authorize(credentials)\n",
    "\n",
    "# Master CRM workbook name\n",
    "CRM_WORKBOOK_NAME = \"North Star Analytics - Master CRM\"\n",
    "\n",
    "# Define the 14 CRM tabs\n",
    "crm_tabs = [\n",
    "    \"Dashboard\",\n",
    "    \"Companies\",\n",
    "    \"Contacts\",\n",
    "    \"Activities\",\n",
    "    \"Opportunities\",\n",
    "    \"Follow-Ups\",\n",
    "    \"Discovery\",\n",
    "    \"Proposals\",\n",
    "    \"Projects\",\n",
    "    \"Project Tasks\",\n",
    "    \"Continuing Services\",\n",
    "    \"Financials\",\n",
    "    \"Tags\",\n",
    "    \"Settings\"\n",
    "]\n",
    "\n",
    "# Create the master spreadsheet\n",
    "if CRM_SPREADSHEET_ID != \"INSERT SPREADSHEET ID HERE\":\n",
    "    raise ValueError(\n",
    "        \"This step creates a NEW workbook. To prevent duplicate creation, \"\n",
    "        \"leave the ID placeholder unchanged for initial setup. \"\n",
    "        \"For an existing workbook, use a separately configured connection workflow.\"\n",
    "    )\n",
    "spreadsheet = gc.create(CRM_WORKBOOK_NAME)\n",
    "CRM_SPREADSHEET_ID = spreadsheet.id\n",
    "\n",
    "# Rename the default worksheet\n",
    "first_sheet = spreadsheet.sheet1\n",
    "first_sheet.update_title(crm_tabs[0])\n",
    "\n",
    "# Create remaining worksheets\n",
    "for tab_name in crm_tabs[1:]:\n",
    "    spreadsheet.add_worksheet(\n",
    "        title=tab_name,\n",
    "        rows=1000,\n",
    "        cols=30\n",
    "    )\n",
    "    print(f\"✓ Created: {tab_name}\")\n",
    "\n",
    "print(\"\\nMaster CRM workbook created successfully!\")\n",
    "print(\"Spreadsheet URL:\", spreadsheet.url)\n"
   ],
