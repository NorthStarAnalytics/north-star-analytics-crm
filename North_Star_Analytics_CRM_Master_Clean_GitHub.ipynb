   "source": [
    "# STEP 038 — Excel Reporting\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "REPORT_FOLDER = CRM_ROOT / \"06_Reports\"\n",
    "REPORT_FOLDER.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "def export_daily_crm_report():\n",
    "    \"\"\"\n",
    "    Export a dated CRM report to Google Drive.\n",
    "\n",
    "    Creates a multi-sheet Excel workbook.\n",
    "    Does not modify CRM data.\n",
    "    \"\"\"\n",
    "\n",
    "    today = crm_today()\n",
    "    today_text = today.isoformat()\n",
    "\n",
    "    companies = companies_sheet.get_all_records()\n",
    "    contacts = contacts_sheet.get_all_records()\n",
    "    activities = activities_sheet.get_all_records()\n",
    "    tasks = followups_sheet.get_all_records()\n",
    "    opportunities = opportunities_sheet.get_all_records()\n",
    "    goals = outreach_goals_sheet.get_all_records()\n",
    "\n",
    "    company_lookup = {\n",
    "        str(c[\"Company ID\"]): str(c[\"Company Name\"])\n",
    "        for c in companies\n",
    "    }\n",
    "\n",
    "    # -----------------------------------------\n",
    "    # Outreach progress\n",
    "    # -----------------------------------------\n",
    "\n",
    "    today_outreach = [\n",
    "        a for a in activities\n",
    "        if str(a[\"Activity Date\"])[:10] == today_text\n",
    "        and str(a[\"Direction\"]).strip().lower() == \"outbound\"\n",
    "    ]\n",
    "\n",
    "    outreach_rows = []\n",
    "\n",
    "    for goal in goals:\n",
    "\n",
    "        if str(goal[\"Active\"]).strip().lower() not in [\n",
    "            \"yes\", \"true\", \"active\"\n",
    "        ]:\n",
    "            continue\n",
    "\n",
    "        activity_type = str(goal[\"Activity Type\"]).strip()\n",
    "\n",
    "        try:\n",
    "            daily_goal = int(float(goal[\"Daily Goal\"]))\n",
    "        except (ValueError, TypeError):\n",
    "            daily_goal = 0\n",
    "\n",
    "        completed = sum(\n",
    "            1 for a in today_outreach\n",
    "            if str(a[\"Activity Type\"]).strip().lower()\n",
    "            == activity_type.lower()\n",
    "            and str(a[\"Outcome\"]).strip().lower()\n",
    "            not in [\"draft\", \"planned\", \"not sent\", \"cancelled\"]\n",
    "        )\n",
    "\n",
    "        outreach_rows.append({\n",
    "            \"Activity Type\": activity_type,\n",
    "            \"Daily Goal\": daily_goal,\n",
    "            \"Completed\": completed,\n",
    "            \"Remaining\": max(0, daily_goal - completed)\n",
    "        })\n",
    "\n",
    "    # -----------------------------------------\n",
    "    # Follow-up tasks\n",
    "    # -----------------------------------------\n",
    "\n",
    "    overdue_rows = []\n",
    "    upcoming_rows = []\n",
    "\n",
    "    for task in tasks:\n",
    "\n",
    "        status = str(task[\"Status\"]).strip().lower()\n",
    "\n",
    "        if status in [\"completed\", \"cancelled\", \"canceled\"]:\n",
    "            continue\n",
    "\n",
    "        due_text = str(task[\"Due Date\"]).strip()\n",
    "\n",
    "        try:\n",
    "            due_date = date.fromisoformat(due_text[:10])\n",
    "        except ValueError:\n",
    "            continue\n",
    "\n",
    "        row = {\n",
    "            \"Task ID\": task[\"Task ID\"],\n",
    "            \"Company\": company_lookup.get(\n",
    "                str(task[\"Company ID\"]),\n",
    "                str(task[\"Company ID\"])\n",
    "            ),\n",
    "            \"Task\": task[\"Task Description\"],\n",
    "            \"Priority\": task[\"Priority\"],\n",
    "            \"Due Date\": due_text,\n",
    "            \"Status\": task[\"Status\"]\n",
    "        }\n",
    "\n",
    "        if due_date <= today:\n",
    "            overdue_rows.append(row)\n",
    "\n",
    "        elif due_date <= today + timedelta(days=7):\n",
    "            upcoming_rows.append(row)\n",
    "\n",
    "    # -----------------------------------------\n",
    "    # Priority opportunities\n",
    "    # -----------------------------------------\n",
    "\n",
    "    opportunity_rows = []\n",
    "\n",
    "    for opportunity in opportunities:\n",
    "\n",
    "        if str(opportunity[\"Pipeline Stage\"]).strip().lower() in [\n",
    "            \"won\", \"lost\"\n",
    "        ]:\n",
    "            continue\n",
    "\n",
    "        if str(opportunity[\"Outcome\"]).strip().lower() in [\n",
    "            \"won\", \"lost\"\n",
    "        ]:\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "            score = float(opportunity[\"Opportunity Score\"])\n",
    "        except (ValueError, TypeError):\n",
    "            score = 0\n",
    "\n",
    "        opportunity_rows.append({\n",
    "            \"Opportunity ID\": opportunity[\"Opportunity ID\"],\n",
    "            \"Company\": company_lookup.get(\n",
    "                str(opportunity[\"Company ID\"]),\n",
    "                str(opportunity[\"Company ID\"])\n",
    "            ),\n",
    "            \"Opportunity\": opportunity[\"Opportunity Name\"],\n",
    "            \"Pipeline Stage\": opportunity[\"Pipeline Stage\"],\n",
    "            \"Score\": score,\n",
    "            \"Estimated Value\": opportunity[\"Estimated Value\"]\n",
    "        })\n",
    "\n",
    "    opportunity_rows.sort(\n",
    "        key=lambda x: x[\"Score\"],\n",
    "        reverse=True\n",
    "    )\n",
    "\n",
    "    # -----------------------------------------\n",
    "    # Recent communications\n",
    "    # -----------------------------------------\n",
    "\n",
    "    recent_rows = []\n",
    "\n",
    "    recent_activities = sorted(\n",
    "        activities,\n",
    "        key=lambda a: str(a[\"Activity Date\"]),\n",
    "        reverse=True\n",
    "    )[:20]\n",
    "\n",
    "    for activity in recent_activities:\n",
    "\n",
    "        recent_rows.append({\n",
    "            \"Activity ID\": activity[\"Activity ID\"],\n",
    "            \"Date\": activity[\"Activity Date\"],\n",
    "            \"Company\": company_lookup.get(\n",
    "                str(activity[\"Company ID\"]),\n",
    "                str(activity[\"Company ID\"])\n",
    "            ),\n",
    "            \"Activity Type\": activity[\"Activity Type\"],\n",
    "            \"Direction\": activity[\"Direction\"],\n",
    "            \"Outcome\": activity[\"Outcome\"],\n",
    "            \"Next Action\": activity[\"Next Action\"]\n",
    "        })\n",
    "\n",
    "    # -----------------------------------------\n",
    "    # Executive summary\n",
    "    # -----------------------------------------\n",
    "\n",
    "    summary_rows = [\n",
    "        [\"Report Date\", today_text],\n",
    "        [\"Total Companies\", len(companies)],\n",
    "        [\"Total Contacts\", len(contacts)],\n",
    "        [\"Open Follow-Up Tasks\",\n",
    "         sum(\n",
    "             str(t[\"Status\"]).strip().lower()\n",
    "             not in [\"completed\", \"cancelled\", \"canceled\"]\n",
    "             for t in tasks\n",
    "         )],\n",
    "        [\"Due or Overdue Follow-Ups\", len(overdue_rows)],\n",
    "        [\"Upcoming Follow-Ups\", len(upcoming_rows)],\n",
    "        [\"Open Opportunities\", len(opportunity_rows)],\n",
    "        [\"Recorded Outbound Activities Today\",\n",
    "         len(today_outreach)]\n",
    "    ]\n",
    "\n",
    "    filename = (\n",
    "        f\"North_Star_Analytics_Daily_CRM_\"\n",
    "        f\"{today_text}.xlsx\"\n",
    "    )\n",
    "\n",
    "    filepath = REPORT_FOLDER / filename\n",
    "\n",
    "    # Write all sections into one workbook\n",
    "    with pd.ExcelWriter(\n",
    "        filepath,\n",
    "        engine=\"openpyxl\"\n",
    "    ) as writer:\n",
    "\n",
    "        pd.DataFrame(\n",
    "            summary_rows,\n",
    "            columns=[\"Metric\", \"Value\"]\n",
    "        ).to_excel(\n",
    "            writer,\n",
    "            sheet_name=\"Summary\",\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "        pd.DataFrame(outreach_rows).to_excel(\n",
    "            writer,\n",
    "            sheet_name=\"Outreach Goals\",\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "        pd.DataFrame(overdue_rows).to_excel(\n",
    "            writer,\n",
    "            sheet_name=\"Due Follow-Ups\",\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "        pd.DataFrame(upcoming_rows).to_excel(\n",
    "            writer,\n",
    "            sheet_name=\"Upcoming Follow-Ups\",\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "        pd.DataFrame(opportunity_rows).to_excel(\n",
    "            writer,\n",
    "            sheet_name=\"Opportunities\",\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "        pd.DataFrame(recent_rows).to_excel(\n",
    "            writer,\n",
    "            sheet_name=\"Recent Activities\",\n",
    "            index=False\n",
    "        )\n",
    "\n",
    "    print(\"\\n✓ Daily CRM report exported!\")\n",
    "    print(\"Report Date:\", today_text)\n",
    "    print(\"Saved to:\", filepath)\n",
    "    print(\"Worksheets: 6\")\n",
    "    print(\"\\nYour CRM data was not modified.\")\n",
    "\n",
    "    return filepath\n",
    "\n",
    "\n",
