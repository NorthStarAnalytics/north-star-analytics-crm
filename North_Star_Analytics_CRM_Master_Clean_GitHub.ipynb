    "# STEP 007 — Configure Tags and Settings\n",
    "# 1. Standardized CRM tags\n",
    "tag_categories = {\n",
    "    \"Business Type\": [\n",
    "        \"Automotive Dealership\", \"Dealer Group\",\n",
    "        \"Independent Business\", \"Multi-Location\",\n",
    "        \"Service Business\", \"Retail\", \"Nonprofit\"\n",
    "    ],\n",
    "    \"Decision-Maker\": [\n",
    "        \"Owner\", \"General Manager\", \"Dealer Principal\",\n",
    "        \"Fixed Operations Director\", \"Sales Manager\",\n",
    "        \"Finance Director\", \"Operations Manager\",\n",
    "        \"Marketing Director\", \"Gatekeeper\"\n",
    "    ],\n",
    "    \"Business Needs\": [\n",
    "        \"Process Bottlenecks\", \"Sales Performance\",\n",
    "        \"Employee Productivity\", \"KPI Reporting\",\n",
    "        \"Data Quality\", \"Workflow Automation\",\n",
    "        \"Customer Retention\", \"Inventory Management\",\n",
    "        \"Training Gaps\", \"Dashboard Development\"\n",
    "    ],\n",
    "    \"Sales Priority\": [\n",
    "        \"Hot Lead\", \"Warm Lead\", \"Cold Lead\",\n",
    "        \"High-Value Opportunity\", \"Budget Confirmed\",\n",
    "        \"Decision-Maker Engaged\", \"Needs Follow-Up\",\n",
    "        \"Not Ready\", \"Referral Source\"\n",
    "    ],\n",
    "    \"Services\": [\n",
    "        \"Business Performance Checkup\",\n",
    "        \"Process Improvement\",\n",
    "        \"Monthly KPI Reporting\",\n",
    "        \"Dashboard Maintenance\",\n",
    "        \"Data Quality Monitoring\",\n",
    "        \"Employee Training\",\n",
    "        \"Implementation Support\",\n",
    "        \"Full Partnership\",\n",
    "        \"Quarterly Review\"\n",
    "    ]\n",
    "}\n",
    "\n",
    "tags_sheet = spreadsheet.worksheet(\"Tags\")\n",
    "existing_tags = {\n",
    "    (row[1], row[2])\n",
    "    for row in tags_sheet.get_all_values()[1:]\n",
    "    if len(row) >= 3\n",
    "}\n",
    "\n",
    "new_tags = []\n",
    "\n",
    "for category, tags in tag_categories.items():\n",
    "    for tag in tags:\n",
    "        if (category, tag) not in existing_tags:\n",
    "            new_tags.append([\n",
    "                f\"TAG-{len(existing_tags) + len(new_tags) + 1:04d}\",\n",
    "                category,\n",
    "                tag,\n",
    "                \"\",\n",
    "                \"Yes\"\n",
    "            ])\n",
    "\n",
    "if new_tags:\n",
    "    tags_sheet.append_rows(new_tags)\n",
    "\n",
    "print(f\"✓ Added {len(new_tags)} CRM tags\")\n",
    "\n",
    "\n",
    "# 2. Define your sales pipeline stages\n",
    "pipeline_stages = [\n",
    "    \"Target identified\",\n",
    "    \"First contact attempted\",\n",
    "    \"Stakeholder identified\",\n",
    "    \"Conversation scheduled\",\n",
    "    \"Discovery completed\",\n",
    "    \"Qualified opportunity\",\n",
    "    \"Proposal sent\",\n",
    "    \"Decision pending\",\n",
    "    \"Won\",\n",
    "    \"Lost\",\n",
    "    \"Nurture\",\n",
    "    \"Project active\",\n",
    "    \"Continuing-service opportunity\"\n",
    "]\n",
    "\n",
    "# 3. Define standard activity types\n",
    "activity_types = [\n",
    "    \"Phone Call\", \"Email\", \"LinkedIn\",\n",
    "    \"In-Person Visit\", \"Video Meeting\",\n",
    "    \"Referral\", \"Follow-Up\", \"Other\"\n",
    "]\n",
    "\n",
    "# 4. Define task statuses\n",
    "task_statuses = [\n",
    "    \"Not Started\", \"In Progress\",\n",
    "    \"Waiting\", \"Completed\", \"Cancelled\"\n",
    "]\n",
    "\n",
    "# 5. Define opportunity scoring criteria\n",
    "scoring_criteria = {\n",
    "    \"Business Need\": 25,\n",
    "    \"Decision-Maker Access\": 20,\n",
    "    \"Budget Readiness\": 20,\n",
    "    \"Timeline Urgency\": 15,\n",
    "    \"Engagement Level\": 10,\n",
    "    \"Service Fit\": 10\n",
    "}\n",
    "\n",
    "# 6. Prepare settings records\n",
    "settings_data = []\n",
    "\n",
    "for order, stage in enumerate(pipeline_stages, start=1):\n",
    "    settings_data.append([\n",
    "        \"Pipeline Stage\", stage, str(order),\n",
    "        \"CRM lifecycle stage or outcome\"\n",
    "    ])\n",
    "\n",
    "for activity in activity_types:\n",
    "    settings_data.append([\n",
    "        \"Activity Type\", activity, \"Active\",\n",
    "        \"Approved outreach activity\"\n",
    "    ])\n",
    "\n",
    "for status in task_statuses:\n",
    "    settings_data.append([\n",
    "        \"Task Status\", status, \"Active\",\n",
    "        \"Task tracking status\"\n",
    "    ])\n",
    "\n",
    "for criterion, weight in scoring_criteria.items():\n",
    "    settings_data.append([\n",
    "        \"Opportunity Scoring\", criterion, str(weight),\n",
    "        \"Maximum points toward a 100-point score\"\n",
    "    ])\n",
    "\n",
    "# Add settings without duplicating existing records\n",
    "settings_sheet = spreadsheet.worksheet(\"Settings\")\n",
    "\n",
    "existing_settings = {\n",
    "    (row[0], row[1])\n",
    "    for row in settings_sheet.get_all_values()[1:]\n",
    "    if len(row) >= 2\n",
    "}\n",
    "\n",
    "new_settings = [\n",
    "    row for row in settings_data\n",
    "    if (row[0], row[1]) not in existing_settings\n",
    "]\n",
    "\n",
    "if new_settings:\n",
    "    settings_sheet.append_rows(new_settings)\n",
    "\n",
    "print(f\"✓ Added {len(new_settings)} CRM settings\")\n",
    "print(\"✓ Pipeline stages configured\")\n",
    "print(\"✓ Outreach activity types configured\")\n",
    "print(\"✓ Task statuses configured\")\n",
    "print(\"✓ Opportunity scoring weights configured\")\n",
    "\n",
    "print(\"\\nNorth Star Analytics CRM configuration complete!\")\n",
    "\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
