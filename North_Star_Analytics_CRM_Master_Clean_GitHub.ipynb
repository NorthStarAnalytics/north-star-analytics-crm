   "cell_type": "code",
   "source": [
    "# STEP 040 — Backup Inspection\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "\n",
    "def list_crm_backups():\n",
    "    \"\"\"List available CRM backup archives.\"\"\"\n",
    "\n",
    "    backups = sorted(\n",
    "        BACKUP_FOLDER.glob(\"NSA_CRM_Backup_*.zip\"),\n",
    "        key=lambda p: p.stat().st_mtime,\n",
    "        reverse=True\n",
    "    )\n",
    "\n",
    "    if not backups:\n",
    "        print(\"No CRM backups found.\")\n",
    "        return []\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for backup in backups:\n",
    "        rows.append({\n",
    "            \"Backup File\": backup.name,\n",
    "            \"Size (KB)\": round(\n",
    "                backup.stat().st_size / 1024, 1\n",
    "            )\n",
    "        })\n",
    "\n",
    "    display(pd.DataFrame(rows))\n",
    "\n",
    "    return backups\n",
    "\n",
    "\n",
    "def inspect_crm_backup(backup_path):\n",
    "    \"\"\"\n",
    "    Inspect and verify a backup without restoring it.\n",
    "\n",
    "    Checks:\n",
    "    - ZIP archive integrity\n",
    "    - Manifest presence and structure\n",
    "    - All expected worksheet CSV files\n",
    "    - SHA256 file checksums\n",
    "    - CSV row counts\n",
    "    \"\"\"\n",
    "\n",
    "    backup_path = Path(backup_path)\n",
    "\n",
    "    if not backup_path.is_file():\n",
    "        raise FileNotFoundError(\n",
    "            f\"Backup not found: {backup_path}\"\n",
    "        )\n",
    "\n",
    "    print(\"=\" * 60)\n",
    "    print(\"NORTH STAR ANALYTICS — BACKUP VERIFICATION\")\n",
    "    print(\"=\" * 60)\n",
    "    print(\"Archive:\", backup_path.name)\n",
    "\n",
    "    results = []\n",
    "    all_valid = True\n",
    "\n",
    "    with zipfile.ZipFile(backup_path, \"r\") as archive:\n",
    "\n",
    "        bad_file = archive.testzip()\n",
    "\n",
    "        if bad_file is not None:\n",
    "            raise RuntimeError(\n",
    "                f\"ZIP integrity failure: {bad_file}\"\n",
    "            )\n",
    "\n",
    "        if \"backup_manifest.json\" not in archive.namelist():\n",
    "            raise ValueError(\n",
    "                \"Backup manifest is missing.\"\n",
    "            )\n",
    "\n",
    "        manifest = json.loads(\n",
    "            archive.read(\"backup_manifest.json\")\n",
    "        )\n",
    "\n",
    "        worksheets = manifest.get(\"Worksheets\")\n",
    "\n",
    "        if not isinstance(worksheets, list):\n",
    "            raise ValueError(\n",
    "                \"Invalid backup manifest.\"\n",
    "            )\n",
    "\n",
    "        for sheet in worksheets:\n",
    "\n",
    "            name = sheet[\"Worksheet Name\"]\n",
    "            csv_file = sheet[\"CSV File\"]\n",
    "\n",
    "            if csv_file not in archive.namelist():\n",
    "                results.append({\n",
    "                    \"Worksheet\": name,\n",
    "                    \"Records\": 0,\n",
    "                    \"Status\": \"MISSING\"\n",
    "                })\n",
    "                all_valid = False\n",
    "                continue\n",
    "\n",
    "            csv_bytes = archive.read(csv_file)\n",
    "\n",
    "            actual_hash = hashlib.sha256(\n",
    "                csv_bytes\n",
    "            ).hexdigest()\n",
    "\n",
    "            expected_hash = sheet[\"SHA256\"]\n",
    "\n",
    "            hash_valid = actual_hash == expected_hash\n",
    "\n",
    "            csv_text = csv_bytes.decode(\"utf-8-sig\")\n",
    "\n",
    "            rows = list(\n",
    "                csv.reader(io.StringIO(csv_text))\n",
    "            )\n",
    "\n",
    "            actual_count = max(0, len(rows) - 1)\n",
    "            expected_count = sheet[\"Data Records\"]\n",
    "\n",
    "            count_valid = actual_count == expected_count\n",
    "\n",
    "            valid = hash_valid and count_valid\n",
    "\n",
    "            if not valid:\n",
    "                all_valid = False\n",
    "\n",
    "            results.append({\n",
    "                \"Worksheet\": name,\n",
    "                \"Records\": actual_count,\n",
    "                \"Status\": (\n",
    "                    \"VERIFIED\" if valid else \"FAILED\"\n",
    "                )\n",
    "            })\n",
    "\n",
    "    display(pd.DataFrame(results))\n",
    "\n",
    "    print(\"\\nBackup ID:\", manifest.get(\"Backup ID\"))\n",
    "    print(\"Created:\", manifest.get(\"Created At\"))\n",
    "    print(\"Worksheets Checked:\", len(results))\n",
    "\n",
    "    if len(results) != manifest.get(\"Worksheet Count\"):\n",
    "        all_valid = False\n",
    "        print(\"⚠ Worksheet count mismatch.\")\n",
    "\n",
    "    if all_valid:\n",
    "        print(\"\\n✓ BACKUP VERIFICATION PASSED\")\n",
    "        print(\"✓ All worksheet files verified.\")\n",
    "        print(\"✓ All checksums match.\")\n",
    "        print(\"✓ All record counts match.\")\n",
    "        print(\"✓ Live CRM remains unchanged.\")\n",
    "    else:\n",
    "        print(\"\\n⚠ BACKUP VERIFICATION FAILED\")\n",
    "        print(\"Do not use this archive for recovery.\")\n",
    "\n",
    "    return {\n",
    "        \"Valid\": all_valid,\n",
    "        \"Manifest\": manifest,\n",
    "        \"Worksheets\": results,\n",
    "        \"Backup Path\": str(backup_path)\n",
    "    }\n",
    "\n",
    "\n",
    "print(\"✓ Backup inspection system installed!\")\n",
    "print(\"✓ Archive integrity checking enabled!\")\n",
    "print(\"✓ Worksheet checksum verification enabled!\")\n",
    "print(\"✓ Record count verification enabled!\")\n",
    "print(\"✓ Read-only recovery inspection enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
