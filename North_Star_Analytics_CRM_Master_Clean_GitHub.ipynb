    "# STEP 035 — Personalized Client Communications\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "def generate_client_message(\n",
    "    template_id,\n",
    "    company_id,\n",
    "    contact_id,\n",
    "    meeting_details=\"\",\n",
    "    requested_data=\"\",\n",
    "    next_steps=\"\",\n",
    "    additional_fields=None\n",
    "):\n",
    "    \"\"\"\n",
    "    Personalize an existing communication template\n",
    "    using company and contact information.\n",
    "\n",
    "    Returns a draft. Does not send messages or\n",
    "    modify CRM records.\n",
    "    \"\"\"\n",
    "\n",
    "    templates = template_sheet.get_all_records()\n",
    "    companies = companies_sheet.get_all_records()\n",
    "    contacts = contacts_sheet.get_all_records()\n",
    "\n",
    "    # Find template\n",
    "    template = next(\n",
    "        (\n",
    "            t for t in templates\n",
    "            if str(t[\"Template ID\"]) == str(template_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if template is None:\n",
    "        raise ValueError(\"Template ID not found.\")\n",
    "\n",
    "    if str(template[\"Active\"]).strip().lower() not in [\n",
    "        \"yes\", \"true\", \"active\"\n",
    "    ]:\n",
    "        raise ValueError(\"This communication template is inactive.\")\n",
    "\n",
    "    # Find company\n",
    "    company = next(\n",
    "        (\n",
    "            c for c in companies\n",
    "            if str(c[\"Company ID\"]) == str(company_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if company is None:\n",
    "        raise ValueError(\"Company ID not found.\")\n",
    "\n",
    "    # Find contact\n",
    "    contact = next(\n",
    "        (\n",
    "            c for c in contacts\n",
    "            if str(c[\"Contact ID\"]) == str(contact_id)\n",
    "            and str(c[\"Company ID\"]) == str(company_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if contact is None:\n",
    "        raise ValueError(\n",
    "            \"Contact ID not found for the selected company.\"\n",
    "        )\n",
    "\n",
    "    fields = {\n",
    "        \"first_name\": str(contact[\"First Name\"]).strip(),\n",
    "        \"last_name\": str(contact[\"Last Name\"]).strip(),\n",
    "        \"company_name\": str(company[\"Company Name\"]).strip(),\n",
    "        \"contact_title\": str(contact[\"Job Title\"]).strip(),\n",
    "        \"meeting_details\": str(meeting_details).strip(),\n",
    "        \"requested_data\": str(requested_data).strip(),\n",
    "        \"next_steps\": str(next_steps).strip()\n",
    "    }\n",
    "\n",
    "    # Allow additional custom placeholder values\n",
    "    if additional_fields is not None:\n",
    "        if not isinstance(additional_fields, dict):\n",
    "            raise ValueError(\"additional_fields must be a dictionary.\")\n",
    "\n",
    "        for key, value in additional_fields.items():\n",
    "            if key not in fields:\n",
    "                fields[key] = str(value).strip()\n",
    "\n",
    "    subject_template = str(template[\"Subject\"])\n",
    "    message_template = str(template[\"Message\"])\n",
    "\n",
    "    # Identify required placeholders\n",
    "    formatter = Formatter()\n",
    "\n",
    "    required_fields = set()\n",
    "\n",
    "    for text_value in [subject_template, message_template]:\n",
    "        for _, field_name, _, _ in formatter.parse(text_value):\n",
    "            if field_name:\n",
    "                required_fields.add(field_name)\n",
    "\n",
    "    missing = [\n",
    "        field_name\n",
    "        for field_name in sorted(required_fields)\n",
    "        if field_name not in fields\n",
    "        or not fields[field_name]\n",
    "    ]\n",
    "\n",
    "    if missing:\n",
    "        raise ValueError(\n",
    "            \"Missing information for template: \"\n",
    "            + \", \".join(missing)\n",
    "        )\n",
    "\n",
    "    # Fill placeholders\n",
    "    subject = subject_template.format_map(fields)\n",
    "    message = message_template.format_map(fields)\n",
    "\n",
    "    result = {\n",
    "        \"Template ID\": template_id,\n",
    "        \"Company ID\": company_id,\n",
    "        \"Contact ID\": contact_id,\n",
    "        \"Recipient Name\": (\n",
    "            fields[\"first_name\"] + \" \" + fields[\"last_name\"]\n",
    "        ).strip(),\n",
    "        \"Recipient Email\": str(contact[\"Email\"]).strip(),\n",
    "        \"Subject\": subject,\n",
    "        \"Message\": message,\n",
    "        \"Recommended Timing\": template[\"Recommended Timing\"]\n",
    "    }\n",
    "\n",
    "    print(\"\\nNORTH STAR ANALYTICS\")\n",
    "    print(\"PERSONALIZED CLIENT MESSAGE\")\n",
    "    print(\"-\" * 55)\n",
    "    print(\"To:\", result[\"Recipient Name\"])\n",
    "    print(\"Email:\", result[\"Recipient Email\"])\n",
    "    print(\"Subject:\", subject)\n",
    "    print(\"-\" * 55)\n",
    "    print(message)\n",
    "    print(\"-\" * 55)\n",
    "    print(\"Recommended Timing:\", result[\"Recommended Timing\"])\n",
    "    print(\"\\n✓ Personalized draft generated!\")\n",
    "    print(\"No message was sent or logged.\")\n",
    "\n",
    "    return result\n",
    "\n",
    "\n",
    "print(\"✓ Personalized communication generator installed!\")\n",
    "print(\"✓ Company and contact lookup enabled!\")\n",
    "print(\"✓ Template placeholders supported!\")\n",
    "print(\"✓ Missing-information validation enabled!\")\n",
    "print(\"✓ Draft-only safety controls enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
