   "source": [
    "# STEP 037 — Daily Outreach Command Center\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "def north_star_daily_command_center():\n",
    "    \"\"\"\n",
    "    Display daily CRM priorities and outreach progress.\n",
    "\n",
    "    Read-only: does not create or modify records.\n",
    "    \"\"\"\n",
    "\n",
    "    today = crm_today()\n",
    "    today_text = today.isoformat()\n",
    "\n",
    "    companies = companies_sheet.get_all_records()\n",
    "    contacts = contacts_sheet.get_all_records()\n",
    "    activities = activities_sheet.get_all_records()\n",
    "    tasks = followups_sheet.get_all_records()\n",
    "    opportunities = opportunities_sheet.get_all_records()\n",
    "    goals = outreach_goals_sheet.get_all_records()\n",
    "\n",
    "    company_lookup = {\n",
    "        str(c[\"Company ID\"]): str(c[\"Company Name\"])\n",
    "        for c in companies\n",
    "    }\n",
    "\n",
    "    print(\"=\" * 65)\n",
    "    print(\"NORTH STAR ANALYTICS\")\n",
    "    print(\"DAILY OUTREACH COMMAND CENTER\")\n",
    "    print(\"Date:\", today_text)\n",
    "    print(\"=\" * 65)\n",
    "\n",
    "    # -------------------------------------------------\n",
    "    # 1. CRM OVERVIEW\n",
    "    # -------------------------------------------------\n",
    "\n",
    "    open_tasks = [\n",
    "        task for task in tasks\n",
    "        if str(task[\"Status\"]).strip().lower()\n",
    "        not in [\"completed\", \"cancelled\", \"canceled\"]\n",
    "    ]\n",
    "\n",
    "    open_opportunities = [\n",
    "        opportunity for opportunity in opportunities\n",
    "        if str(opportunity[\"Pipeline Stage\"]).strip().lower()\n",
    "        not in [\"won\", \"lost\"]\n",
    "        and str(opportunity[\"Outcome\"]).strip().lower()\n",
    "        not in [\"won\", \"lost\"]\n",
    "    ]\n",
    "\n",
    "    print(\"\\nCRM OVERVIEW\")\n",
    "    print(\"-\" * 65)\n",
    "    print(\"Companies:\", len(companies))\n",
    "    print(\"Contacts:\", len(contacts))\n",
    "    print(\"Open Opportunities:\", len(open_opportunities))\n",
    "    print(\"Open Tasks:\", len(open_tasks))\n",
    "\n",
    "    # -------------------------------------------------\n",
    "    # 2. TODAY'S OUTREACH GOALS\n",
    "    # -------------------------------------------------\n",
    "\n",
    "    today_activities = [\n",
    "        activity for activity in activities\n",
    "        if str(activity[\"Activity Date\"])[:10] == today_text\n",
    "        and str(activity[\"Direction\"]).strip().lower()\n",
    "        == \"outbound\"\n",
    "    ]\n",
    "\n",
    "    print(\"\\nTODAY'S OUTREACH GOALS\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    outreach_rows = []\n",
    "\n",
    "    for goal in goals:\n",
    "\n",
    "        if str(goal[\"Active\"]).strip().lower() not in [\n",
    "            \"yes\", \"true\", \"active\"\n",
    "        ]:\n",
    "            continue\n",
    "\n",
    "        activity_type = str(goal[\"Activity Type\"]).strip()\n",
    "\n",
    "        try:\n",
    "            daily_goal = int(float(goal[\"Daily Goal\"]))\n",
    "        except (ValueError, TypeError):\n",
    "            daily_goal = 0\n",
    "\n",
    "        completed = sum(\n",
    "            1 for activity in today_activities\n",
    "            if str(activity[\"Activity Type\"]).strip().lower()\n",
    "            == activity_type.lower()\n",
    "            and str(activity[\"Outcome\"]).strip().lower()\n",
    "            not in [\"draft\", \"planned\", \"not sent\", \"cancelled\"]\n",
    "        )\n",
    "\n",
    "        outreach_rows.append({\n",
    "            \"Activity Type\": activity_type,\n",
    "            \"Daily Goal\": daily_goal,\n",
    "            \"Recorded Activity\": completed,\n",
    "            \"Remaining\": max(0, daily_goal - completed),\n",
    "            \"Progress %\": (\n",
    "                round(completed / daily_goal * 100, 1)\n",
    "                if daily_goal > 0 else 0\n",
    "            )\n",
    "        })\n",
    "\n",
    "    if outreach_rows:\n",
    "        display(pd.DataFrame(outreach_rows))\n",
    "    else:\n",
    "        print(\"No active outreach goals configured.\")\n",
    "\n",
    "    # -------------------------------------------------\n",
    "    # 3. OVERDUE AND TODAY'S FOLLOW-UPS\n",
    "    # -------------------------------------------------\n",
    "\n",
    "    urgent_tasks = []\n",
    "\n",
    "    for task in open_tasks:\n",
    "\n",
    "        due_text = str(task[\"Due Date\"]).strip()\n",
    "\n",
    "        if not due_text:\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "            due_date = date.fromisoformat(due_text[:10])\n",
    "        except ValueError:\n",
    "            continue\n",
    "\n",
    "        if due_date <= today:\n",
    "\n",
    "            urgent_tasks.append({\n",
    "                \"Task ID\": task[\"Task ID\"],\n",
    "                \"Company\": company_lookup.get(\n",
    "                    str(task[\"Company ID\"]),\n",
    "                    str(task[\"Company ID\"])\n",
    "                ),\n",
    "                \"Task\": task[\"Task Description\"],\n",
    "                \"Priority\": task[\"Priority\"],\n",
    "                \"Due Date\": due_text,\n",
    "                \"Timing\": (\n",
    "                    \"Overdue\" if due_date < today else \"Due Today\"\n",
    "                )\n",
    "            })\n",
    "\n",
    "    print(\"\\nFOLLOW-UPS REQUIRING ATTENTION\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    if urgent_tasks:\n",
    "        urgent_df = pd.DataFrame(urgent_tasks)\n",
    "        urgent_df = urgent_df.sort_values(\"Due Date\")\n",
    "        display(urgent_df)\n",
    "    else:\n",
    "        print(\"No overdue or due-today follow-ups.\")\n",
    "\n",
    "    # -------------------------------------------------\n",
    "    # 4. UPCOMING FOLLOW-UPS (NEXT 7 DAYS)\n",
    "    # -------------------------------------------------\n",
    "\n",
    "    upcoming_tasks = []\n",
    "\n",
    "    for task in open_tasks:\n",
    "\n",
    "        due_text = str(task[\"Due Date\"]).strip()\n",
    "\n",
    "        try:\n",
    "            due_date = date.fromisoformat(due_text[:10])\n",
    "        except ValueError:\n",
    "            continue\n",
    "\n",
    "        if today < due_date <= today + timedelta(days=7):\n",
    "\n",
    "            upcoming_tasks.append({\n",
    "                \"Company\": company_lookup.get(\n",
    "                    str(task[\"Company ID\"]),\n",
    "                    str(task[\"Company ID\"])\n",
    "                ),\n",
    "                \"Task\": task[\"Task Description\"],\n",
    "                \"Due Date\": due_text,\n",
    "                \"Priority\": task[\"Priority\"]\n",
    "            })\n",
    "\n",
    "    print(\"\\nUPCOMING FOLLOW-UPS — NEXT 7 DAYS\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    if upcoming_tasks:\n",
    "        display(\n",
    "            pd.DataFrame(upcoming_tasks).sort_values(\"Due Date\")\n",
    "        )\n",
    "    else:\n",
    "        print(\"No upcoming follow-ups in the next 7 days.\")\n",
    "\n",
    "    # -------------------------------------------------\n",
    "    # 5. PRIORITY OPPORTUNITIES\n",
    "    # -------------------------------------------------\n",
    "\n",
    "    print(\"\\nPRIORITY SALES OPPORTUNITIES\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    priority_rows = []\n",
    "\n",
    "    for opportunity in open_opportunities:\n",
    "\n",
    "        try:\n",
    "            score = float(\n",
    "                opportunity[\"Opportunity Score\"]\n",
    "            )\n",
    "        except (ValueError, TypeError):\n",
    "            score = 0\n",
    "\n",
    "        priority_rows.append({\n",
    "            \"Company\": company_lookup.get(\n",
    "                str(opportunity[\"Company ID\"]),\n",
    "                str(opportunity[\"Company ID\"])\n",
    "            ),\n",
    "            \"Opportunity\": opportunity[\"Opportunity Name\"],\n",
    "            \"Pipeline Stage\": opportunity[\"Pipeline Stage\"],\n",
    "            \"Score\": score,\n",
    "            \"Estimated Value\": opportunity[\"Estimated Value\"]\n",
    "        })\n",
    "\n",
    "    if priority_rows:\n",
    "        priority_df = pd.DataFrame(priority_rows)\n",
    "        priority_df = priority_df.sort_values(\n",
    "            \"Score\", ascending=False\n",
    "        )\n",
    "        display(priority_df.head(10))\n",
    "    else:\n",
    "        print(\"No open sales opportunities.\")\n",
    "\n",
    "    # -------------------------------------------------\n",
    "    # 6. RECENT COMMUNICATIONS\n",
    "    # -------------------------------------------------\n",
    "\n",
    "    print(\"\\nRECENT OUTREACH ACTIVITY\")\n",
    "    print(\"-\" * 65)\n",
    "\n",
    "    recent = sorted(\n",
    "        [\n",
    "            a for a in activities\n",
    "            if str(a[\"Direction\"]).strip().lower()\n",
    "            == \"outbound\"\n",
    "        ],\n",
    "        key=lambda a: str(a[\"Activity Date\"]),\n",
    "        reverse=True\n",
    "    )[:10]\n",
    "\n",
    "    if recent:\n",
    "        recent_rows = []\n",
    "\n",
    "        for activity in recent:\n",
    "            recent_rows.append({\n",
    "                \"Date\": activity[\"Activity Date\"],\n",
    "                \"Company\": company_lookup.get(\n",
    "                    str(activity[\"Company ID\"]),\n",
    "                    str(activity[\"Company ID\"])\n",
    "                ),\n",
    "                \"Type\": activity[\"Activity Type\"],\n",
    "                \"Outcome\": activity[\"Outcome\"],\n",
    "                \"Next Action\": activity[\"Next Action\"]\n",
    "            })\n",
    "\n",
    "        display(pd.DataFrame(recent_rows))\n",
    "    else:\n",
    "        print(\"No outreach activity recorded.\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 65)\n",
    "    print(\"END OF DAILY COMMAND CENTER\")\n",
    "    print(\"=\" * 65)\n",
    "\n",
    "    return {\n",
    "        \"Date\": today_text,\n",
    "        \"Companies\": len(companies),\n",
    "        \"Contacts\": len(contacts),\n",
    "        \"Open Opportunities\": len(open_opportunities),\n",
    "        \"Open Tasks\": len(open_tasks),\n",
    "        \"Due or Overdue Tasks\": len(urgent_tasks),\n",
    "        \"Upcoming Tasks\": len(upcoming_tasks),\n",
    "        \"Outreach Activity Today\": len(today_activities)\n",
    "    }\n",
    "\n",
    "\n",
    "print(\"✓ Daily Outreach Command Center installed!\")\n",
    "print(\"✓ Outreach goal tracking connected!\")\n",
    "print(\"✓ Follow-up monitoring connected!\")\n",
    "print(\"✓ Opportunity prioritization connected!\")\n",
    "print(\"✓ Recent communication history connected!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
