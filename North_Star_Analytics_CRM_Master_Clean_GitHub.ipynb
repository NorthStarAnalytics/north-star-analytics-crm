    "# STEP 033 — Proposal Follow-Up Scheduling\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "def add_business_days(start_date, business_days):\n",
    "    \"\"\"Add weekdays, excluding Saturday and Sunday.\"\"\"\n",
    "\n",
    "    if type(business_days) is not int or business_days < 0:\n",
    "        raise ValueError(\n",
    "            \"business_days must be a nonnegative integer.\"\n",
    "        )\n",
    "\n",
    "    current = start_date\n",
    "    added = 0\n",
    "\n",
    "    while added < business_days:\n",
    "        current += timedelta(days=1)\n",
    "\n",
    "        if current.weekday() < 5:\n",
    "            added += 1\n",
    "\n",
    "    return current\n",
    "\n",
    "\n",
    "def schedule_proposal_followup(\n",
    "    proposal_id,\n",
    "    business_days=3,\n",
    "    priority=\"High\",\n",
    "    contact_id=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Schedule one follow-up for a proposal.\n",
    "\n",
    "    Prevents duplicate open follow-up tasks\n",
    "    for the same proposal.\n",
    "    \"\"\"\n",
    "\n",
    "    proposals = proposals_sheet.get_all_records()\n",
    "\n",
    "    proposal = next(\n",
    "        (\n",
    "            p for p in proposals\n",
    "            if str(p[\"Proposal ID\"]) == str(proposal_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if proposal is None:\n",
    "        raise ValueError(\"Proposal ID not found.\")\n",
    "\n",
    "    proposal_status = str(\n",
    "        proposal[\"Status\"]\n",
    "    ).strip().lower()\n",
    "\n",
    "    if proposal_status in [\n",
    "        \"accepted\", \"declined\", \"won\", \"lost\"\n",
    "    ]:\n",
    "        raise ValueError(\n",
    "            \"Cannot schedule follow-up for a closed proposal.\"\n",
    "        )\n",
    "\n",
    "    company_id = str(proposal[\"Company ID\"])\n",
    "    opportunity_id = str(\n",
    "        proposal[\"Opportunity ID\"]\n",
    "    )\n",
    "\n",
    "    # Confirm contact belongs to the proposal company\n",
    "    if contact_id:\n",
    "        contacts = contacts_sheet.get_all_records()\n",
    "\n",
    "        valid_contact = any(\n",
    "            str(c[\"Contact ID\"]) == str(contact_id)\n",
    "            and str(c[\"Company ID\"]) == company_id\n",
    "            for c in contacts\n",
    "        )\n",
    "\n",
    "        if not valid_contact:\n",
    "            raise ValueError(\n",
    "                \"Contact does not belong to proposal company.\"\n",
    "            )\n",
    "\n",
    "    reference = f\"ProposalFollowUpRef:{proposal_id}\"\n",
    "\n",
    "    existing_tasks = followups_sheet.get_all_records()\n",
    "\n",
    "    duplicate = any(\n",
    "        reference in str(task[\"Notes\"])\n",
    "        and str(task[\"Status\"]).strip().lower()\n",
    "        not in [\"completed\", \"cancelled\", \"canceled\"]\n",
    "        for task in existing_tasks\n",
    "    )\n",
    "\n",
    "    if duplicate:\n",
    "        print(\n",
    "            \"An open follow-up already exists \"\n",
    "            \"for this proposal.\"\n",
    "        )\n",
    "        return None\n",
    "\n",
    "    due_date = add_business_days(\n",
    "        crm_today(),\n",
    "        business_days\n",
    "    )\n",
    "\n",
    "    task_id = \"NSA-T-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    task_row = [\n",
    "        task_id,\n",
    "        company_id,\n",
    "        contact_id,\n",
    "        opportunity_id,\n",
    "        f\"Follow up on proposal {proposal_id}\",\n",
    "        \"Proposal Follow-Up\",\n",
    "        priority,\n",
    "        due_date.isoformat(),\n",
    "        \"Open\",\n",
    "        \"\",\n",
    "        reference\n",
    "    ]\n",
    "\n",
    "    followups_sheet.append_row(\n",
    "        task_row,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"\\n✓ Proposal follow-up scheduled!\")\n",
    "    print(\"Task ID:\", task_id)\n",
    "    print(\"Proposal ID:\", proposal_id)\n",
    "    print(\"Due Date:\", due_date.isoformat())\n",
    "    print(\"Priority:\", priority)\n",
    "    print(\"Status: Open\")\n",
    "    print(\"\\nNo message was sent to the client.\")\n",
    "\n",
    "    return task_id\n",
    "\n",
    "\n",
    "def show_proposal_followups(proposal_id=None):\n",
    "    \"\"\"\n",
    "    Display proposal-specific follow-up tasks.\n",
    "    Optionally filter by proposal ID.\n",
    "    \"\"\"\n",
    "\n",
    "    tasks = followups_sheet.get_all_records()\n",
    "\n",
    "    matches = []\n",
    "\n",
    "    for task in tasks:\n",
    "        notes = str(task[\"Notes\"])\n",
    "\n",
    "        if \"ProposalFollowUpRef:\" not in notes:\n",
    "            continue\n",
    "\n",
    "        if proposal_id:\n",
    "            expected = f\"ProposalFollowUpRef:{proposal_id}\"\n",
    "\n",
    "            if expected not in notes:\n",
    "                continue\n",
    "\n",
    "        matches.append(task)\n",
    "\n",
    "    if not matches:\n",
    "        print(\"No proposal follow-up tasks found.\")\n",
    "        return []\n",
    "\n",
    "    df = pd.DataFrame(matches)\n",
    "\n",
    "    display(df[[\n",
    "        \"Task ID\",\n",
    "        \"Company ID\",\n",
    "        \"Task Description\",\n",
    "        \"Priority\",\n",
    "        \"Due Date\",\n",
    "        \"Status\"\n",
    "    ]])\n",
    "\n",
    "    return matches\n",
    "\n",
    "\n",
    "print(\"✓ Proposal follow-up scheduling installed!\")\n",
    "print(\"✓ Business-day scheduling enabled!\")\n",
    "print(\"✓ Duplicate open-task protection enabled!\")\n",
    "print(\"✓ Proposal-specific task tracking enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
