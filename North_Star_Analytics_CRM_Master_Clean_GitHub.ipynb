    "# STEP 021 — Sales Command Center\n",
    "def daily_sales_command_center(days_ahead=7, top_n=10):\n",
    "    \"\"\"\n",
    "    Generate a daily sales action report from existing CRM data.\n",
    "    Does not modify underlying CRM records.\n",
    "    \"\"\"\n",
    "\n",
    "    if not isinstance(days_ahead, int) or days_ahead < 0:\n",
    "        raise ValueError(\"days_ahead must be a nonnegative integer.\")\n",
    "\n",
    "    if not isinstance(top_n, int) or top_n < 1:\n",
    "        raise ValueError(\"top_n must be a positive integer.\")\n",
    "\n",
    "    today = crm_today()\n",
    "    cutoff = today + timedelta(days=days_ahead)\n",
    "\n",
    "    companies = companies_sheet.get_all_records()\n",
    "    contacts = contacts_sheet.get_all_records()\n",
    "    activities = activities_sheet.get_all_records()\n",
    "    opportunities = opportunities_sheet.get_all_records()\n",
    "    followups = followups_sheet.get_all_records()\n",
    "    proposals = proposals_sheet.get_all_records()\n",
    "\n",
    "    company_names = {\n",
    "        str(c[\"Company ID\"]): c[\"Company Name\"]\n",
    "        for c in companies\n",
    "    }\n",
    "\n",
    "    contact_names = {\n",
    "        str(c[\"Contact ID\"]): (\n",
    "            str(c[\"First Name\"]) + \" \" + str(c[\"Last Name\"])\n",
    "        ).strip()\n",
    "        for c in contacts\n",
    "    }\n",
    "\n",
    "    opportunity_names = {\n",
    "        str(o[\"Opportunity ID\"]): o[\"Opportunity Name\"]\n",
    "        for o in opportunities\n",
    "    }\n",
    "\n",
    "    def parse_date(value):\n",
    "        try:\n",
    "            return date.fromisoformat(str(value).strip())\n",
    "        except (ValueError, TypeError):\n",
    "            return None\n",
    "\n",
    "    def show_section(title, records, columns, limit=None):\n",
    "        print(\"\\n\" + \"=\" * 65)\n",
    "        print(title)\n",
    "        print(\"=\" * 65)\n",
    "\n",
    "        if not records:\n",
    "            print(\"Nothing requiring attention.\")\n",
    "            return\n",
    "\n",
    "        df = pd.DataFrame(records)\n",
    "\n",
    "        if limit:\n",
    "            df = df.head(limit)\n",
    "\n",
    "        display(df[columns])\n",
    "\n",
    "    # 1. Overdue and upcoming follow-ups\n",
    "    overdue = []\n",
    "    due_today = []\n",
    "    upcoming = []\n",
    "\n",
    "    for task in followups:\n",
    "        if str(task[\"Status\"]).strip() in [\n",
    "            \"Completed\", \"Cancelled\"\n",
    "        ]:\n",
    "            continue\n",
    "\n",
    "        due = parse_date(task[\"Due Date\"])\n",
    "\n",
    "        if due is None:\n",
    "            continue\n",
    "\n",
    "        item = {\n",
    "            \"Task ID\": task[\"Task ID\"],\n",
    "            \"Company\": company_names.get(\n",
    "                str(task[\"Company ID\"]), \"Unknown\"\n",
    "            ),\n",
    "            \"Contact\": contact_names.get(\n",
    "                str(task[\"Contact ID\"]), \"\"\n",
    "            ),\n",
    "            \"Task\": task[\"Task Description\"],\n",
    "            \"Priority\": task[\"Priority\"],\n",
    "            \"Due Date\": due.isoformat(),\n",
    "            \"Days Overdue\": max((today - due).days, 0)\n",
    "        }\n",
    "\n",
    "        if due < today:\n",
    "            overdue.append(item)\n",
    "        elif due == today:\n",
    "            due_today.append(item)\n",
    "        elif due <= cutoff:\n",
    "            upcoming.append(item)\n",
    "\n",
    "    overdue.sort(\n",
    "        key=lambda x: (-x[\"Days Overdue\"], x[\"Due Date\"])\n",
    "    )\n",
    "    due_today.sort(key=lambda x: x[\"Priority\"])\n",
    "    upcoming.sort(key=lambda x: x[\"Due Date\"])\n",
    "\n",
    "    # 2. Proposals requiring decisions\n",
    "    pending_proposals = []\n",
    "\n",
    "    for proposal in proposals:\n",
    "        if proposal[\"Status\"] not in [\"Sent\", \"Under Review\"]:\n",
    "            continue\n",
    "\n",
    "        proposal_date = parse_date(proposal[\"Proposal Date\"])\n",
    "\n",
    "        days_waiting = (\n",
    "            (today - proposal_date).days\n",
    "            if proposal_date else None\n",
    "        )\n",
    "\n",
    "        pending_proposals.append({\n",
    "            \"Proposal ID\": proposal[\"Proposal ID\"],\n",
    "            \"Company\": company_names.get(\n",
    "                str(proposal[\"Company ID\"]), \"Unknown\"\n",
    "            ),\n",
    "            \"Service\": proposal[\"Service Package\"],\n",
    "            \"Total Value\": crm_number(proposal[\"Total Price\"]),\n",
    "            \"Status\": proposal[\"Status\"],\n",
    "            \"Days Waiting\": days_waiting\n",
    "        })\n",
    "\n",
    "    pending_proposals.sort(\n",
    "        key=lambda x: (\n",
    "            x[\"Days Waiting\"] is None,\n",
    "            -(x[\"Days Waiting\"] or 0)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # 3. Highest-priority open opportunities\n",
    "    priority_opportunities = []\n",
    "\n",
    "    for opportunity in opportunities:\n",
    "        if str(opportunity[\"Outcome\"]).strip() in [\n",
    "            \"Won\", \"Lost\"\n",
    "        ]:\n",
    "            continue\n",
    "\n",
    "        priority_opportunities.append({\n",
    "            \"Opportunity ID\": opportunity[\"Opportunity ID\"],\n",
    "            \"Company\": company_names.get(\n",
    "                str(opportunity[\"Company ID\"]), \"Unknown\"\n",
    "            ),\n",
    "            \"Opportunity\": opportunity[\"Opportunity Name\"],\n",
    "            \"Stage\": opportunity[\"Pipeline Stage\"],\n",
    "            \"Score\": crm_number(\n",
    "                opportunity[\"Opportunity Score\"]\n",
    "            ),\n",
    "            \"Estimated Value\": crm_number(\n",
    "                opportunity[\"Estimated Value\"]\n",
    "            )\n",
    "        })\n",
    "\n",
    "    priority_opportunities.sort(\n",
    "        key=lambda x: (\n",
    "            -x[\"Score\"],\n",
    "            -x[\"Estimated Value\"]\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # 4. Today's sales activity\n",
    "    todays_activities = [\n",
    "        a for a in activities\n",
    "        if parse_date(a[\"Activity Date\"]) == today\n",
    "    ]\n",
    "\n",
    "    activity_breakdown = {}\n",
    "\n",
    "    for activity in todays_activities:\n",
    "        activity_type = str(activity[\"Activity Type\"])\n",
    "        activity_breakdown[activity_type] = (\n",
    "            activity_breakdown.get(activity_type, 0) + 1\n",
    "        )\n",
    "\n",
    "    # Daily summary\n",
    "    print(\"\\n\" + \"=\" * 65)\n",
    "    print(\"NORTH STAR ANALYTICS\")\n",
    "    print(\"DAILY SALES COMMAND CENTER\")\n",
    "    print(\"Date:\", today.strftime(\"%B %d, %Y\"))\n",
    "    print(\"=\" * 65)\n",
    "\n",
    "    print(\"Overdue Follow-Ups:\", len(overdue))\n",
    "    print(\"Due Today:\", len(due_today))\n",
    "    print(\"Upcoming Follow-Ups:\", len(upcoming))\n",
    "    print(\"Pending Proposals:\", len(pending_proposals))\n",
    "    print(\"Open Opportunities:\", len(priority_opportunities))\n",
    "    print(\"Sales Activities Today:\", len(todays_activities))\n",
    "\n",
    "    task_columns = [\n",
    "        \"Task ID\", \"Company\", \"Contact\",\n",
    "        \"Task\", \"Priority\", \"Due Date\", \"Days Overdue\"\n",
    "    ]\n",
    "\n",
    "    show_section(\n",
    "        \"1. OVERDUE FOLLOW-UPS\",\n",
    "        overdue,\n",
    "        task_columns\n",
    "    )\n",
    "\n",
    "    show_section(\n",
    "        \"2. FOLLOW-UPS DUE TODAY\",\n",
    "        due_today,\n",
    "        task_columns\n",
    "    )\n",
    "\n",
    "    show_section(\n",
    "        f\"3. UPCOMING FOLLOW-UPS ({days_ahead} DAYS)\",\n",
    "        upcoming,\n",
    "        task_columns\n",
    "    )\n",
    "\n",
    "    show_section(\n",
    "        \"4. PROPOSALS AWAITING DECISIONS\",\n",
    "        pending_proposals,\n",
    "        [\n",
    "            \"Proposal ID\", \"Company\", \"Service\",\n",
    "            \"Total Value\", \"Status\", \"Days Waiting\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    show_section(\n",
    "        \"5. TOP SALES OPPORTUNITIES\",\n",
    "        priority_opportunities,\n",
    "        [\n",
    "            \"Opportunity ID\", \"Company\", \"Opportunity\",\n",
    "            \"Stage\", \"Score\", \"Estimated Value\"\n",
    "        ],\n",
    "        limit=top_n\n",
    "    )\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 65)\n",
    "    print(\"6. TODAY'S OUTREACH ACTIVITY\")\n",
    "    print(\"=\" * 65)\n",
    "\n",
    "    if activity_breakdown:\n",
    "        for activity_type, count in sorted(\n",
    "            activity_breakdown.items()\n",
    "        ):\n",
    "            print(f\"{activity_type}: {count}\")\n",
    "    else:\n",
    "        print(\"No outreach activities recorded today.\")\n",
    "\n",
    "    print(\"\\n✓ Daily command center report complete!\")\n",
    "\n",
    "    return {\n",
    "        \"overdue\": overdue,\n",
    "        \"due_today\": due_today,\n",
    "        \"upcoming\": upcoming,\n",
    "        \"pending_proposals\": pending_proposals,\n",
    "        \"priority_opportunities\": priority_opportunities,\n",
    "        \"activity_breakdown\": activity_breakdown\n",
    "    }\n",
    "\n",
    "\n",
    "# Run your first daily sales report\n",
    "daily_report = daily_sales_command_center()\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
