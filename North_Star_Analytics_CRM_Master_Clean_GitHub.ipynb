    "# STEP 018 — Continuing Services\n",
    "continuing_sheet = spreadsheet.worksheet(\"Continuing Services\")\n",
    "\n",
    "service_types = [\n",
    "    \"Quarterly Process Review\",\n",
    "    \"Monthly KPI Reporting\",\n",
    "    \"Dashboard Maintenance\",\n",
    "    \"Data-Quality Monitoring\",\n",
    "    \"New Workflow Review\",\n",
    "    \"Process Documentation\",\n",
    "    \"Employee Training\",\n",
    "    \"Implementation Support\",\n",
    "    \"Annual Performance Assessment\",\n",
    "    \"Full Partnership\"\n",
    "]\n",
    "\n",
    "billing_frequencies = [\n",
    "    \"Monthly\", \"Quarterly\", \"Annually\", \"One-Time\"\n",
    "]\n",
    "\n",
    "def create_continuing_service(\n",
    "    company_id,\n",
    "    service_type,\n",
    "    fee,\n",
    "    billing_frequency,\n",
    "    start_date,\n",
    "    renewal_date=\"\",\n",
    "    project_id=\"\",\n",
    "    next_review_date=\"\",\n",
    "    deliverables=\"\",\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"Create a continuing-service agreement.\"\"\"\n",
    "\n",
    "    companies = companies_sheet.get_all_records()\n",
    "\n",
    "    if not any(\n",
    "        str(c[\"Company ID\"]) == str(company_id)\n",
    "        for c in companies\n",
    "    ):\n",
    "        raise ValueError(\"Company ID does not exist.\")\n",
    "\n",
    "    if service_type not in service_types:\n",
    "        raise ValueError(\"Invalid service type.\")\n",
    "\n",
    "    if billing_frequency not in billing_frequencies:\n",
    "        raise ValueError(\"Invalid billing frequency.\")\n",
    "\n",
    "    if project_id:\n",
    "        projects = projects_sheet.get_all_records()\n",
    "\n",
    "        if not any(\n",
    "            str(p[\"Project ID\"]) == str(project_id)\n",
    "            and str(p[\"Company ID\"]) == str(company_id)\n",
    "            for p in projects\n",
    "        ):\n",
    "            raise ValueError(\n",
    "                \"Project does not belong to this company.\"\n",
    "            )\n",
    "\n",
    "    fee = crm_money(fee)\n",
    "    start = date.fromisoformat(str(start_date))\n",
    "\n",
    "    if renewal_date:\n",
    "        renewal = date.fromisoformat(str(renewal_date))\n",
    "        if renewal < start:\n",
    "            raise ValueError(\"Renewal date precedes start date.\")\n",
    "\n",
    "    if next_review_date:\n",
    "        date.fromisoformat(str(next_review_date))\n",
    "\n",
    "    service_id = \"NSA-CS-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    service_record = [\n",
    "        service_id,\n",
    "        company_id,\n",
    "        project_id,\n",
    "        service_type,\n",
    "        float(fee),\n",
    "        billing_frequency,\n",
    "        start.isoformat(),\n",
    "        renewal_date,\n",
    "        \"Proposed\",\n",
    "        next_review_date,\n",
    "        deliverables,\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    continuing_sheet.append_row(\n",
    "        service_record,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Continuing-service agreement created!\")\n",
    "    print(\"Service ID:\", service_id)\n",
    "    print(\"Service:\", service_type)\n",
    "    print(f\"Fee: ${fee:,.2f} ({billing_frequency})\")\n",
    "    print(\"Status: Proposed\")\n",
    "\n",
    "    return service_id\n",
    "\n",
    "\n",
    "def update_service_status(service_id, new_status):\n",
    "    \"\"\"Update continuing-service agreement status.\"\"\"\n",
    "\n",
    "    valid_statuses = [\n",
    "        \"Proposed\", \"Active\", \"Paused\",\n",
    "        \"Completed\", \"Cancelled\"\n",
    "    ]\n",
    "\n",
    "    if new_status not in valid_statuses:\n",
    "        raise ValueError(\"Invalid service status.\")\n",
    "\n",
    "    records = continuing_sheet.get_all_records()\n",
    "\n",
    "    for row_number, record in enumerate(records, start=2):\n",
    "        if str(record[\"Service ID\"]) == str(service_id):\n",
    "\n",
    "            continuing_sheet.update(\n",
    "                range_name=f\"I{row_number}\",\n",
    "                values=[[new_status]]\n",
    "            )\n",
    "\n",
    "            print(\"✓ Service status updated:\", new_status)\n",
    "            return\n",
    "\n",
    "    raise ValueError(\"Service ID not found.\")\n",
    "\n",
    "\n",
    "def show_recurring_revenue():\n",
    "    \"\"\"Calculate active monthly and annual recurring revenue.\"\"\"\n",
    "\n",
    "    records = continuing_sheet.get_all_records()\n",
    "\n",
    "    monthly_revenue = 0\n",
    "\n",
    "    for record in records:\n",
    "        if record[\"Status\"] != \"Active\":\n",
    "            continue\n",
    "\n",
    "        fee = float(record[\"Monthly Fee\"] or 0)\n",
    "        frequency = record[\"Billing Frequency\"]\n",
    "\n",
    "        if frequency == \"Monthly\":\n",
    "            monthly_revenue += fee\n",
    "        elif frequency == \"Quarterly\":\n",
    "            monthly_revenue += fee / 3\n",
    "        elif frequency == \"Annually\":\n",
    "            monthly_revenue += fee / 12\n",
    "\n",
    "    annual_revenue = monthly_revenue * 12\n",
    "\n",
    "    print(\"NORTH STAR ANALYTICS\")\n",
    "    print(\"Recurring Revenue Summary\")\n",
    "    print(\"-------------------------\")\n",
    "    print(f\"Monthly Recurring Revenue: ${monthly_revenue:,.2f}\")\n",
    "    print(f\"Annualized Recurring Revenue: ${annual_revenue:,.2f}\")\n",
    "\n",
    "    return monthly_revenue, annual_revenue\n",
    "\n",
    "\n",
    "def show_upcoming_renewals(days_ahead=30):\n",
    "    \"\"\"Display active agreements approaching renewal.\"\"\"\n",
    "\n",
    "    records = continuing_sheet.get_all_records()\n",
    "\n",
    "    today = crm_today()\n",
    "    cutoff = today + timedelta(days=days_ahead)\n",
    "\n",
    "    renewals = []\n",
    "\n",
    "    for record in records:\n",
    "        if record[\"Status\"] != \"Active\":\n",
    "            continue\n",
    "\n",
    "        if not record[\"Renewal Date\"]:\n",
    "            continue\n",
    "\n",
    "        renewal = date.fromisoformat(str(record[\"Renewal Date\"]))\n",
    "\n",
    "        if renewal <= cutoff:\n",
    "            renewals.append({\n",
    "                \"Company ID\": record[\"Company ID\"],\n",
    "                \"Service\": record[\"Service Type\"],\n",
    "                \"Renewal Date\": renewal.isoformat(),\n",
    "                \"Fee\": record[\"Monthly Fee\"],\n",
    "                \"Billing Frequency\": record[\"Billing Frequency\"]\n",
    "            })\n",
    "\n",
    "    if renewals:\n",
    "        display(\n",
    "            pd.DataFrame(renewals).sort_values(\"Renewal Date\")\n",
    "        )\n",
    "    else:\n",
    "        print(\"✓ No renewals due within the selected period.\")\n",
    "\n",
    "\n",
    "print(\"✓ Continuing services system installed!\")\n",
    "print(\"✓ Recurring revenue calculations enabled!\")\n",
    "print(\"✓ Renewal tracking enabled!\")\n",
    "print(\"✓ Service status management enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
