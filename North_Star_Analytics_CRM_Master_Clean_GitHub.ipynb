    "# STEP 043 — CRM Structure Audit\n",
    "# North Star Analytics CRM\n",
    "# READ-ONLY: Does not change any records\n",
    "\n",
    "\n",
    "def audit_crm_structure():\n",
    "\n",
    "    print(\"=\" * 65)\n",
    "    print(\"NORTH STAR ANALYTICS — CRM STRUCTURE AUDIT\")\n",
    "    print(\"=\" * 65)\n",
    "\n",
    "    expected_headers = {\n",
    "        \"Companies\": [\n",
    "            \"Company ID\", \"Company Name\"\n",
    "        ],\n",
    "        \"Contacts\": [\n",
    "            \"Contact ID\", \"Company ID\",\n",
    "            \"First Name\", \"Last Name\"\n",
    "        ],\n",
    "        \"Activities\": [\n",
    "            \"Activity ID\", \"Company ID\",\n",
    "            \"Contact ID\", \"Activity Date\"\n",
    "        ],\n",
    "        \"Opportunities\": [\n",
    "            \"Opportunity ID\", \"Company ID\",\n",
    "            \"Pipeline Stage\", \"Opportunity Score\"\n",
    "        ],\n",
    "        \"Follow-Ups\": [\n",
    "            \"Task ID\", \"Company ID\",\n",
    "            \"Due Date\", \"Status\"\n",
    "        ],\n",
    "        \"Discovery\": [\n",
    "            \"Discovery ID\", \"Company ID\"\n",
    "        ],\n",
    "        \"Proposals\": [\n",
    "            \"Proposal ID\", \"Company ID\"\n",
    "        ],\n",
    "        \"Projects\": [\n",
    "            \"Project ID\", \"Company ID\"\n",
    "        ],\n",
    "        \"Financials\": [\n",
    "            \"Transaction ID\", \"Company ID\"\n",
    "        ],\n",
    "        \"Outreach Goals\": [\n",
    "            \"Activity Type\", \"Daily Goal\",\n",
    "            \"Weekly Goal\", \"Active\", \"Notes\"\n",
    "        ],\n",
    "        \"Discovery Question Library\": [\n",
    "            \"Question ID\", \"Department\",\n",
    "            \"Business Question\",\n",
    "            \"Technical Analysis Question\"\n",
    "        ],\n",
    "        \"Communication Templates\": [\n",
    "            \"Template ID\", \"Template Name\",\n",
    "            \"Subject\", \"Message\"\n",
    "        ]\n",
    "    }\n",
    "\n",
    "    results = []\n",
    "\n",
    "    for ws in spreadsheet.worksheets():\n",
    "\n",
    "        headers = ws.row_values(1)\n",
    "\n",
    "        required = expected_headers.get(ws.title, [])\n",
    "\n",
    "        missing = [\n",
    "            column for column in required\n",
    "            if column not in headers\n",
    "        ]\n",
    "\n",
    "        record_count = max(\n",
    "            0,\n",
    "            len(ws.get_all_values()) - 1\n",
    "        )\n",
    "\n",
    "        results.append({\n",
    "            \"Worksheet\": ws.title,\n",
    "            \"Records\": record_count,\n",
    "            \"Header Status\": (\n",
    "                \"PASS\" if not missing else \"REVIEW\"\n",
    "            ),\n",
    "            \"Missing Headers\": \", \".join(missing)\n",
    "        })\n",
    "\n",
    "    display(pd.DataFrame(results))\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 65)\n",
    "    print(\"OUTREACH GOALS INSPECTION\")\n",
    "    print(\"=\" * 65)\n",
    "\n",
    "    goals_ws = spreadsheet.worksheet(\"Outreach Goals\")\n",
    "\n",
    "    goal_values = goals_ws.get_all_values()\n",
    "\n",
    "    print(\"\\nCurrent worksheet contents:\")\n",
    "\n",
    "    if goal_values:\n",
    "        display(pd.DataFrame(goal_values))\n",
    "    else:\n",
    "        print(\"Worksheet is completely empty.\")\n",
    "\n",
    "    print(\"\\nExpected daily outreach targets:\")\n",
    "    print(\"-\" * 45)\n",
    "\n",
    "    expected_goals = {\n",
    "        \"Phone\": 10,\n",
    "        \"Email\": 10,\n",
    "        \"LinkedIn\": 5,\n",
    "        \"In-Person\": 2,\n",
    "        \"Video\": 1,\n",
    "        \"Referral\": 2\n",
    "    }\n",
    "\n",
    "    for activity, target in expected_goals.items():\n",
    "        print(f\"{activity}: {target} per day\")\n",
    "\n",
    "    print(\"\\n✓ Read-only audit completed.\")\n",
    "    print(\"✓ No CRM data modified.\")\n",
    "\n",
    "    return results\n",
    "\n",
    "\n",
    "crm_audit_results = audit_crm_structure()\n"
   ],
