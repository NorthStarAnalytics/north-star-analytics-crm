    "# STEP 028 — Proposal Scope Builder\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "scope_sheet_name = \"Proposal Scope Drafts\"\n",
    "\n",
    "scope_headers = [\n",
    "    \"Scope Draft ID\",\n",
    "    \"Company ID\",\n",
    "    \"Created Date\",\n",
    "    \"Draft Status\",\n",
    "    \"Recommended Services\",\n",
    "    \"Business Problems\",\n",
    "    \"Proposed Deliverables\",\n",
    "    \"Required Data\",\n",
    "    \"KPIs\",\n",
    "    \"Scope Exclusions\",\n",
    "    \"Add-On Review\",\n",
    "    \"Continuing Services\",\n",
    "    \"Internal Notes\"\n",
    "]\n",
    "\n",
    "try:\n",
    "    scope_sheet = spreadsheet.worksheet(scope_sheet_name)\n",
    "\n",
    "except gspread.exceptions.WorksheetNotFound:\n",
    "    scope_sheet = spreadsheet.add_worksheet(\n",
    "        title=scope_sheet_name,\n",
    "        rows=500,\n",
    "        cols=len(scope_headers)\n",
    "    )\n",
    "\n",
    "existing_headers = scope_sheet.row_values(1)\n",
    "\n",
    "if not any(existing_headers):\n",
    "    scope_sheet.update(\n",
    "        range_name=\"A1:M1\",\n",
    "        values=[scope_headers],\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "elif existing_headers != scope_headers:\n",
    "    raise ValueError(\n",
    "        \"Proposal Scope Drafts headers do not match. \"\n",
    "        \"Existing worksheet data has been preserved.\"\n",
    "    )\n",
    "\n",
    "scope_sheet.freeze(rows=1)\n",
    "\n",
    "\n",
    "def create_proposal_scope_draft(company_id):\n",
    "    \"\"\"\n",
    "    Generate an internal proposal scope draft using\n",
    "    existing documented discovery recommendations.\n",
    "\n",
    "    Does not create a formal proposal or set prices.\n",
    "    \"\"\"\n",
    "\n",
    "    recommendations = generate_consulting_recommendations(\n",
    "        company_id\n",
    "    )\n",
    "\n",
    "    if not recommendations:\n",
    "        print(\"No recommendations available.\")\n",
    "        return None\n",
    "\n",
    "    services = []\n",
    "    problems = []\n",
    "    deliverables = []\n",
    "    required_data = []\n",
    "    kpis = []\n",
    "    continuing = []\n",
    "\n",
    "    for recommendation in recommendations:\n",
    "\n",
    "        services.append(recommendation[\"Service\"])\n",
    "\n",
    "        problems.extend(\n",
    "            recommendation[\"Pain Points\"].split(\" | \")\n",
    "        )\n",
    "\n",
    "        deliverables.extend(\n",
    "            recommendation[\"Suggested Deliverables\"].split(\" | \")\n",
    "        )\n",
    "\n",
    "        required_data.extend(\n",
    "            recommendation[\"Available Data\"].split(\" | \")\n",
    "        )\n",
    "\n",
    "        kpis.extend(\n",
    "            recommendation[\"KPIs\"].split(\" | \")\n",
    "        )\n",
    "\n",
    "        continuing.extend(\n",
    "            recommendation[\"Continuing Services\"].split(\" | \")\n",
    "        )\n",
    "\n",
    "    # Remove empty entries and duplicates while preserving order\n",
    "    def unique_items(items):\n",
    "        return list(dict.fromkeys(\n",
    "            str(item).strip()\n",
    "            for item in items\n",
    "            if str(item).strip()\n",
    "        ))\n",
    "\n",
    "    services = unique_items(services)\n",
    "    problems = unique_items(problems)\n",
    "    deliverables = unique_items(deliverables)\n",
    "    required_data = unique_items(required_data)\n",
    "    kpis = unique_items(kpis)\n",
    "    continuing = unique_items(continuing)\n",
    "\n",
    "    exclusions = [\n",
    "        \"Work not expressly included in the approved scope\",\n",
    "        \"Additional locations unless specifically included\",\n",
    "        \"Additional workflows beyond the contracted limit\",\n",
    "        \"Major dashboard development unless specified\",\n",
    "        \"Extensive historical data cleanup\",\n",
    "        \"Custom software development\",\n",
    "        \"On-site travel and related expenses\",\n",
    "        \"Additional training sessions\",\n",
    "        \"Urgent or out-of-schedule work\",\n",
    "        \"Ongoing support unless separately contracted\"\n",
    "    ]\n",
    "\n",
    "    add_on_review = [\n",
    "        \"Additional locations\",\n",
    "        \"More than four workflows\",\n",
    "        \"Major dashboard development\",\n",
    "        \"Extensive historical data cleanup\",\n",
    "        \"Custom software development\",\n",
    "        \"On-site travel\",\n",
    "        \"Additional training sessions\",\n",
    "        \"Urgent work outside the established schedule\"\n",
    "    ]\n",
    "\n",
    "    scope_id = \"NSA-SCOPE-\" + uuid4().hex[:10].upper()\n",
    "\n",
    "    row = [\n",
    "        scope_id,\n",
    "        company_id,\n",
    "        crm_today().isoformat(),\n",
    "        \"Internal Draft\",\n",
    "        json.dumps(services),\n",
    "        json.dumps(problems),\n",
    "        json.dumps(deliverables),\n",
    "        json.dumps(required_data),\n",
    "        json.dumps(kpis),\n",
    "        json.dumps(exclusions),\n",
    "        json.dumps(add_on_review),\n",
    "        json.dumps(continuing),\n",
    "        \"Requires scope, feasibility, and pricing review.\"\n",
    "    ]\n",
    "\n",
    "    scope_sheet.append_row(\n",
    "        row,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"\\n✓ Proposal scope draft created!\")\n",
    "    print(\"Scope Draft ID:\", scope_id)\n",
    "    print(\"Services:\", len(services))\n",
    "    print(\"Proposed Deliverables:\", len(deliverables))\n",
    "    print(\"Continuing-Service Options:\", len(continuing))\n",
    "    print(\"Status: Internal Draft\")\n",
    "    print(\"\\nNo prices or formal proposals were created.\")\n",
    "\n",
    "    return scope_id\n",
    "\n",
    "\n",
    "def show_proposal_scope_draft(scope_id):\n",
    "    \"\"\"\n",
    "    Retrieve and display a saved proposal scope draft.\n",
    "    \"\"\"\n",
    "\n",
    "    records = scope_sheet.get_all_records()\n",
    "\n",
    "    draft = next(\n",
    "        (\n",
    "            record for record in records\n",
    "            if str(record[\"Scope Draft ID\"]) == str(scope_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if draft is None:\n",
    "        print(\"Scope draft not found.\")\n",
    "        return None\n",
    "\n",
    "    print(\"\\nNORTH STAR ANALYTICS\")\n",
    "    print(\"PROPOSAL SCOPE DRAFT\")\n",
    "    print(\"-\" * 50)\n",
    "    print(\"Draft ID:\", draft[\"Scope Draft ID\"])\n",
    "    print(\"Company ID:\", draft[\"Company ID\"])\n",
    "    print(\"Status:\", draft[\"Draft Status\"])\n",
    "\n",
    "    sections = {\n",
    "        \"Recommended Services\": \"Recommended Services\",\n",
    "        \"Business Problems\": \"Business Problems\",\n",
    "        \"Proposed Deliverables\": \"Proposed Deliverables\",\n",
    "        \"Required Data\": \"Required Data\",\n",
    "        \"KPIs\": \"KPIs\",\n",
    "        \"Scope Exclusions\": \"Scope Exclusions\",\n",
    "        \"Add-On Review\": \"Add-On Review\",\n",
    "        \"Continuing Services\": \"Continuing Services\"\n",
    "    }\n",
    "\n",
    "    for heading, column in sections.items():\n",
    "\n",
    "        print(f\"\\n{heading.upper()}\")\n",
    "\n",
    "        try:\n",
    "            items = json.loads(draft[column])\n",
    "        except (json.JSONDecodeError, TypeError):\n",
    "            items = [str(draft[column])]\n",
    "\n",
    "        for item in items:\n",
    "            print(\"•\", item)\n",
    "\n",
    "    return draft\n",
    "\n",
    "\n",
    "print(\"✓ Proposal scope builder installed!\")\n",
    "print(\"✓ Proposal Scope Drafts worksheet configured!\")\n",
    "print(\"✓ Scope exclusions and add-on reviews enabled!\")\n",
    "print(\"✓ Continuing-service options included!\")\n",
    "print(\"✓ Draft retrieval enabled!\")\n"
   ],
