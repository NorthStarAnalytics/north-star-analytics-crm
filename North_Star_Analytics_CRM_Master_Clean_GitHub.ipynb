    "    \"Finance and Insurance\",\n",
    "    \"Service\",\n",
    "    \"Parts\",\n",
    "    \"Inventory\",\n",
    "    \"Accounting\",\n",
    "    \"Human Resources\",\n",
    "    \"Marketing\",\n",
    "    \"Operations\",\n",
    "    \"Customer Experience\",\n",
    "    \"Other\"\n",
    "]\n",
    "\n",
    "def create_discovery(\n",
    "    company_id,\n",
    "    department,\n",
    "    current_process,\n",
    "    pain_point,\n",
    "    business_impact,\n",
    "    contact_id=\"\",\n",
    "    current_software=\"\",\n",
    "    available_data=\"\",\n",
    "    current_kpi=\"\",\n",
    "    desired_outcome=\"\",\n",
    "    decision_maker=\"\",\n",
    "    budget=\"\",\n",
    "    timeline=\"\",\n",
    "    recommended_service=\"\",\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Create a structured business discovery record.\n",
    "    Links operational problems to available data,\n",
    "    KPIs, and potential consulting services.\n",
    "    \"\"\"\n",
    "\n",
    "    # Verify company exists\n",
    "    companies = companies_sheet.get_all_records()\n",
    "\n",
    "    if not any(\n",
    "        str(c[\"Company ID\"]) == str(company_id)\n",
    "        for c in companies\n",
    "    ):\n",
    "        raise ValueError(\"Company ID does not exist.\")\n",
    "\n",
    "    # Validate department\n",
    "    if department not in discovery_departments:\n",
    "        raise ValueError(\n",
    "            f\"Invalid department. Choose from: {discovery_departments}\"\n",
    "        )\n",
    "\n",
    "    # Verify contact belongs to company\n",
    "    if contact_id:\n",
    "        contacts = contacts_sheet.get_all_records()\n",
    "\n",
    "        valid_contact = any(\n",
    "            str(c[\"Contact ID\"]) == str(contact_id)\n",
    "            and str(c[\"Company ID\"]) == str(company_id)\n",
    "            for c in contacts\n",
    "        )\n",
    "\n",
    "        if not valid_contact:\n",
    "            raise ValueError(\n",
    "                \"Contact does not belong to this company.\"\n",
    "            )\n",
    "\n",
    "    # Generate discovery ID\n",
    "    discovery_id = \"NSA-D-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    discovery_record = [\n",
    "        discovery_id,\n",
    "        company_id,\n",
    "        contact_id,\n",
    "        crm_today().isoformat(),\n",
    "        department,\n",
    "        current_process,\n",
    "        pain_point,\n",
    "        business_impact,\n",
    "        current_software,\n",
    "        available_data,\n",
    "        current_kpi,\n",
    "        desired_outcome,\n",
    "        decision_maker,\n",
    "        budget,\n",
    "        timeline,\n",
    "        recommended_service,\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    discovery_sheet.append_row(\n",
    "        discovery_record,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Discovery assessment saved!\")\n",
    "    print(\"Discovery ID:\", discovery_id)\n",
    "    print(\"Department:\", department)\n",
    "    print(\"Pain Point:\", pain_point)\n",
    "    print(\"Recommended Service:\", recommended_service)\n",
    "\n",
    "    return discovery_id\n",
    "\n",
    "\n",
    "def show_company_discoveries(company_id):\n",
    "    \"\"\"\n",
    "    Retrieve all discovery findings for a company.\n",
    "    \"\"\"\n",
    "\n",
    "    records = discovery_sheet.get_all_records()\n",
    "\n",
    "    matches = [\n",
    "        record for record in records\n",
    "        if str(record[\"Company ID\"]) == str(company_id)\n",
    "    ]\n",
    "\n",
    "    if not matches:\n",
    "        print(\"No discovery assessments found.\")\n",
    "        return\n",
    "\n",
    "    df = pd.DataFrame(matches)\n",
    "\n",
    "    display(df[[\n",
    "        \"Discovery Date\",\n",
    "        \"Department\",\n",
