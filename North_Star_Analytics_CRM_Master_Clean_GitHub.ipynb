    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "\n",
    "def search_communication_templates(\n",
    "    pipeline_stage=None,\n",
    "    keyword=None\n",
    "):\n",
    "    \"\"\"Search the communication template library.\"\"\"\n",
    "\n",
    "    records = template_sheet.get_all_records()\n",
    "\n",
    "    df = pd.DataFrame(records)\n",
    "\n",
    "    if df.empty:\n",
    "        print(\"No communication templates available.\")\n",
    "        return df\n",
    "\n",
    "    if pipeline_stage:\n",
    "        df = df[\n",
    "            df[\"Pipeline Stage\"].str.contains(\n",
    "                pipeline_stage,\n",
    "                case=False,\n",
    "                na=False,\n",
    "                regex=False\n",
    "            )\n",
    "        ]\n",
    "\n",
    "    if keyword:\n",
    "        mask = (\n",
    "            df[\"Template Name\"].str.contains(\n",
    "                keyword, case=False, na=False, regex=False\n",
    "            )\n",
    "            |\n",
    "            df[\"Message\"].str.contains(\n",
    "                keyword, case=False, na=False, regex=False\n",
    "            )\n",
    "        )\n",
    "\n",
    "        df = df[mask]\n",
    "\n",
    "    display(df[[\n",
    "        \"Template ID\",\n",
    "        \"Template Name\",\n",
    "        \"Pipeline Stage\",\n",
    "        \"Communication Type\",\n",
    "        \"Recommended Timing\"\n",
    "    ]])\n",
    "\n",
    "    return df\n",
    "\n",
