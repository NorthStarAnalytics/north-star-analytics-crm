    "# STEP 032 — Proposal Pipeline Reporting\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "def show_proposal_pipeline():\n",
    "    \"\"\"\n",
    "    Display proposals with company names, review status,\n",
    "    decision dates, financial values, and follow-up indicators.\n",
    "\n",
    "    This function does not modify CRM data.\n",
    "    \"\"\"\n",
    "\n",
    "    proposals = proposals_sheet.get_all_records()\n",
    "    companies = companies_sheet.get_all_records()\n",
    "    reviews = review_sheet.get_all_records()\n",
    "    followups = followups_sheet.get_all_records()\n",
    "\n",
    "    if not proposals:\n",
    "        print(\"No proposals recorded yet.\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    company_lookup = {\n",
    "        str(c[\"Company ID\"]): c[\"Company Name\"]\n",
    "        for c in companies\n",
    "    }\n",
    "\n",
    "    review_lookup = {\n",
    "        str(r[\"Proposal ID\"]): r[\"Review Status\"]\n",
    "        for r in reviews\n",
    "    }\n",
    "\n",
    "    today = crm_today()\n",
    "    results = []\n",
    "\n",
    "    for proposal in proposals:\n",
    "\n",
    "        proposal_id = str(proposal[\"Proposal ID\"])\n",
    "        company_id = str(proposal[\"Company ID\"])\n",
    "        status = str(proposal[\"Status\"]).strip()\n",
    "\n",
    "        decision_date_text = str(\n",
    "            proposal[\"Decision Date\"]\n",
    "        ).strip()\n",
    "\n",
    "        decision_date = None\n",
    "\n",
    "        if decision_date_text:\n",
    "            try:\n",
    "                decision_date = date.fromisoformat(\n",
    "                    decision_date_text[:10]\n",
    "                )\n",
    "            except ValueError:\n",
    "                pass\n",
    "\n",
    "        # Determine decision timing\n",
    "        if status.lower() in [\n",
    "            \"accepted\", \"declined\", \"lost\", \"won\"\n",
    "        ]:\n",
    "            timing = \"Closed\"\n",
    "\n",
    "        elif decision_date is None:\n",
    "            timing = \"No Decision Date\"\n",
    "\n",
    "        elif decision_date < today:\n",
    "            timing = \"Overdue\"\n",
    "\n",
    "        elif decision_date == today:\n",
    "            timing = \"Due Today\"\n",
    "\n",
    "        else:\n",
    "            timing = \"Upcoming\"\n",
    "\n",
    "        # Find open follow-up tasks associated with\n",
    "        # the proposal's company.\n",
    "        # The current Follow-Ups schema does not have\n",
    "        # a dedicated Proposal ID column.\n",
    "        related_followups = [\n",
    "            task for task in followups\n",
    "            if str(task[\"Company ID\"]) == company_id\n",
    "            and str(task[\"Status\"]).strip().lower()\n",
    "            not in [\"completed\", \"cancelled\", \"canceled\"]\n",
    "        ]\n",
    "\n",
    "        overdue_followups = 0\n",
    "\n",
    "        for task in related_followups:\n",
    "            due_text = str(task[\"Due Date\"]).strip()\n",
    "\n",
    "            try:\n",
    "                due_date = date.fromisoformat(due_text[:10])\n",
    "\n",
    "                if due_date < today:\n",
    "                    overdue_followups += 1\n",
    "\n",
    "            except ValueError:\n",
    "                continue\n",
    "\n",
    "        try:\n",
    "            total_value = float(proposal[\"Total Price\"])\n",
    "        except (ValueError, TypeError):\n",
    "            total_value = 0.0\n",
    "\n",
    "        results.append({\n",
    "            \"Proposal ID\": proposal_id,\n",
    "            \"Company\": company_lookup.get(\n",
    "                company_id, company_id\n",
    "            ),\n",
    "            \"Proposal Status\": status,\n",
    "            \"Review Status\": review_lookup.get(\n",
    "                proposal_id, \"Not Reviewed\"\n",
    "            ),\n",
    "            \"Total Value\": total_value,\n",
    "            \"Decision Date\": decision_date_text,\n",
    "            \"Decision Timing\": timing,\n",
    "            \"Open Company Follow-Ups\": len(related_followups),\n",
    "            \"Overdue Company Follow-Ups\": overdue_followups\n",
    "        })\n",
    "\n",
    "    df = pd.DataFrame(results)\n",
    "\n",
    "    # Sort urgent decision dates to the top\n",
    "    timing_order = {\n",
    "        \"Overdue\": 0,\n",
    "        \"Due Today\": 1,\n",
    "        \"Upcoming\": 2,\n",
    "        \"No Decision Date\": 3,\n",
    "        \"Closed\": 4\n",
    "    }\n",
    "\n",
    "    df[\"_sort\"] = df[\"Decision Timing\"].map(timing_order)\n",
    "\n",
    "    df = df.sort_values(\n",
    "        [\"_sort\", \"Decision Date\", \"Company\"]\n",
    "    ).drop(columns=\"_sort\")\n",
    "\n",
    "    print(\"\\nNORTH STAR ANALYTICS\")\n",
    "    print(\"PROPOSAL PIPELINE\")\n",
    "    print(\"-\" * 55)\n",
    "\n",
    "    print(\"Total Proposals:\", len(df))\n",
    "\n",
    "    open_df = df[\n",
    "        df[\"Decision Timing\"] != \"Closed\"\n",
    "    ]\n",
    "\n",
    "    print(\"Open Proposals:\", len(open_df))\n",
    "    print(\n",
    "        \"Open Proposal Value:\",\n",
    "        f\"${open_df['Total Value'].sum():,.2f}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Overdue Decisions:\",\n",
    "        len(df[df[\"Decision Timing\"] == \"Overdue\"])\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Awaiting Quality Review:\",\n",
    "        len(df[\n",
    "            df[\"Review Status\"] != \"Client Ready\"\n",
    "        ])\n",
    "    )\n",
    "\n",
    "    display(df)\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "print(\"✓ Proposal pipeline dashboard installed!\")\n",
    "print(\"✓ Decision-date monitoring enabled!\")\n",
    "print(\"✓ Proposal review status connected!\")\n",
    "print(\"✓ Company follow-up visibility enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
