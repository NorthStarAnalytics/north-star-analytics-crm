   "source": [
    "# STEP 012 — Follow-Up Management\n",
    "# Set North Star Analytics business timezone\n",
    "CRM_TIMEZONE = ZoneInfo(\"America/Chicago\")\n",
    "\n",
    "followups_sheet = spreadsheet.worksheet(\"Follow-Ups\")\n",
    "\n",
    "def crm_today():\n",
    "    \"\"\"Return today's date in Central Time.\"\"\"\n",
    "    return datetime.now(CRM_TIMEZONE).date()\n",
    "\n",
    "\n",
    "def create_followup(\n",
    "    company_id,\n",
    "    task_description,\n",
    "    due_date,\n",
    "    contact_id=\"\",\n",
    "    opportunity_id=\"\",\n",
    "    task_type=\"Follow-Up\",\n",
    "    priority=\"Medium\",\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Create a follow-up task linked to a company.\n",
    "    \"\"\"\n",
    "\n",
    "    # Verify company exists\n",
    "    companies = companies_sheet.get_all_records()\n",
    "\n",
    "    if not any(\n",
    "        str(c[\"Company ID\"]) == str(company_id)\n",
    "        for c in companies\n",
    "    ):\n",
    "        raise ValueError(\"Company ID does not exist.\")\n",
    "\n",
    "    # Validate due date\n",
    "    due_date = date.fromisoformat(str(due_date))\n",
    "\n",
    "    # Generate task ID\n",
    "    task_id = \"NSA-T-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    task_record = [\n",
    "        task_id,\n",
    "        company_id,\n",
    "        contact_id,\n",
    "        opportunity_id,\n",
    "        task_description,\n",
    "        task_type,\n",
    "        priority,\n",
    "        due_date.isoformat(),\n",
    "        \"Not Started\",\n",
    "        \"\",\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    followups_sheet.append_row(\n",
    "        task_record,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Follow-up task created!\")\n",
    "    print(\"Task:\", task_description)\n",
    "    print(\"Due:\", due_date)\n",
    "    print(\"Priority:\", priority)\n",
    "\n",
    "    return task_id\n",
    "\n",
    "\n",
    "def show_followups(days_ahead=7):\n",
    "    \"\"\"\n",
    "    Display overdue and upcoming tasks.\n",
    "    \"\"\"\n",
    "\n",
    "    records = followups_sheet.get_all_records()\n",
    "\n",
    "    today = crm_today()\n",
    "    cutoff = today + timedelta(days=days_ahead)\n",
    "\n",
    "    tasks = []\n",
    "\n",
    "    for record in records:\n",
    "        if record[\"Status\"] in [\"Completed\", \"Cancelled\"]:\n",
    "            continue\n",
    "\n",
    "        if not record[\"Due Date\"]:\n",
    "            continue\n",
    "\n",
    "        due = date.fromisoformat(str(record[\"Due Date\"]))\n",
    "\n",
    "        if due <= cutoff:\n",
    "            if due < today:\n",
    "                status = \"OVERDUE\"\n",
    "            elif due == today:\n",
    "                status = \"DUE TODAY\"\n",
    "            else:\n",
    "                status = \"UPCOMING\"\n",
    "\n",
    "            tasks.append({\n",
    "                \"Task ID\": record[\"Task ID\"],\n",
    "                \"Company ID\": record[\"Company ID\"],\n",
    "                \"Task\": record[\"Task Description\"],\n",
    "                \"Due Date\": due.isoformat(),\n",
    "                \"Priority\": record[\"Priority\"],\n",
    "                \"Status\": status\n",
    "            })\n",
    "\n",
    "    if not tasks:\n",
    "        print(\"✓ No outstanding follow-ups!\")\n",
    "        return\n",
    "\n",
    "    df = pd.DataFrame(tasks)\n",
    "\n",
    "    priority_order = {\n",
    "        \"High\": 0,\n",
    "        \"Medium\": 1,\n",
    "        \"Low\": 2\n",
    "    }\n",
    "\n",
    "    df[\"Priority Rank\"] = df[\"Priority\"].map(priority_order)\n",
    "\n",
    "    df = df.sort_values(\n",
    "        [\"Due Date\", \"Priority Rank\"]\n",
    "    ).drop(columns=[\"Priority Rank\"])\n",
    "\n",
    "    display(df)\n",
    "\n",
    "\n",
    "def complete_followup(task_id):\n",
    "    \"\"\"\n",
    "    Mark a follow-up task as completed.\n",
    "    \"\"\"\n",
    "\n",
    "    records = followups_sheet.get_all_records()\n",
    "\n",
    "    for row_number, record in enumerate(records, start=2):\n",
    "        if str(record[\"Task ID\"]) == str(task_id):\n",
    "\n",
    "            followups_sheet.update(\n",
    "                range_name=f\"I{row_number}:J{row_number}\",\n",
    "                values=[[\n",
    "                    \"Completed\",\n",
    "                    crm_today().isoformat()\n",
    "                ]]\n",
    "            )\n",
    "\n",
    "            print(\"✓ Follow-up completed:\", task_id)\n",
    "            return\n",
    "\n",
    "    print(\"⚠ Task ID not found.\")\n",
    "\n",
    "\n",
    "print(\"✓ Follow-up management installed!\")\n",
    "print(\"✓ Central Time configured!\")\n",
    "print(\"✓ Task creation enabled!\")\n",
    "print(\"✓ Overdue task detection enabled!\")\n",
    "print(\"✓ Task completion enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": [
    "# STEP 013 — Sales Opportunity Pipeline\n",
    "opportunities_sheet = spreadsheet.worksheet(\"Opportunities\")\n",
    "\n",
    "# Sales stages and their initial estimated probabilities\n",
    "stage_probabilities = {\n",
    "    \"Target identified\": 5,\n",
    "    \"First contact attempted\": 10,\n",
    "    \"Stakeholder identified\": 15,\n",
    "    \"Conversation scheduled\": 25,\n",
    "    \"Discovery completed\": 40,\n",
    "    \"Qualified opportunity\": 55,\n",
    "    \"Proposal sent\": 70,\n",
    "    \"Decision pending\": 80,\n",
    "    \"Won\": 100,\n",
    "    \"Lost\": 0,\n",
    "    \"Nurture\": 10,\n",
    "    \"Project active\": 100,\n",
    "    \"Continuing-service opportunity\": 50\n",
    "}\n",
    "\n",
    "def create_opportunity(\n",
    "    company_id,\n",
    "    opportunity_name,\n",
    "    service_interest,\n",
    "    estimated_value,\n",
    "    contact_id=\"\",\n",
    "    pipeline_stage=\"Target identified\",\n",
    "    tags=None,\n",
    "    expected_close_date=\"\",\n",
    "    notes=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Create a new sales opportunity and calculate\n",
    "    its weighted pipeline value.\n",
    "    \"\"\"\n",
    "\n",
    "    # Verify company exists\n",
    "    companies = companies_sheet.get_all_records()\n",
    "\n",
    "    if not any(\n",
    "        str(c[\"Company ID\"]) == str(company_id)\n",
    "        for c in companies\n",
    "    ):\n",
    "        raise ValueError(\"Company ID does not exist.\")\n",
    "\n",
    "    # Verify stage\n",
    "    if pipeline_stage not in stage_probabilities:\n",
    "        raise ValueError(\"Invalid pipeline stage.\")\n",
    "\n",
    "    # Calculate probability and weighted value\n",
    "    probability = stage_probabilities[pipeline_stage]\n",
    "    weighted_value = float(estimated_value) * probability / 100\n",
    "\n",
    "    # Generate unique opportunity ID\n",
    "    opportunity_id = \"NSA-O-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    # Prepare record\n",
    "    opportunity_record = [\n",
    "        opportunity_id,\n",
    "        company_id,\n",
    "        contact_id,\n",
    "        opportunity_name,\n",
    "        service_interest,\n",
    "        pipeline_stage,\n",
    "        \"Open\",\n",
    "        float(estimated_value),\n",
    "        probability,\n",
    "        weighted_value,\n",
    "        \"\",\n",
    "        crm_today().isoformat(),\n",
    "        expected_close_date,\n",
    "        \"\",\n",
    "        \"\",\n",
    "        \", \".join(tags or []),\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    opportunities_sheet.append_row(\n",
    "        opportunity_record,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Opportunity created!\")\n",
    "    print(\"Opportunity:\", opportunity_name)\n",
    "    print(\"Estimated Value: $\", estimated_value)\n",
    "    print(\"Probability:\", probability, \"%\")\n",
    "    print(\"Weighted Value: $\", weighted_value)\n",
    "\n",
    "    return opportunity_id\n",
    "\n",
    "\n",
    "def update_opportunity_stage(opportunity_id, new_stage):\n",
    "    \"\"\"\n",
    "    Update an opportunity's pipeline stage,\n",
    "    probability, and weighted value.\n",
    "    \"\"\"\n",
    "\n",
    "    if new_stage not in stage_probabilities:\n",
    "        raise ValueError(\"Invalid pipeline stage.\")\n",
    "\n",
    "    records = opportunities_sheet.get_all_records()\n",
    "\n",
    "    for row_number, record in enumerate(records, start=2):\n",
    "\n",
    "        if str(record[\"Opportunity ID\"]) == str(opportunity_id):\n",
    "\n",
    "            probability = stage_probabilities[new_stage]\n",
    "            estimated_value = float(record[\"Estimated Value\"])\n",
    "            weighted_value = estimated_value * probability / 100\n",
    "\n",
    "            if new_stage == \"Won\":\n",
    "                outcome = \"Won\"\n",
    "            elif new_stage == \"Lost\":\n",
    "                outcome = \"Lost\"\n",
    "            elif new_stage == \"Nurture\":\n",
    "                outcome = \"Nurture\"\n",
    "            else:\n",
    "                outcome = \"Open\"\n",
    "\n",
    "            opportunities_sheet.update(\n",
    "                range_name=f\"F{row_number}:J{row_number}\",\n",
    "                values=[[\n",
    "                    new_stage,\n",
    "                    outcome,\n",
    "                    estimated_value,\n",
    "                    probability,\n",
    "                    weighted_value\n",
    "                ]]\n",
    "            )\n",
    "\n",
    "            print(\"✓ Opportunity updated!\")\n",
    "            print(\"New Stage:\", new_stage)\n",
    "            print(\"Weighted Value: $\", weighted_value)\n",
    "\n",
    "            return\n",
    "\n",
    "    print(\"⚠ Opportunity not found.\")\n",
    "\n",
    "\n",
    "print(\"✓ Sales opportunity pipeline installed!\")\n",
    "print(\"✓ Revenue probability calculations enabled!\")\n",
    "print(\"✓ Weighted pipeline tracking enabled!\")\n",
    "print(\"✓ Opportunity stage updates enabled!\")\n"
   ],
