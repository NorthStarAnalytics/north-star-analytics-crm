    "# STEP 031 — Proposal Quality Control\n",
    "review_sheet_name = \"Proposal Reviews\"\n",
    "\n",
    "review_headers = [\n",
    "    \"Proposal ID\",\n",
    "    \"Review Date\",\n",
    "    \"Scope Confirmed\",\n",
    "    \"Deliverables Confirmed\",\n",
    "    \"Timeline Confirmed\",\n",
    "    \"Pricing Confirmed\",\n",
    "    \"Payment Terms Confirmed\",\n",
    "    \"Exclusions Confirmed\",\n",
    "    \"Add-Ons Confirmed\",\n",
    "    \"Client Details Confirmed\",\n",
    "    \"Reviewer Notes\",\n",
    "    \"Review Status\"\n",
    "]\n",
    "\n",
    "try:\n",
    "    review_sheet = spreadsheet.worksheet(review_sheet_name)\n",
    "\n",
    "except gspread.exceptions.WorksheetNotFound:\n",
    "    review_sheet = spreadsheet.add_worksheet(\n",
    "        title=review_sheet_name,\n",
    "        rows=500,\n",
    "        cols=len(review_headers)\n",
    "    )\n",
    "\n",
    "existing_headers = review_sheet.row_values(1)\n",
    "\n",
    "if not any(existing_headers):\n",
    "    review_sheet.update(\n",
    "        range_name=\"A1:L1\",\n",
    "        values=[review_headers],\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "elif existing_headers != review_headers:\n",
    "    raise ValueError(\n",
    "        \"Proposal Reviews headers do not match. \"\n",
    "        \"Existing data has been preserved.\"\n",
    "    )\n",
    "\n",
    "review_sheet.freeze(rows=1)\n",
    "\n",
    "\n",
    "def review_proposal(\n",
    "    proposal_id,\n",
    "    scope_confirmed=False,\n",
    "    deliverables_confirmed=False,\n",
    "    timeline_confirmed=False,\n",
    "    pricing_confirmed=False,\n",
    "    payment_terms_confirmed=False,\n",
    "    exclusions_confirmed=False,\n",
    "    addons_confirmed=False,\n",
    "    client_details_confirmed=False,\n",
    "    reviewer_notes=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Record proposal quality-control review.\n",
    "    A proposal is client-ready only when all eight\n",
    "    review criteria are explicitly confirmed.\n",
    "    \"\"\"\n",
    "\n",
    "    proposals = proposals_sheet.get_all_records()\n",
    "\n",
    "    proposal = next(\n",
    "        (\n",
    "            p for p in proposals\n",
    "            if str(p[\"Proposal ID\"]) == str(proposal_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if proposal is None:\n",
    "        raise ValueError(\"Proposal ID not found.\")\n",
    "\n",
    "    checks = {\n",
    "        \"Scope\": scope_confirmed,\n",
    "        \"Deliverables\": deliverables_confirmed,\n",
    "        \"Timeline\": timeline_confirmed,\n",
    "        \"Pricing\": pricing_confirmed,\n",
    "        \"Payment Terms\": payment_terms_confirmed,\n",
    "        \"Exclusions\": exclusions_confirmed,\n",
    "        \"Add-Ons\": addons_confirmed,\n",
    "        \"Client Details\": client_details_confirmed\n",
    "    }\n",
    "\n",
    "    # Require actual booleans, not truthy strings\n",
    "    if not all(type(value) is bool for value in checks.values()):\n",
    "        raise ValueError(\n",
    "            \"Each review criterion must be True or False.\"\n",
    "        )\n",
    "\n",
    "    all_confirmed = all(checks.values())\n",
    "\n",
    "    status = (\n",
    "        \"Client Ready\"\n",
    "        if all_confirmed\n",
    "        else \"Needs Revision\"\n",
    "    )\n",
    "\n",
    "    row_values = [\n",
    "        proposal_id,\n",
    "        crm_today().isoformat(),\n",
    "        *[\"Yes\" if value else \"No\" for value in checks.values()],\n",
    "        reviewer_notes,\n",
    "        status\n",
    "    ]\n",
    "\n",
    "    existing_reviews = review_sheet.get_all_records()\n",
    "\n",
    "    matching_rows = [\n",
    "        index\n",
    "        for index, record\n",
    "        in enumerate(existing_reviews, start=2)\n",
    "        if str(record[\"Proposal ID\"]) == str(proposal_id)\n",
    "    ]\n",
    "\n",
    "    # Keep one current review record per proposal\n",
    "    if matching_rows:\n",
    "        review_sheet.update(\n",
    "            range_name=f\"A{matching_rows[0]}:L{matching_rows[0]}\",\n",
    "            values=[row_values],\n",
    "            value_input_option=\"RAW\"\n",
    "        )\n",
    "    else:\n",
    "        review_sheet.append_row(\n",
    "            row_values,\n",
    "            value_input_option=\"RAW\"\n",
    "        )\n",
    "\n",
    "    print(\"\\nNORTH STAR ANALYTICS\")\n",
    "    print(\"PROPOSAL QUALITY CONTROL\")\n",
    "    print(\"-\" * 45)\n",
    "    print(\"Proposal:\", proposal_id)\n",
    "\n",
    "    for item, confirmed in checks.items():\n",
    "        symbol = \"✓\" if confirmed else \"✗\"\n",
    "        print(f\"{symbol} {item}\")\n",
    "\n",
    "    print(\"\\nReview Status:\", status)\n",
    "\n",
    "    if all_confirmed:\n",
    "        print(\"✓ All eight review criteria confirmed.\")\n",
    "        print(\"✓ Proposal approved as client-ready.\")\n",
    "    else:\n",
    "        print(\"Proposal requires additional review.\")\n",
    "\n",
    "    print(\"\\nCRM proposal status was not changed.\")\n",
    "    print(\"No document was sent.\")\n",
    "\n",
    "    return status\n",
    "\n",
    "\n",
    "def show_proposal_review_status(proposal_id):\n",
    "    \"\"\"\n",
    "    Retrieve the latest stored quality-control review.\n",
    "    \"\"\"\n",
    "\n",
    "    records = review_sheet.get_all_records()\n",
    "\n",
    "    matches = [\n",
    "        r for r in records\n",
    "        if str(r[\"Proposal ID\"]) == str(proposal_id)\n",
    "    ]\n",
    "\n",
    "    if not matches:\n",
    "        print(\"No review recorded for this proposal.\")\n",
    "        return None\n",
    "\n",
    "    review = matches[-1]\n",
    "\n",
    "    print(\"Proposal:\", proposal_id)\n",
    "    print(\"Review Date:\", review[\"Review Date\"])\n",
    "    print(\"Review Status:\", review[\"Review Status\"])\n",
    "\n",
    "    return review\n",
    "\n",
    "\n",
    "print(\"✓ Proposal quality-control system installed!\")\n",
    "print(\"✓ Eight review checkpoints configured!\")\n",
    "print(\"✓ Client-ready approval controls enabled!\")\n",
    "print(\"✓ Proposal review tracking enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
