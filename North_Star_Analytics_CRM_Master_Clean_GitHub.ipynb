    "# STEP 030 — Proposal Document Generator\n",
    "\n",
    "PROPOSAL_FOLDER = CRM_ROOT / \"04_Proposals\"\n",
    "PROPOSAL_FOLDER.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "NAVY = RGBColor(20, 37, 68)\n",
    "COBALT = RGBColor(36, 93, 185)\n",
    "\n",
    "\n",
    "def proposal_list(value):\n",
    "    \"\"\"Read JSON lists or ordinary text from CRM cells.\"\"\"\n",
    "\n",
    "    if value is None or str(value).strip() == \"\":\n",
    "        return []\n",
    "\n",
    "    try:\n",
    "        parsed = json.loads(str(value))\n",
    "        if isinstance(parsed, list):\n",
    "            return [\n",
    "                str(item).strip()\n",
    "                for item in parsed\n",
    "                if str(item).strip()\n",
    "            ]\n",
    "    except (json.JSONDecodeError, TypeError):\n",
    "        pass\n",
    "\n",
    "    return [\n",
    "        line.strip(\" •-\")\n",
    "        for line in str(value).splitlines()\n",
    "        if line.strip()\n",
    "    ]\n",
    "\n",
    "\n",
    "def generate_proposal_document(proposal_id):\n",
    "    \"\"\"\n",
    "    Generate a client-facing Word proposal from an\n",
    "    existing CRM proposal record.\n",
    "\n",
    "    The proposal is saved to Google Drive.\n",
    "    No CRM statuses are changed.\n",
    "    \"\"\"\n",
    "\n",
    "    proposals = proposals_sheet.get_all_records()\n",
    "    companies = companies_sheet.get_all_records()\n",
    "\n",
    "    proposal = next(\n",
    "        (\n",
    "            p for p in proposals\n",
    "            if str(p[\"Proposal ID\"]) == str(proposal_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if proposal is None:\n",
    "        raise ValueError(\"Proposal ID not found.\")\n",
    "\n",
    "    company = next(\n",
    "        (\n",
    "            c for c in companies\n",
    "            if str(c[\"Company ID\"])\n",
    "            == str(proposal[\"Company ID\"])\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if company is None:\n",
    "        raise ValueError(\"Associated company not found.\")\n",
    "\n",
    "    # Validate proposal amounts\n",
    "    try:\n",
    "        base = Decimal(str(proposal[\"Base Price\"]))\n",
    "        addons = Decimal(str(proposal[\"Add-On Price\"]))\n",
    "        total = Decimal(str(proposal[\"Total Price\"]))\n",
    "    except (InvalidOperation, TypeError):\n",
    "        raise ValueError(\"Proposal contains invalid pricing.\")\n",
    "\n",
    "    if not all(\n",
    "        amount.is_finite() and amount >= 0\n",
    "        for amount in [base, addons, total]\n",
    "    ):\n",
    "        raise ValueError(\"Proposal contains invalid pricing.\")\n",
    "\n",
    "    if abs((base + addons) - total) > Decimal(\"0.01\"):\n",
    "        raise ValueError(\n",
    "            \"Proposal total does not match base and add-on prices.\"\n",
    "        )\n",
    "\n",
    "    doc = Document()\n",
    "\n",
    "    section = doc.sections[0]\n",
    "    section.top_margin = Inches(0.8)\n",
    "    section.bottom_margin = Inches(0.8)\n",
    "    section.left_margin = Inches(0.85)\n",
    "    section.right_margin = Inches(0.85)\n",
    "\n",
    "    normal = doc.styles[\"Normal\"]\n",
    "    normal.font.name = \"Aptos\"\n",
    "    normal.font.size = Pt(10)\n",
    "    normal.paragraph_format.space_after = Pt(7)\n",
    "\n",
    "    for style_name in [\"Heading 1\", \"Heading 2\"]:\n",
    "        style = doc.styles[style_name]\n",
    "        style.font.name = \"Aptos\"\n",
    "        style.font.color.rgb = NAVY\n",
    "\n",
    "    # Cover / heading\n",
    "    heading = doc.add_paragraph()\n",
    "    heading.style = doc.styles[\"Title\"]\n",
    "\n",
    "    run = heading.add_run(\"NORTH STAR ANALYTICS\")\n",
    "    run.bold = True\n",
    "    run.font.color.rgb = NAVY\n",
    "    run.font.size = Pt(22)\n",
    "\n",
    "    subtitle = doc.add_paragraph(\n",
    "        \"BUSINESS OPERATIONS & DATA ANALYTICS CONSULTING\"\n",
    "    )\n",
    "    subtitle.runs[0].font.color.rgb = COBALT\n",
    "    subtitle.runs[0].font.size = Pt(10)\n",
    "\n",
    "    doc.add_paragraph(\"\")\n",
    "\n",
    "    doc.add_heading(\"Consulting Proposal\", level=1)\n",
    "\n",
    "    info = doc.add_table(rows=4, cols=2)\n",
    "    info.style = \"Light Shading Accent 1\"\n",
    "\n",
    "    details = [\n",
    "        (\"Prepared For\", str(company[\"Company Name\"])),\n",
    "        (\"Proposal ID\", str(proposal_id)),\n",
    "        (\"Proposal Date\", str(proposal[\"Proposal Date\"])),\n",
    "        (\"Proposal Status\", str(proposal[\"Status\"]))\n",
    "    ]\n",
    "\n",
    "    for row, (label, value) in zip(info.rows, details):\n",
    "        row.cells[0].text = label\n",
    "        row.cells[1].text = value\n",
    "\n",
    "    doc.add_paragraph(\"\")\n",
    "\n",
    "    # Services\n",
    "    doc.add_heading(\"1. Proposed Services\", level=1)\n",
    "\n",
    "    services = proposal_list(proposal[\"Service Package\"])\n",
    "\n",
    "    if services:\n",
    "        for service in services:\n",
    "            doc.add_paragraph(service, style=\"List Bullet\")\n",
    "    else:\n",
    "        doc.add_paragraph(\"Services pending final confirmation.\")\n",
    "\n",
    "    # Scope\n",
    "    doc.add_heading(\"2. Scope of Work\", level=1)\n",
    "\n",
    "    scope_items = proposal_list(proposal[\"Scope\"])\n",
    "\n",
    "    if scope_items:\n",
    "        for item in scope_items:\n",
    "            doc.add_paragraph(item, style=\"List Bullet\")\n",
    "    else:\n",
    "        doc.add_paragraph(\"Scope pending final confirmation.\")\n",
    "\n",
    "    # Exclusions\n",
    "    doc.add_heading(\"3. Exclusions & Scope Boundaries\", level=1)\n",
    "\n",
    "    exclusions = proposal_list(proposal[\"Exclusions\"])\n",
    "\n",
    "    if exclusions:\n",
    "        for item in exclusions:\n",
    "            doc.add_paragraph(item, style=\"List Bullet\")\n",
    "    else:\n",
    "        doc.add_paragraph(\n",
    "            \"Exclusions must be confirmed before this proposal is issued.\"\n",
    "        )\n",
    "\n",
    "    # Pricing\n",
    "    doc.add_heading(\"4. Project Investment\", level=1)\n",
    "\n",
    "    pricing = doc.add_table(rows=3, cols=2)\n",
    "    pricing.style = \"Light Shading Accent 1\"\n",
    "\n",
    "    pricing_rows = [\n",
    "        (\"Base Consulting Services\", base),\n",
    "        (\"Additional Services / Add-Ons\", addons),\n",
    "        (\"Total Proposed Investment\", total)\n",
    "    ]\n",
    "\n",
    "    for row, (label, amount) in zip(pricing.rows, pricing_rows):\n",
    "        row.cells[0].text = label\n",
    "        row.cells[1].text = f\"${amount:,.2f}\"\n",
    "\n",
    "    # Next steps\n",
    "    doc.add_heading(\"5. Review & Next Steps\", level=1)\n",
    "\n",
    "    doc.add_paragraph(\n",
    "        \"This proposal is provided for review and discussion. \"\n",
    "        \"Final deliverables, project timelines, payment terms, \"\n",
    "        \"and responsibilities will be confirmed in a mutually \"\n",
    "        \"approved agreement before work begins.\"\n",
    "    )\n",
    "\n",
    "    doc.add_paragraph(\n",
    "        \"Services or deliverables outside the approved scope \"\n",
    "        \"require separate written authorization.\"\n",
    "    )\n",
    "\n",
    "    # Footer\n",
    "    footer = section.footer.paragraphs[0]\n",
    "    footer.text = (\n",
    "        f\"North Star Analytics | Proposal {proposal_id} \"\n",
    "        \"| Confidential\"\n",
    "    )\n",
    "    footer.style = doc.styles[\"Normal\"]\n",
    "\n",
    "    # Safe filename\n",
    "    safe_company = re.sub(\n",
    "        r\"[^A-Za-z0-9_-]+\",\n",
    "        \"_\",\n",
    "        str(company[\"Company Name\"])\n",
    "    ).strip(\"_\")[:60] or \"Client\"\n",
    "\n",
    "    filename = f\"{safe_company}_{proposal_id}_Proposal.docx\"\n",
    "\n",
    "    filepath = PROPOSAL_FOLDER / filename\n",
    "\n",
    "    # Avoid silently overwriting an existing proposal\n",
    "    if filepath.exists():\n",
    "        raise FileExistsError(\n",
    "            f\"Document already exists: {filepath}. \"\n",
    "            \"Review or rename the existing file before regenerating.\"\n",
    "        )\n",
    "\n",
    "    doc.save(filepath)\n",
    "\n",
    "    print(\"\\n✓ Proposal document generated!\")\n",
    "    print(\"Company:\", company[\"Company Name\"])\n",
    "    print(\"Proposal ID:\", proposal_id)\n",
    "    print(\"Total Investment:\", f\"${total:,.2f}\")\n",
    "    print(\"Saved to:\", filepath)\n",
    "    print(\"\\nReview the document before sharing it with a client.\")\n",
    "\n",
    "    return filepath\n",
    "\n",
    "\n",
    "print(\"✓ Proposal document generator installed!\")\n",
    "print(\"✓ North Star Analytics branding configured!\")\n",
    "print(\"✓ Google Drive proposal folder connected!\")\n",
    "print(\"✓ Pricing validation enabled!\")\n",
    "print(\"✓ Existing documents protected from overwrite!\")\n"
