    "# STEP 044 — Outreach Goal Repair Utility\n",
    "# North Star Analytics CRM\n",
    "\n",
    "def restore_outreach_goals():\n",
    "\n",
    "    ws = spreadsheet.worksheet(\"Outreach Goals\")\n",
    "\n",
    "    expected_headers = [\n",
    "        \"Activity Type\",\n",
    "        \"Daily Goal\",\n",
    "        \"Weekly Goal\",\n",
    "        \"Active\",\n",
    "        \"Notes\"\n",
    "    ]\n",
    "\n",
    "    current_headers = ws.row_values(1)\n",
    "\n",
    "    if not current_headers:\n",
    "        ws.append_row(expected_headers)\n",
    "        current_headers = expected_headers\n",
    "\n",
    "    if current_headers != expected_headers:\n",
    "        raise ValueError(\n",
    "            \"Outreach Goals headers differ from the \"\n",
    "            \"expected structure. Review before updating.\"\n",
    "        )\n",
    "\n",
    "    expected_goals = [\n",
    "        [\"Phone\", 10, 50, \"Yes\", \"Prospect calls\"],\n",
    "        [\"Email\", 10, 50, \"Yes\", \"Personalized outreach\"],\n",
    "        [\"LinkedIn\", 5, 25, \"Yes\", \"Professional networking\"],\n",
    "        [\"In-Person\", 2, 10, \"Yes\", \"Business visits\"],\n",
    "        [\"Video\", 1, 5, \"Yes\", \"Video introductions\"],\n",
    "        [\"Referral\", 2, 10, \"Yes\", \"Referral outreach\"]\n",
    "    ]\n",
    "\n",
    "    existing = ws.get_all_records()\n",
    "\n",
    "    existing_types = {\n",
    "        str(row[\"Activity Type\"]).strip().lower()\n",
    "        for row in existing\n",
    "    }\n",
    "\n",
    "    new_rows = [\n",
    "        row for row in expected_goals\n",
    "        if row[0].lower() not in existing_types\n",
    "    ]\n",
    "\n",
    "    if new_rows:\n",
    "        ws.append_rows(\n",
    "            new_rows,\n",
    "            value_input_option=\"RAW\"\n",
    "        )\n",
    "\n",
    "    print(\"=\" * 55)\n",
    "    print(\"NORTH STAR ANALYTICS — OUTREACH GOALS\")\n",
    "    print(\"=\" * 55)\n",
    "\n",
    "    print(f\"\\nNew goals added: {len(new_rows)}\")\n",
    "\n",
    "    final_goals = ws.get_all_records()\n",
    "\n",
    "    display(pd.DataFrame(final_goals))\n",
    "\n",
    "    print(\"\\n✓ Outreach goals verified!\")\n",
    "    print(\"✓ Existing goal records preserved!\")\n",
    "    print(\"✓ Duplicate activity types avoided!\")\n",
    "\n",
    "    return final_goals\n",
    "\n",
    "\n",
    "outreach_goals = restore_outreach_goals()\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
