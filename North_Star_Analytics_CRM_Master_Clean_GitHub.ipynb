   "source": [
    "# STEP 022 — Outreach Goals and Reporting\n",
    "# Create or open outreach goals worksheet\n",
    "try:\n",
    "    outreach_goals_sheet = spreadsheet.worksheet(\"Outreach Goals\")\n",
    "except gspread.exceptions.WorksheetNotFound:\n",
    "    outreach_goals_sheet = spreadsheet.add_worksheet(\n",
    "        title=\"Outreach Goals\",\n",
    "        rows=100,\n",
    "        cols=5\n",
    "    )\n",
    "\n",
    "goal_headers = [\n",
    "    \"Activity Type\",\n",
    "    \"Daily Goal\",\n",
    "    \"Weekly Goal\",\n",
    "    \"Active\",\n",
    "    \"Notes\"\n",
    "]\n",
    "\n",
    "# Only initialize an empty worksheet\n",
    "if not outreach_goals_sheet.get_all_values():\n",
    "    outreach_goals_sheet.append_row(goal_headers)\n",
    "\n",
    "    default_goals = [\n",
    "        [\"Phone Call\", 10, 50, \"Yes\", \"Prospecting and follow-up calls\"],\n",
    "        [\"Email\", 10, 50, \"Yes\", \"Personalized business outreach\"],\n",
    "        [\"LinkedIn\", 5, 25, \"Yes\", \"Professional networking\"],\n",
    "        [\"In-Person Visit\", 2, 10, \"Yes\", \"Local business outreach\"],\n",
    "        [\"Video Meeting\", 1, 5, \"Yes\", \"Discovery or sales meetings\"],\n",
    "        [\"Referral\", 2, 10, \"Yes\", \"Referral partner outreach\"]\n",
    "    ]\n",
    "\n",
    "    outreach_goals_sheet.append_rows(\n",
    "        default_goals,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "outreach_goals_sheet.freeze(rows=1)\n",
    "\n",
    "positive_outcomes = [\n",
    "    \"Positive Response\",\n",
    "    \"Interested\",\n",
    "    \"Meeting Scheduled\",\n",
    "    \"Discovery Scheduled\",\n",
    "    \"Proposal Requested\"\n",
    "]\n",
    "\n",
    "meeting_outcomes = [\n",
    "    \"Meeting Scheduled\",\n",
    "    \"Discovery Scheduled\"\n",
    "]\n",
    "\n",
    "\n",
    "def show_daily_outreach_report(report_date=None):\n",
    "    \"\"\"Compare daily sales activities with outreach goals.\"\"\"\n",
    "\n",
    "    if report_date is None:\n",
    "        report_date = crm_today()\n",
    "    elif isinstance(report_date, str):\n",
    "        report_date = date.fromisoformat(report_date)\n",
    "\n",
    "    activities = activities_sheet.get_all_records()\n",
    "    goals = outreach_goals_sheet.get_all_records()\n",
    "\n",
    "    daily_activities = [\n",
    "        a for a in activities\n",
    "        if str(a[\"Activity Date\"]).strip()\n",
    "        == report_date.isoformat()\n",
    "        and str(a[\"Direction\"]).strip() == \"Outbound\"\n",
    "    ]\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for goal in goals:\n",
    "        if str(goal[\"Active\"]).strip().lower() != \"yes\":\n",
    "            continue\n",
    "\n",
    "        activity_type = str(goal[\"Activity Type\"]).strip()\n",
    "        target = int(goal[\"Daily Goal\"] or 0)\n",
    "\n",
    "        actual = sum(\n",
    "            str(a[\"Activity Type\"]).strip() == activity_type\n",
    "            for a in daily_activities\n",
    "        )\n",
    "\n",
    "        completion = (\n",
    "            round(actual / target * 100, 1)\n",
    "            if target > 0 else 0\n",
    "        )\n",
    "\n",
    "        rows.append({\n",
    "            \"Activity Type\": activity_type,\n",
    "            \"Daily Goal\": target,\n",
    "            \"Completed\": actual,\n",
    "            \"Remaining\": max(target - actual, 0),\n",
    "            \"Goal Completion %\": completion\n",
    "        })\n",
    "\n",
    "    print(\"NORTH STAR ANALYTICS\")\n",
    "    print(\"DAILY OUTREACH REPORT\")\n",
    "    print(\"Date:\", report_date.isoformat())\n",
    "    print(\"-\" * 50)\n",
    "\n",
    "    if rows:\n",
    "        display(pd.DataFrame(rows))\n",
    "    else:\n",
    "        print(\"No active outreach goals configured.\")\n",
    "\n",
    "    unique_companies = len({\n",
    "        str(a[\"Company ID\"])\n",
    "        for a in daily_activities\n",
    "        if str(a[\"Company ID\"]).strip()\n",
    "    })\n",
    "\n",
    "    positive = sum(\n",
    "        str(a[\"Outcome\"]).strip() in positive_outcomes\n",
    "        for a in daily_activities\n",
    "    )\n",
    "\n",
    "    meetings = sum(\n",
    "        str(a[\"Outcome\"]).strip() in meeting_outcomes\n",
    "        for a in daily_activities\n",
    "    )\n",
    "\n",
    "    print(\"Outbound Activities:\", len(daily_activities))\n",
    "    print(\"Unique Companies Contacted:\", unique_companies)\n",
    "    print(\"Positive Outcomes:\", positive)\n",
    "    print(\"Meetings Scheduled:\", meetings)\n",
    "\n",
    "    return rows\n",
    "\n",
    "\n",
    "def show_weekly_outreach_report(week_start=None):\n",
    "    \"\"\"Summarize outreach performance Monday through Sunday.\"\"\"\n",
    "\n",
    "    if week_start is None:\n",
    "        today = crm_today()\n",
    "        week_start = today - timedelta(days=today.weekday())\n",
    "    elif isinstance(week_start, str):\n",
    "        week_start = date.fromisoformat(week_start)\n",
    "\n",
    "    week_end = week_start + timedelta(days=6)\n",
    "\n",
    "    activities = activities_sheet.get_all_records()\n",
    "    goals = outreach_goals_sheet.get_all_records()\n",
    "\n",
    "    weekly_activities = []\n",
    "\n",
    "    for activity in activities:\n",
    "        try:\n",
    "            activity_date = date.fromisoformat(\n",
    "                str(activity[\"Activity Date\"]).strip()\n",
    "            )\n",
    "        except ValueError:\n",
    "            continue\n",
    "\n",
    "        if (\n",
    "            week_start <= activity_date <= week_end\n",
    "            and str(activity[\"Direction\"]).strip() == \"Outbound\"\n",
    "        ):\n",
    "            weekly_activities.append(activity)\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for goal in goals:\n",
    "        if str(goal[\"Active\"]).strip().lower() != \"yes\":\n",
    "            continue\n",
    "\n",
    "        activity_type = str(goal[\"Activity Type\"]).strip()\n",
    "        target = int(goal[\"Weekly Goal\"] or 0)\n",
    "\n",
    "        actual = sum(\n",
    "            str(a[\"Activity Type\"]).strip() == activity_type\n",
    "            for a in weekly_activities\n",
    "        )\n",
    "\n",
    "        rows.append({\n",
    "            \"Activity Type\": activity_type,\n",
    "            \"Weekly Goal\": target,\n",
    "            \"Completed\": actual,\n",
    "            \"Remaining\": max(target - actual, 0),\n",
    "            \"Goal Completion %\": (\n",
    "                round(actual / target * 100, 1)\n",
    "                if target > 0 else 0\n",
    "            )\n",
    "        })\n",
    "\n",
    "    print(\"NORTH STAR ANALYTICS\")\n",
    "    print(\"WEEKLY OUTREACH REPORT\")\n",
    "    print(f\"{week_start} through {week_end}\")\n",
    "    print(\"-\" * 50)\n",
    "\n",
    "    if rows:\n",
    "        display(pd.DataFrame(rows))\n",
    "    else:\n",
    "        print(\"No active outreach goals configured.\")\n",
    "\n",
    "    print(\"Total Outbound Activities:\", len(weekly_activities))\n",
    "\n",
    "    return rows\n",
    "\n",
    "\n",
    "print(\"✓ Outreach goals worksheet configured!\")\n",
    "print(\"✓ Daily outreach reporting enabled!\")\n",
    "print(\"✓ Weekly outreach reporting enabled!\")\n",
    "print(\"✓ Prospecting performance tracking enabled!\")\n"
   ],
