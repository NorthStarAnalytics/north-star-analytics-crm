    "# STEP 026 — Transfer Discovery Findings\n",
    "def transfer_interview_findings(interview_id):\n",
    "    \"\"\"\n",
    "    Transfer documented interview findings into Discovery.\n",
    "    Avoid duplicate transfers using an interview/question\n",
    "    reference stored in the Discovery Notes column.\n",
    "    \"\"\"\n",
    "\n",
    "    interviews = interview_sheet.get_all_records()\n",
    "    discovery_records = discovery_sheet.get_all_records()\n",
    "    question_records = question_library_sheet.get_all_records()\n",
    "\n",
    "    question_lookup = {\n",
    "        str(q[\"Question ID\"]): q\n",
    "        for q in question_records\n",
    "    }\n",
    "\n",
    "    matches = [\n",
    "        (row_number, record)\n",
    "        for row_number, record in enumerate(interviews, start=2)\n",
    "        if str(record[\"Interview ID\"]) == str(interview_id)\n",
    "    ]\n",
    "\n",
    "    if not matches:\n",
    "        raise ValueError(\"Interview ID not found.\")\n",
    "\n",
    "    transferred = []\n",
    "    skipped = []\n",
    "\n",
    "    for row_number, record in matches:\n",
    "\n",
    "        question_id = str(record[\"Question ID\"])\n",
    "        client_response = str(record[\"Client Response\"]).strip()\n",
    "        pain_point = str(record[\"Identified Pain Point\"]).strip()\n",
    "\n",
    "        # Require both an answer and an identified problem\n",
    "        if not client_response or not pain_point:\n",
    "            skipped.append(question_id)\n",
    "            continue\n",
    "\n",
    "        reference = f\"InterviewRef:{interview_id}:{question_id}\"\n",
    "\n",
    "        # Check whether finding was already transferred\n",
    "        already_transferred = any(\n",
    "            reference in str(d[\"Notes\"])\n",
    "            for d in discovery_records\n",
    "        )\n",
    "\n",
    "        if already_transferred:\n",
    "            skipped.append(question_id)\n",
    "            continue\n",
    "\n",
    "        question = question_lookup.get(question_id, {})\n",
    "\n",
    "        technical_question = question.get(\n",
    "            \"Technical Analysis Question\", \"\"\n",
    "        )\n",
    "\n",
    "        required_data = question.get(\"Required Data\", \"\")\n",
    "        suggested_kpi = question.get(\"Suggested KPI\", \"\")\n",
    "        recommended_service = question.get(\n",
    "            \"Recommended Service\", \"\"\n",
    "        )\n",
    "\n",
    "        notes = (\n",
    "            f\"{reference}\\n\"\n",
    "            f\"Business Question: {record['Business Question']}\\n\"\n",
    "            f\"Client Response: {client_response}\\n\"\n",
    "            f\"Technical Analysis: {technical_question}\\n\"\n",
    "            f\"Required Data: {required_data}\\n\"\n",
    "            f\"Suggested KPI: {suggested_kpi}\\n\"\n",
    "            f\"Follow-Up Action: {record['Follow-Up Action']}\"\n",
    "        )\n",
    "\n",
    "        # Use existing Step 14 discovery function\n",
    "        discovery_id = create_discovery(\n",
    "            company_id=record[\"Company ID\"],\n",
    "            contact_id=record[\"Contact ID\"],\n",
    "            department=record[\"Department\"],\n",
    "            current_process=record[\"Business Question\"],\n",
    "            pain_point=pain_point,\n",
    "            business_impact=record[\"Business Impact\"],\n",
    "            available_data=record[\"Available Data\"] or required_data,\n",
    "            current_kpi=suggested_kpi,\n",
    "            recommended_service=recommended_service,\n",
    "            notes=notes\n",
    "        )\n",
    "\n",
    "        # Update in-memory records to prevent duplicates\n",
    "        # within the same execution\n",
    "        discovery_records.append({\"Notes\": notes})\n",
    "\n",
    "        # Mark interview question completed\n",
    "        interview_sheet.update(\n",
    "            range_name=f\"M{row_number}\",\n",
    "            values=[[\"Completed\"]]\n",
    "        )\n",
    "\n",
    "        transferred.append({\n",
    "            \"Question ID\": question_id,\n",
    "            \"Discovery ID\": discovery_id,\n",
    "            \"Pain Point\": pain_point,\n",
    "            \"Recommended Service\": recommended_service\n",
    "        })\n",
    "\n",
    "    print(\"\\nNORTH STAR ANALYTICS\")\n",
    "    print(\"DISCOVERY INTERVIEW TRANSFER SUMMARY\")\n",
    "    print(\"-\" * 50)\n",
    "    print(\"Interview ID:\", interview_id)\n",
    "    print(\"Findings Transferred:\", len(transferred))\n",
    "    print(\"Questions Skipped:\", len(skipped))\n",
    "\n",
    "    if transferred:\n",
    "        display(pd.DataFrame(transferred))\n",
    "\n",
    "    print(\"\\n✓ Interview transfer complete!\")\n",
    "\n",
    "    return transferred\n",
    "\n",
    "\n",
    "def show_interview_findings(interview_id):\n",
    "    \"\"\"\n",
    "    Preview documented findings before transferring them.\n",
    "    Does not modify CRM records.\n",
    "    \"\"\"\n",
    "\n",
    "    interviews = interview_sheet.get_all_records()\n",
    "\n",
    "    findings = [\n",
    "        r for r in interviews\n",
    "        if str(r[\"Interview ID\"]) == str(interview_id)\n",
    "        and str(r[\"Client Response\"]).strip()\n",
    "        and str(r[\"Identified Pain Point\"]).strip()\n",
    "    ]\n",
    "\n",
    "    if not findings:\n",
    "        print(\"No documented findings available.\")\n",
    "        return []\n",
    "\n",
    "    df = pd.DataFrame(findings)\n",
    "\n",
    "    display(df[[\n",
    "        \"Question ID\",\n",
    "        \"Business Question\",\n",
    "        \"Client Response\",\n",
    "        \"Identified Pain Point\",\n",
    "        \"Business Impact\",\n",
    "        \"Available Data\",\n",
    "        \"Follow-Up Action\"\n",
    "    ]])\n",
    "\n",
    "    return findings\n",
    "\n",
    "\n",
    "print(\"✓ Interview-to-CRM transfer installed!\")\n",
    "print(\"✓ Duplicate transfer protection enabled!\")\n",
    "print(\"✓ Discovery findings preview enabled!\")\n",
    "print(\"✓ Interview status updates enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
