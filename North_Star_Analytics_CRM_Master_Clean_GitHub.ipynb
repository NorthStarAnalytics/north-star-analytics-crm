    "# STEP 025 — Discovery Interview Builder\n",
    "interview_sheet_name = \"Discovery Interviews\"\n",
    "\n",
    "interview_headers = [\n",
    "    \"Interview ID\",\n",
    "    \"Company ID\",\n",
    "    \"Contact ID\",\n",
    "    \"Interview Date\",\n",
    "    \"Department\",\n",
    "    \"Question ID\",\n",
    "    \"Business Question\",\n",
    "    \"Client Response\",\n",
    "    \"Identified Pain Point\",\n",
    "    \"Business Impact\",\n",
    "    \"Available Data\",\n",
    "    \"Follow-Up Action\",\n",
    "    \"Status\"\n",
    "]\n",
    "\n",
    "try:\n",
    "    interview_sheet = spreadsheet.worksheet(interview_sheet_name)\n",
    "except gspread.exceptions.WorksheetNotFound:\n",
    "    interview_sheet = spreadsheet.add_worksheet(\n",
    "        title=interview_sheet_name,\n",
    "        rows=500,\n",
    "        cols=len(interview_headers)\n",
    "    )\n",
    "\n",
    "# Initialize headers without deleting existing interviews\n",
    "existing_header = interview_sheet.row_values(1)\n",
    "\n",
    "if not any(existing_header):\n",
    "    interview_sheet.update(\n",
    "        range_name=\"A1\",\n",
    "        values=[interview_headers],\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "elif existing_header != interview_headers:\n",
    "    raise ValueError(\n",
    "        \"Discovery Interviews headers do not match. \"\n",
    "        \"Existing data has been preserved.\"\n",
    "    )\n",
    "\n",
    "interview_sheet.freeze(rows=1)\n",
    "\n",
    "\n",
    "def create_discovery_interview(\n",
    "    company_id,\n",
    "    department,\n",
    "    contact_id=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Generate a structured dealership discovery interview\n",
    "    from the existing question library.\n",
    "    \"\"\"\n",
    "\n",
    "    # Validate company\n",
    "    companies = companies_sheet.get_all_records()\n",
    "\n",
    "    company = next(\n",
    "        (\n",
    "            c for c in companies\n",
    "            if str(c[\"Company ID\"]) == str(company_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if company is None:\n",
    "        raise ValueError(\"Company ID not found.\")\n",
    "\n",
    "    # Validate contact belongs to company\n",
    "    if contact_id:\n",
    "        contacts = contacts_sheet.get_all_records()\n",
    "\n",
    "        if not any(\n",
    "            str(c[\"Contact ID\"]) == str(contact_id)\n",
    "            and str(c[\"Company ID\"]) == str(company_id)\n",
    "            for c in contacts\n",
    "        ):\n",
    "            raise ValueError(\n",
    "                \"Contact does not belong to this company.\"\n",
    "            )\n",
    "\n",
    "    # Retrieve questions for selected department\n",
    "    questions = [\n",
    "        q for q in question_library_sheet.get_all_records()\n",
    "        if str(q[\"Department\"]).strip().lower()\n",
    "        == department.strip().lower()\n",
    "    ]\n",
    "\n",
    "    if not questions:\n",
    "        raise ValueError(\n",
    "            \"No questions found for that department.\"\n",
    "        )\n",
    "\n",
    "    # Generate one ID shared by the entire interview\n",
    "    interview_id = \"NSA-I-\" + uuid4().hex[:12].upper()\n",
    "    interview_date = crm_today().isoformat()\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for question in questions:\n",
    "        rows.append([\n",
    "            interview_id,\n",
    "            company_id,\n",
    "            contact_id,\n",
    "            interview_date,\n",
    "            department,\n",
    "            question[\"Question ID\"],\n",
    "            question[\"Business Question\"],\n",
    "            \"\",  # Client response\n",
    "            \"\",  # Identified pain point\n",
    "            \"\",  # Business impact\n",
    "            \"\",  # Available data\n",
    "            \"\",  # Follow-up action\n",
    "            \"Not Started\"\n",
    "        ])\n",
    "\n",
    "    interview_sheet.append_rows(\n",
    "        rows,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    print(\"✓ Discovery interview created!\")\n",
    "    print(\"Interview ID:\", interview_id)\n",
    "    print(\"Company:\", company[\"Company Name\"])\n",
    "    print(\"Department:\", department)\n",
    "    print(\"Questions:\", len(rows))\n",
    "    print(\"Status: Not Started\")\n",
    "    print()\n",
    "    print(\"Open the 'Discovery Interviews' tab to enter answers.\")\n",
    "\n",
    "    return interview_id\n",
    "\n",
    "\n",
    "def show_discovery_interview(interview_id):\n",
    "    \"\"\"\n",
    "    Display an existing discovery interview\n",
    "    and its recorded responses.\n",
    "    \"\"\"\n",
    "\n",
    "    records = interview_sheet.get_all_records()\n",
    "\n",
    "    matches = [\n",
    "        r for r in records\n",
    "        if str(r[\"Interview ID\"]) == str(interview_id)\n",
    "    ]\n",
    "\n",
    "    if not matches:\n",
    "        print(\"Interview ID not found.\")\n",
    "        return\n",
    "\n",
    "    df = pd.DataFrame(matches)\n",
    "\n",
    "    display(df[[\n",
    "        \"Question ID\",\n",
    "        \"Business Question\",\n",
    "        \"Client Response\",\n",
    "        \"Identified Pain Point\",\n",
    "        \"Business Impact\",\n",
    "        \"Follow-Up Action\",\n",
    "        \"Status\"\n",
    "    ]])\n",
    "\n",
    "\n",
    "print(\"✓ Discovery interview system installed!\")\n",
    "print(\"✓ Interview worksheet configured!\")\n",
    "print(\"✓ Company and contact validation enabled!\")\n",
    "print(\"✓ Department question selection enabled!\")\n",
    "print(\"✓ Interview retrieval enabled!\")\n",
    "\n"
   ],
