   "outputs": []
  },
  {
   "cell_type": "code",
   "source": [
    "# STEP 014 — Opportunity Scoring\n",
    "scoring_weights = {\n",
    "    \"Business Need\": 25,\n",
    "    \"Decision-Maker Access\": 20,\n",
    "    \"Budget Readiness\": 20,\n",
    "    \"Timeline Urgency\": 15,\n",
    "    \"Engagement Level\": 10,\n",
    "    \"Service Fit\": 10\n",
    "}\n",
    "\n",
    "def score_opportunity(\n",
    "    opportunity_id,\n",
    "    business_need,\n",
    "    decision_maker_access,\n",
    "    budget_readiness,\n",
    "    timeline_urgency,\n",
    "    engagement_level,\n",
    "    service_fit\n",
    "):\n",
    "    \"\"\"\n",
    "    Score a sales opportunity using six weighted criteria.\n",
    "\n",
    "    Each input must be between 0 and 5.\n",
    "    Final score ranges from 0 to 100.\n",
    "    \"\"\"\n",
    "\n",
    "    ratings = {\n",
    "        \"Business Need\": business_need,\n",
    "        \"Decision-Maker Access\": decision_maker_access,\n",
    "        \"Budget Readiness\": budget_readiness,\n",
    "        \"Timeline Urgency\": timeline_urgency,\n",
    "        \"Engagement Level\": engagement_level,\n",
    "        \"Service Fit\": service_fit\n",
    "    }\n",
    "\n",
    "    # Validate ratings\n",
    "    for criterion, rating in ratings.items():\n",
    "        if not isinstance(rating, (int, float)):\n",
    "            raise ValueError(f\"{criterion} must be numeric.\")\n",
    "\n",
    "        if rating < 0 or rating > 5:\n",
    "            raise ValueError(\n",
    "                f\"{criterion} must be between 0 and 5.\"\n",
    "            )\n",
    "\n",
    "    # Calculate weighted score\n",
    "    total_score = sum(\n",
    "        (ratings[criterion] / 5) * scoring_weights[criterion]\n",
    "        for criterion in ratings\n",
    "    )\n",
    "\n",
    "    total_score = round(total_score, 2)\n",
    "\n",
    "    # Assign priority classification\n",
    "    if total_score >= 80:\n",
    "        classification = \"High Priority\"\n",
    "    elif total_score >= 60:\n",
    "        classification = \"Qualified Prospect\"\n",
    "    elif total_score >= 40:\n",
    "        classification = \"Developing Opportunity\"\n",
    "    else:\n",
    "        classification = \"Low Priority / Nurture\"\n",
    "\n",
    "    # Find opportunity and update score\n",
    "    records = opportunities_sheet.get_all_records()\n",
    "\n",
    "    for row_number, record in enumerate(records, start=2):\n",
    "\n",
    "        if str(record[\"Opportunity ID\"]) == str(opportunity_id):\n",
    "\n",
    "            opportunities_sheet.update(\n",
    "                range_name=f\"K{row_number}\",\n",
    "                values=[[total_score]]\n",
    "            )\n",
    "\n",
    "            print(\"✓ Opportunity scored successfully!\")\n",
    "            print(\"Opportunity:\", record[\"Opportunity Name\"])\n",
    "            print(\"Score:\", total_score, \"/ 100\")\n",
    "            print(\"Classification:\", classification)\n",
    "\n",
    "            return {\n",
    "                \"opportunity_id\": opportunity_id,\n",
    "                \"score\": total_score,\n",
    "                \"classification\": classification,\n",
    "                \"ratings\": ratings\n",
    "            }\n",
    "\n",
    "    raise ValueError(\"Opportunity ID not found.\")\n",
    "\n",
    "\n",
    "def show_priority_opportunities():\n",
    "    \"\"\"\n",
    "    Display open opportunities ranked by score.\n",
    "    \"\"\"\n",
    "\n",
    "    records = opportunities_sheet.get_all_records()\n",
    "\n",
    "    active = [\n",
    "        record for record in records\n",
    "        if record[\"Outcome\"] == \"Open\"\n",
    "    ]\n",
    "\n",
    "    if not active:\n",
    "        print(\"No open opportunities found.\")\n",
    "        return\n",
    "\n",
    "    df = pd.DataFrame(active)\n",
    "\n",
    "    df[\"Opportunity Score\"] = pd.to_numeric(\n",
    "        df[\"Opportunity Score\"],\n",
    "        errors=\"coerce\"\n",
    "    )\n",
    "\n",
    "    df = df.sort_values(\n",
    "        \"Opportunity Score\",\n",
    "        ascending=False,\n",
    "        na_position=\"last\"\n",
    "    )\n",
    "\n",
    "    display(df[[\n",
    "        \"Opportunity ID\",\n",
    "        \"Company ID\",\n",
    "        \"Opportunity Name\",\n",
    "        \"Pipeline Stage\",\n",
    "        \"Estimated Value\",\n",
    "        \"Opportunity Score\"\n",
    "    ]])\n",
    "\n",
    "\n",
    "print(\"✓ Opportunity scoring engine installed!\")\n",
    "print(\"✓ Weighted scoring enabled!\")\n",
    "print(\"✓ Priority classifications enabled!\")\n",
    "print(\"✓ Ranked opportunity reporting enabled!\")\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
