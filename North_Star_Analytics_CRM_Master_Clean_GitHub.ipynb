    "# STEP 036 — Communication Logging\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "def record_client_communication(\n",
    "    message,\n",
    "    activity_type=\"Email\",\n",
    "    outcome=\"Sent\",\n",
    "    notes=\"\",\n",
    "    followup_days=None,\n",
    "    followup_priority=\"Medium\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Record a communication that actually occurred.\n",
    "\n",
    "    Optionally schedule a follow-up task.\n",
    "\n",
    "    The message must be a dictionary returned by\n",
    "    generate_client_message().\n",
    "\n",
    "    No email or message is sent by this function.\n",
    "    \"\"\"\n",
    "\n",
    "    if not isinstance(message, dict):\n",
    "        raise ValueError(\n",
    "            \"message must be generated by \"\n",
    "            \"generate_client_message().\"\n",
    "        )\n",
    "\n",
    "    required_keys = [\n",
    "        \"Template ID\",\n",
    "        \"Company ID\",\n",
    "        \"Contact ID\",\n",
    "        \"Subject\",\n",
    "        \"Message\"\n",
    "    ]\n",
    "\n",
    "    missing = [\n",
    "        key for key in required_keys\n",
    "        if key not in message\n",
    "    ]\n",
    "\n",
    "    if missing:\n",
    "        raise ValueError(\n",
    "            \"Missing message fields: \" + \", \".join(missing)\n",
    "        )\n",
    "\n",
    "    # Verify company/contact relationship\n",
    "    company_id = str(message[\"Company ID\"])\n",
    "    contact_id = str(message[\"Contact ID\"])\n",
    "\n",
    "    valid_contact = any(\n",
    "        str(c[\"Contact ID\"]) == contact_id\n",
    "        and str(c[\"Company ID\"]) == company_id\n",
    "        for c in contacts_sheet.get_all_records()\n",
    "    )\n",
    "\n",
    "    if not valid_contact:\n",
    "        raise ValueError(\n",
    "            \"Contact is not associated with this company.\"\n",
    "        )\n",
    "\n",
    "    if followup_days is not None:\n",
    "        if type(followup_days) is not int or followup_days < 0:\n",
    "            raise ValueError(\n",
    "                \"followup_days must be a nonnegative integer.\"\n",
    "            )\n",
    "\n",
    "    today = crm_today()\n",
    "\n",
    "    # Create an activity record\n",
    "    activity_id = \"NSA-A-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    activity_notes = (\n",
    "        f\"Template: {message['Template ID']}\\n\"\n",
    "        f\"Subject: {message['Subject']}\\n\"\n",
    "        f\"Outcome: {outcome}\\n\"\n",
    "        f\"Notes: {notes}\"\n",
    "    )\n",
    "\n",
    "    activity_row = [\n",
    "        activity_id,\n",
    "        company_id,\n",
    "        contact_id,\n",
    "        today.isoformat(),\n",
    "        activity_type,\n",
    "        \"Outbound\",\n",
    "        outcome,\n",
    "        activity_notes,\n",
    "        \"\",\n",
    "        \"\"\n",
    "    ]\n",
    "\n",
    "    # Prepare optional follow-up\n",
    "    task_id = None\n",
    "    task_row = None\n",
    "\n",
    "    if followup_days is not None:\n",
    "\n",
    "        due_date = today + timedelta(days=followup_days)\n",
    "        task_id = \"NSA-T-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "        task_row = [\n",
    "            task_id,\n",
    "            company_id,\n",
    "            contact_id,\n",
    "            \"\",\n",
    "            f\"Follow up: {message['Subject']}\",\n",
    "            \"Communication Follow-Up\",\n",
    "            followup_priority,\n",
    "            due_date.isoformat(),\n",
    "            \"Open\",\n",
    "            \"\",\n",
    "            f\"RelatedActivity:{activity_id}\"\n",
    "        ]\n",
    "\n",
    "        # Store follow-up details on the activity\n",
    "        activity_row[8] = task_row[4]\n",
    "        activity_row[9] = due_date.isoformat()\n",
    "\n",
    "    # Save activity first\n",
    "    activities_sheet.append_row(\n",
    "        activity_row,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    # Save optional follow-up task\n",
    "    if task_row is not None:\n",
    "        followups_sheet.append_row(\n",
    "            task_row,\n",
    "            value_input_option=\"RAW\"\n",
    "        )\n",
    "\n",
    "    print(\"\\n✓ Client communication recorded!\")\n",
    "    print(\"Activity ID:\", activity_id)\n",
    "    print(\"Company ID:\", company_id)\n",
    "    print(\"Contact ID:\", contact_id)\n",
    "    print(\"Activity Type:\", activity_type)\n",
    "    print(\"Outcome:\", outcome)\n",
    "\n",
    "    if task_id:\n",
    "        print(\"\\n✓ Follow-up task created!\")\n",
    "        print(\"Task ID:\", task_id)\n",
    "        print(\"Due Date:\", due_date.isoformat())\n",
    "\n",
    "    print(\"\\nNo message was sent automatically.\")\n",
    "\n",
    "    return {\n",
    "        \"Activity ID\": activity_id,\n",
    "        \"Follow-Up Task ID\": task_id\n",
    "    }\n",
    "\n",
    "\n",
    "def show_contact_communication_history(contact_id):\n",
    "    \"\"\"\n",
    "    Display recorded communication activities\n",
    "    for a specific contact.\n",
    "    \"\"\"\n",
    "\n",
    "    activities = activities_sheet.get_all_records()\n",
    "\n",
    "    matches = [\n",
    "        a for a in activities\n",
    "        if str(a[\"Contact ID\"]) == str(contact_id)\n",
    "    ]\n",
    "\n",
    "    if not matches:\n",
    "        print(\"No recorded communication history.\")\n",
    "        return []\n",
