    "# STEP 029 — Proposal Scope Approval\n",
    "def approve_proposal_scope(\n",
    "    scope_id,\n",
    "    base_price,\n",
    "    addon_price=0,\n",
    "    opportunity_id=\"\",\n",
    "    approval_notes=\"\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Approve an internal scope draft and create a proposal record.\n",
    "\n",
    "    Pricing is entered manually.\n",
    "    Duplicate proposal creation is prevented.\n",
    "    \"\"\"\n",
    "\n",
    "    drafts = scope_sheet.get_all_records()\n",
    "    proposals = proposals_sheet.get_all_records()\n",
    "\n",
    "    draft = next(\n",
    "        (\n",
    "            d for d in drafts\n",
    "            if str(d[\"Scope Draft ID\"]) == str(scope_id)\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if draft is None:\n",
    "        raise ValueError(\"Scope draft not found.\")\n",
    "\n",
    "    if draft[\"Draft Status\"] == \"Approved\":\n",
    "        raise ValueError(\"This scope draft is already approved.\")\n",
    "\n",
    "    # Prevent duplicate proposal creation\n",
    "    reference = f\"ScopeDraftRef:{scope_id}\"\n",
    "\n",
    "    if any(\n",
    "        reference in str(p[\"Notes\"])\n",
    "        for p in proposals\n",
    "    ):\n",
    "        raise ValueError(\n",
    "            \"A proposal already exists for this scope draft.\"\n",
    "        )\n",
    "\n",
    "    # Validate prices\n",
    "    try:\n",
    "        base = Decimal(str(base_price))\n",
    "        addons = Decimal(str(addon_price))\n",
    "    except InvalidOperation:\n",
    "        raise ValueError(\"Prices must be valid numbers.\")\n",
    "\n",
    "    if not base.is_finite() or not addons.is_finite():\n",
    "        raise ValueError(\"Prices must be finite numbers.\")\n",
    "\n",
    "    if base < 0 or addons < 0:\n",
    "        raise ValueError(\"Prices cannot be negative.\")\n",
    "\n",
    "    total = base + addons\n",
    "\n",
    "    # Confirm opportunity belongs to the same company\n",
    "    if opportunity_id:\n",
    "        opportunities = opportunities_sheet.get_all_records()\n",
    "\n",
    "        valid_opportunity = any(\n",
    "            str(o[\"Opportunity ID\"]) == str(opportunity_id)\n",
    "            and str(o[\"Company ID\"]) == str(draft[\"Company ID\"])\n",
    "            for o in opportunities\n",
    "        )\n",
    "\n",
    "        if not valid_opportunity:\n",
    "            raise ValueError(\n",
    "                \"Opportunity does not belong to this company.\"\n",
    "            )\n",
    "\n",
    "    # Retrieve the draft's row number\n",
    "    draft_cells = scope_sheet.col_values(1)\n",
    "\n",
    "    draft_row = next(\n",
    "        (\n",
    "            index for index, value\n",
    "            in enumerate(draft_cells, start=1)\n",
    "            if value == scope_id\n",
    "        ),\n",
    "        None\n",
    "    )\n",
    "\n",
    "    if draft_row is None:\n",
    "        raise ValueError(\"Unable to locate scope draft row.\")\n",
    "\n",
    "    # Create formal proposal\n",
    "    proposal_id = \"NSA-P-\" + uuid4().hex[:12].upper()\n",
    "\n",
    "    notes = (\n",
    "        f\"{reference}\\n\"\n",
    "        f\"Approved Scope Draft: {scope_id}\\n\"\n",
    "        f\"Approval Notes: {approval_notes}\"\n",
    "    )\n",
    "\n",
    "    proposal_row = [\n",
    "        proposal_id,\n",
    "        opportunity_id,\n",
    "        draft[\"Company ID\"],\n",
    "        crm_today().isoformat(),\n",
    "        draft[\"Recommended Services\"],\n",
    "        float(base),\n",
    "        float(addons),\n",
    "        float(total),\n",
    "        draft[\"Proposed Deliverables\"],\n",
    "        draft[\"Scope Exclusions\"],\n",
    "        \"Draft\",\n",
    "        \"\",\n",
    "        \"\",\n",
    "        notes\n",
    "    ]\n",
    "\n",
    "    proposals_sheet.append_row(\n",
    "        proposal_row,\n",
    "        value_input_option=\"RAW\"\n",
    "    )\n",
    "\n",
    "    # Mark source scope draft as approved\n",
    "    scope_sheet.update(\n",
    "        range_name=f\"D{draft_row}\",\n",
    "        values=[[\"Approved\"]]\n",
    "    )\n",
    "\n",
    "    print(\"\\n✓ Proposal scope approved!\")\n",
    "    print(\"✓ Proposal record created!\")\n",
    "    print(\"Proposal ID:\", proposal_id)\n",
    "    print(\"Company ID:\", draft[\"Company ID\"])\n",
    "    print(\"Base Price: $\", f\"{base:,.2f}\", sep=\"\")\n",
    "    print(\"Add-On Price: $\", f\"{addons:,.2f}\", sep=\"\")\n",
    "    print(\"Total Price: $\", f\"{total:,.2f}\", sep=\"\")\n",
    "    print(\"Proposal Status: Draft\")\n",
    "    print(\"\\nThe proposal has NOT been sent to the client.\")\n",
    "\n",
    "    return proposal_id\n",
    "\n",
    "\n",
    "def show_pending_scope_approvals():\n",
    "    \"\"\"\n",
    "    Show scope drafts awaiting approval.\n",
    "    \"\"\"\n",
    "\n",
    "    drafts = scope_sheet.get_all_records()\n",
    "\n",
    "    pending = [\n",
    "        d for d in drafts\n",
    "        if d[\"Draft Status\"] == \"Internal Draft\"\n",
    "    ]\n",
    "\n",
    "    if not pending:\n",
    "        print(\"No scope drafts awaiting approval.\")\n",
    "        return []\n",
    "\n",
    "    df = pd.DataFrame(pending)\n",
    "\n",
    "    display(df[[\n",
    "        \"Scope Draft ID\",\n",
    "        \"Company ID\",\n",
    "        \"Created Date\",\n",
    "        \"Draft Status\",\n",
    "        \"Recommended Services\"\n",
    "    ]])\n",
    "\n",
    "    return pending\n",
    "\n",
    "\n",
    "print(\"✓ Proposal approval system installed!\")\n",
    "print(\"✓ Manual pricing controls enabled!\")\n",
    "print(\"✓ Duplicate proposal protection enabled!\")\n",
    "print(\"✓ Opportunity ownership validation enabled!\")\n",
    "print(\"✓ Pending approval report enabled!\")\n",
    "\n"
   ],
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
