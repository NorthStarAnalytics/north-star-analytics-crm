    "# STEP 034 — Client Communication Templates\n",
    "# North Star Analytics CRM\n",
    "\n",
    "\n",
    "template_sheet_name = \"Communication Templates\"\n",
    "\n",
    "template_headers = [\n",
    "    \"Template ID\",\n",
    "    \"Template Name\",\n",
    "    \"Pipeline Stage\",\n",
    "    \"Communication Type\",\n",
    "    \"Subject\",\n",
    "    \"Message\",\n",
    "    \"Recommended Timing\",\n",
    "    \"Active\"\n",
    "]\n",
    "\n",
    "try:\n",
    "    template_sheet = spreadsheet.worksheet(template_sheet_name)\n",
    "\n",
    "except gspread.exceptions.WorksheetNotFound:\n",
    "    template_sheet = spreadsheet.add_worksheet(\n",
    "        title=template_sheet_name,\n",
    "        rows=300,\n",
    "        cols=len(template_headers)\n",
    "    )\n",
    "\n",
